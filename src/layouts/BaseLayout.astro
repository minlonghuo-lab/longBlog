---
import '@fontsource-variable/noto-sans-sc/wght.css';
import '@fontsource-variable/noto-serif-sc/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter, fade } from 'astro:transitions';
import { SITE_TITLE, SITE_DESCRIPTION, MEMOS_URL, UMAMI_SCRIPT_URL, UMAMI_WEBSITE_ID } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
} = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} - ${SITE_TITLE}`;
---

<!DOCTYPE html>
<html lang="zh-CN" transition:name="root" transition:animate={fade({ duration: '220ms' })}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#15171E" media="(prefers-color-scheme: dark)" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href={MEMOS_URL} crossorigin />

  <script is:inline>
    (() => {
      const storageKey = 'LONG_BLOG_THEME';
      const root = document.documentElement;
      const media = window.matchMedia('(prefers-color-scheme: dark)');
      const saved = localStorage.getItem(storageKey);
      const theme = saved === 'light' || saved === 'dark'
        ? saved
        : (media.matches ? 'dark' : 'light');
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
    })();
  </script>

  <title>{pageTitle}</title>
  <ClientRouter />
</head>
<body>
  <script>
    import '../scripts/page-navigation';
  </script>
  <Header />
  <main class="page-main" id="page-main">
    <slot />
  </main>
  <Footer />

  <div id="route-progress" class="route-progress" aria-hidden="true"></div>
  <script define:vars={{ umamiScriptUrl: UMAMI_SCRIPT_URL, umamiWebsiteId: UMAMI_WEBSITE_ID }}>
    (() => {
      const storageKey = 'LONG_BLOG_THEME';
      const root = document.documentElement;
      const themeMedia = window.matchMedia('(prefers-color-scheme: dark)');

      const loadAnalytics = () => {
        if (!umamiScriptUrl || !umamiWebsiteId || document.querySelector('script[data-website-id]')) return;
        const script = document.createElement('script');
        script.src = umamiScriptUrl;
        script.defer = true;
        script.dataset.websiteId = umamiWebsiteId;
        document.head.appendChild(script);
      };

      const scheduleAnalytics = () => {
        if ('requestIdleCallback' in window) window.requestIdleCallback(loadAnalytics, { timeout: 3000 });
        else window.setTimeout(loadAnalytics, 1500);
      };
      if (document.readyState === 'complete') scheduleAnalytics();
      else window.addEventListener('load', scheduleAnalytics, { once: true });

      const getStoredTheme = () => {
        const value = localStorage.getItem(storageKey);
        return value === 'light' || value === 'dark' ? value : null;
      };

      const getPreferredTheme = () => getStoredTheme() || (themeMedia.matches ? 'dark' : 'light');

      const applyTheme = (theme) => {
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
      };

      applyTheme(getPreferredTheme());

      let themeTransitionActive = false;

      const animateThemeTransition = async (theme, sourceEl, pointerEvent) => {
        if (themeTransitionActive) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const startViewTransition = document.startViewTransition?.bind(document);
        if (!(sourceEl instanceof HTMLElement) || reduceMotion || !startViewTransition) {
          applyTheme(theme);
          updateThemeToggleState();
          return;
        }

        const rect = sourceEl.getBoundingClientRect();
        const hasPointerPosition = pointerEvent instanceof MouseEvent
          && pointerEvent.detail > 0
          && Number.isFinite(pointerEvent.clientX)
          && Number.isFinite(pointerEvent.clientY);
        const x = hasPointerPosition ? pointerEvent.clientX : rect.left + rect.width / 2;
        const y = hasPointerPosition ? pointerEvent.clientY : rect.top + rect.height / 2;
        const maxRadius = Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y),
        );

        themeTransitionActive = true;
        root.classList.add('theme-transitioning');
        sourceEl.disabled = true;

        try {
          const transition = startViewTransition(() => {
            applyTheme(theme);
            updateThemeToggleState();
          });
          await transition.ready;
          const animation = root.animate(
            {
              clipPath: [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${maxRadius}px at ${x}px ${y}px)`,
              ],
            },
            {
              duration: 400,
              easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)',
              fill: 'both',
              pseudoElement: '::view-transition-new(root)',
            },
          );
          await animation.finished;
          await transition.finished;
        } catch {
          applyTheme(theme);
          updateThemeToggleState();
        } finally {
          root.classList.remove('theme-transitioning');
          sourceEl.disabled = false;
          themeTransitionActive = false;
        }
      };

      const updateThemeToggleState = () => {
        const theme = root.dataset.theme || getPreferredTheme();
        document.querySelectorAll('#theme-toggle').forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const isDark = theme === 'dark';
          button.setAttribute('aria-pressed', String(isDark));
          button.setAttribute('aria-label', isDark ? '切换到浅色模式' : '切换到深色模式');
          button.title = isDark ? '切换到浅色模式' : '切换到深色模式';
        });
      };

      updateThemeToggleState();

      themeMedia.addEventListener('change', (event) => {
        if (getStoredTheme()) return;
        applyTheme(event.matches ? 'dark' : 'light');
        updateThemeToggleState();
      });

      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const themeButton = target.closest('#theme-toggle');
        if (themeButton instanceof HTMLButtonElement) {
          event.preventDefault();
          const current = root.dataset.theme || getPreferredTheme();
          const next = current === 'dark' ? 'light' : 'dark';
          localStorage.setItem(storageKey, next);
          animateThemeTransition(next, themeButton, event);
          return;
        }
      });

      let progressTimer;
      const clearRouteProgress = () => {
        window.clearTimeout(progressTimer);
        document.getElementById('route-progress')?.classList.remove('active');
      };

      const restorePageState = () => {
        document.body.classList.remove('page-leave', 'page-navigating');
        document.body.classList.add('page-ready');
        clearRouteProgress();
      };

      document.addEventListener('astro:before-preparation', () => {
        document.body.classList.add('page-navigating');
        clearRouteProgress();
        progressTimer = window.setTimeout(() => {
          document.getElementById('route-progress')?.classList.add('active');
        }, 300);
      });

      document.addEventListener('astro:after-swap', clearRouteProgress);

      document.addEventListener('astro:page-load', () => {
        restorePageState();
        updateHeaderState();
        updateThemeToggleState();
      });

      const updateHeaderState = () => {
        if (window.scrollY > 20) {
          document.body.classList.add('scrolled');
        } else {
          document.body.classList.remove('scrolled');
        }
      };

      requestAnimationFrame(() => {
        restorePageState();
        updateHeaderState();
        updateThemeToggleState();
      });

      window.addEventListener('pageshow', () => {
        restorePageState();
        updateHeaderState();
        updateThemeToggleState();
      });

      window.addEventListener('popstate', () => {
        requestAnimationFrame(() => {
          restorePageState();
          updateHeaderState();
          updateThemeToggleState();
        });
      });

      document.addEventListener('scroll', updateHeaderState, { passive: true });
      window.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          restorePageState();
          updateHeaderState();
          updateThemeToggleState();
        }
      });
    })();
  </script>
</body>
</html>

