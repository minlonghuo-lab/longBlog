---
interface Props {
  content: string;
  createdAt: Date;
  images?: string[];
}

const { content, createdAt, images } = Astro.props;

// 格式化日期时间
function formatDateTime(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }) + ' ' + date.toLocaleTimeString('en-US', {
    hour: '2-digit',
    minute: '2-digit',
  });
}

const formattedTime = formatDateTime(createdAt);
---

<article class="shuoshuo-item">
  <p class="shuoshuo-content">{content}</p>
  
  {images && images.length > 0 && (
    <div class="shuoshuo-images">
      {images.map(img => (
        <img src={img} alt="说说图片" class="shuoshuo-image" loading="lazy" />
      ))}
    </div>
  )}
  
  <time class="shuoshuo-time">{formattedTime}</time>
</article>

<style>
  .shuoshuo-item {
    padding: 1.5rem;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
  }

  .shuoshuo-item:hover {
    background-color: var(--muted);
    opacity: 0.4;
  }

  .shuoshuo-content {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.7;
    color: var(--foreground);
    margin: 0;
  }

  .shuoshuo-images {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .shuoshuo-image {
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .shuoshuo-image:hover {
    opacity: 1;
    transform: scale(1.02);
  }

  .shuoshuo-time {
    display: block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
    opacity: 0.5;
    letter-spacing: 0.05em;
  }
</style>
