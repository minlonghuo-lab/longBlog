---
import { aboutProfile as profile, knowledgeTopics, aboutProjects, aboutHistory } from '../../data/about';
import '../../styles/about-console.css';
const commands = ['profile', 'knowledge', 'projects', 'history', 'clear'];
---

<div class="about-console-wrap">
  <section class="about-console" data-about-console aria-label="longBlog Terminal">
    <header class="terminal-titlebar">
      <div class="terminal-lights" aria-hidden="true"><span></span><span></span><span></span></div>
      <h2>longBlog Terminal</h2>
      <!-- Reuse the global theme handler and LONG_BLOG_THEME preference. -->
      <button id="theme-toggle" class="terminal-theme" type="button" aria-label="切换到深色模式" aria-pressed="false" title="切换到深色模式">
        <svg class="terminal-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.2 14.35A7.95 7.95 0 0 1 9.65 3.8a8.6 8.6 0 1 0 10.55 10.55Z" stroke-linejoin="round" /></svg>
        <svg class="terminal-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" stroke-linecap="round"/></svg>
      </button>
    </header>
    <div class="terminal-screen" data-terminal-screen>
      <div data-terminal-transcript>
        <section class="terminal-block" data-terminal-block>
          <div class="terminal-prompt" data-command-line aria-label="已执行 fastfetch">
            <span class="terminal-identity"><span class="terminal-user">{profile.user}</span>@<span class="terminal-host">{profile.host}</span></span><span class="terminal-path">~ &gt;</span><span class="terminal-command">fastfetch</span>
          </div>
          <div class="terminal-profile" data-profile-output>
            <!-- Thin-line variation of the existing Knowledge Spine brand mark. -->
            <svg class="terminal-mark" width="256" height="256" viewBox="0 0 512 512" role="img" aria-label="longBlog 知识脊柱线条图标">
              <g fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M256 80V215M256 297V432M256 168L183 132M256 168L329 132M145 256H212M300 256H367M256 344L183 380M256 344L329 380"/>
                <circle cx="168" cy="124" r="20"/><circle cx="344" cy="124" r="20"/>
                <circle cx="124" cy="256" r="20"/><circle cx="388" cy="256" r="20"/>
                <circle cx="168" cy="388" r="20"/><circle cx="344" cy="388" r="20"/>
                <path d="M240 227a33 33 0 0 0 0 58M272 227a33 33 0 0 1 0 58"/>
              </g>
            </svg>
            <div class="terminal-profile-info">
              <div class="terminal-profile-name"><span>{profile.user}</span>@<span>{profile.host}</span></div>
              <div class="terminal-divider" aria-hidden="true">──────────────────</div>
              <dl class="terminal-fields">
                <div><dt>Site</dt><dd>{profile.site}</dd></div>
                <div><dt>Stack</dt><dd>{profile.stack}</dd></div>
                <div><dt>Theme</dt><dd>longBlog <span data-terminal-theme>Light</span></dd></div>
                <div><dt>Focus</dt><dd>{profile.focus}</dd></div>
                <div><dt>About</dt><dd>{profile.about}</dd></div>
                <div><dt>Status</dt><dd>{profile.status}</dd></div>
              </dl>
            </div>
          </div>
        </section>
      </div>
      <form class="terminal-input-line" data-terminal-form hidden>
        <label for="about-command" class="terminal-prompt"><span class="terminal-identity"><span class="terminal-user">{profile.user}</span>@<span class="terminal-host">{profile.host}</span></span><span class="terminal-path">~ &gt;</span><span class="terminal-sr-only">输入命令</span></label>
        <span class="terminal-input-shell"><input id="about-command" name="command" type="text" value="knowledge" maxlength="160" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go" aria-describedby="about-command-help"/><span class="terminal-block-cursor" aria-hidden="true"></span></span>
        <button type="submit" class="terminal-run" aria-label="执行命令" title="执行命令">↵</button>
      </form>
      <div class="terminal-suggestions" data-command-suggestions aria-label="命令补全建议" hidden></div>
      <nav class="terminal-shortcuts" data-terminal-shortcuts aria-label="可执行命令" hidden>
        {commands.map(command => <button type="button" data-command={command}>{command}</button>)}
      </nav>
      <p id="about-command-help" class="terminal-help" data-terminal-help hidden>点击命令或回车执行<span> · ↑↓ 历史 · Tab 补全</span></p>
      <p class="terminal-sr-only" data-terminal-announcement role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
    <noscript><p class="terminal-fallback">开启 JavaScript 后可使用交互命令。<a href="/blog">阅读文章 →</a> · <a href="https://github.com/minlonghuo-lab" target="_blank" rel="noopener noreferrer">GitHub ↗</a></p></noscript>
    <template data-output="knowledge">
      <div class="terminal-text-output">
        <h3>knowledge /</h3>
        <dl class="terminal-topic-list">{knowledgeTopics.map(topic => <div><dt>{topic.name}/</dt><dd>{topic.description}</dd></div>)}</dl>
        <p class="terminal-copy">一些持续整理中的主题。</p><a href="/blog" class="terminal-link">阅读全部文章 →</a>
      </div>
    </template>
    <template data-output="projects">
      <div class="terminal-text-output">
        <h3>projects /</h3>
        {aboutProjects.map(project => <article class="terminal-project"><h4>{project.name}</h4><p class="terminal-copy">{project.description}</p><p class="terminal-meta">{project.stack}</p><div class="terminal-links"><a href={project.href}>打开项目 →</a><a href={project.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></article>)}
      </div>
    </template>
    <template data-output="history">
      <div class="terminal-text-output">
        <h3>history /</h3>
        {aboutHistory.length ? <ol class="terminal-history-list">{aboutHistory.map(item => <li><time datetime={item.date}>{item.date}</time><div>{item.title}{item.description && <p class="terminal-copy">{item.description}</p>}</div></li>)}</ol> : <p class="terminal-copy">一些值得记下的节点，稍后补上。</p>}
      </div>
    </template>
  </section>
</div>

<script>
  import { installAboutConsole } from '../../scripts/about-console.js';
  installAboutConsole();
</script>
