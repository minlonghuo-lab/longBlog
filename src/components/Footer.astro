---
import { AUTHOR, ICP_URL, ICP_TEXT, FOOTER_TRILIUM_URL, FOOTER_ASTRO_URL } from '../consts';

const year = new Date().getFullYear();
const launchDateIso = '2026-03-27T00:00:00+08:00';
const launchDate = new Date(launchDateIso);
const initialDiffMs = Math.max(0, Date.now() - launchDate.getTime());

function formatRuntime(diffMs: number) {
  const totalSeconds = Math.max(0, Math.floor(diffMs / 1000));
  const days = Math.floor(totalSeconds / 86400);
  const hours = Math.floor((totalSeconds % 86400) / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = totalSeconds % 60;

  return `${days} 天 ${String(hours).padStart(2, '0')} 时 ${String(minutes).padStart(2, '0')} 分 ${String(seconds).padStart(2, '0')} 秒`;
}

const initialRuntimeText = formatRuntime(initialDiffMs);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-line footer-main">
      <span>© {year} {AUTHOR}</span>
      <a
        href={ICP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="icp-link"
      >
        {ICP_TEXT}
      </a>
    </p>

    <p class="footer-line footer-powered">
      <span class="footer-badge">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="footer-icon">
          <path d="M12 3l7 4v10l-7 4-7-4V7l7-4z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          <path d="M9 10.5l3-1.8 3 1.8v3L12 15.3 9 13.5v-3z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
        Powered by
      </span>
      <a href={FOOTER_TRILIUM_URL} target="_blank" rel="noopener noreferrer">Trilium</a>
      <span>&amp;</span>
      <a href={FOOTER_ASTRO_URL} target="_blank" rel="noopener noreferrer">Astro</a>
    </p>

    <p class="footer-line footer-runtime">
      <span class="footer-badge">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="footer-icon">
          <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.7"/>
          <path d="M12 7.5v4.8l3.2 1.9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span id="runtime-counter" data-launch-date={launchDateIso} data-initial-runtime-ms={String(initialDiffMs)}>
          该站已稳定运行 {initialRuntimeText}
        </span>
      </span>
    </p>
  </div>
</footer>

<script is:inline>
  (() => {
    const runtimeEl = document.getElementById('runtime-counter');
    if (!runtimeEl) return;

    const launchDateStr = runtimeEl.getAttribute('data-launch-date');
    const initialRuntimeMs = Number(runtimeEl.getAttribute('data-initial-runtime-ms') || '0');
    const launchTs = launchDateStr ? new Date(launchDateStr).getTime() : NaN;
    const pageLoadedAt = Date.now();

    const formatRuntime = (diffMs) => {
      const totalSeconds = Math.max(0, Math.floor(diffMs / 1000));
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
      const pad = (value) => String(value).padStart(2, '0');

      return `${days} 天 ${pad(hours)} 时 ${pad(minutes)} 分 ${pad(seconds)} 秒`;
    };

    const updateRuntime = () => {
      const diffMs = Number.isFinite(launchTs)
        ? Math.max(0, Date.now() - launchTs)
        : Math.max(0, initialRuntimeMs + (Date.now() - pageLoadedAt));

      runtimeEl.textContent = `该站已稳定运行 ${formatRuntime(diffMs)}`;
    };

    updateRuntime();
    window.setInterval(updateRuntime, 1000);
  })();
</script>

<style>
  .site-footer {
    padding: 3rem 0;
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.6rem;
    text-align: center;
  }

  .footer-line {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
    opacity: 0.72;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    width: 100%;
  }

  .footer-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.38rem;
  }

  .footer-icon {
    width: 0.92rem;
    height: 0.92rem;
    flex: 0 0 auto;
  }

  .icp-link,
  .footer-line a {
    transition: color var(--transition-base);
  }

  .icp-link:hover,
  .footer-line a:hover {
    color: var(--foreground);
  }
</style>
