---
import BrandLogo from './BrandLogo.astro';
import { SITE_TITLE, NAV_ITEMS } from '../consts';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <nav class="site-nav container">
    <a href="/" class="site-logo" aria-label={SITE_TITLE}>
      <BrandLogo class="site-logo-img" />
    </a>
    <div class="nav-links">
      {NAV_ITEMS.map(item => (
        <a 
          href={item.href} 
          class:list={['nav-link', { active: isActive(item.href) }]}
        >
          {item.name}
        </a>
      ))}
    </div>
  </nav>
</header>
<div class="site-header-spacer" aria-hidden="true"></div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    background: transparent;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    box-shadow: none;
    transform: translateY(0);
    transition:
      background-color 0.24s ease,
      border-color 0.24s ease,
      box-shadow 0.24s ease,
      backdrop-filter 0.24s ease,
      -webkit-backdrop-filter 0.24s ease,
      transform 0.24s ease,
      padding 0.24s ease;
    padding: 0.9rem 0;
  }

  body.scrolled .site-header {
    padding: 0.45rem 0;
    transform: translateY(-1px);
    border-bottom-color: rgba(120, 126, 145, 0.2);
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.68) 0%,
      rgba(255, 255, 255, 0.56) 52%,
      rgba(255, 255, 255, 0.5) 100%
    );
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    box-shadow: 0 6px 18px rgba(15, 15, 20, 0.04);
  }

  :global(html[data-theme='dark']) body.scrolled .site-header {
    border-bottom-color: rgba(255, 255, 255, 0.08);
    background: linear-gradient(
      to bottom,
      rgba(17, 20, 30, 0.8) 0%,
      rgba(17, 20, 30, 0.72) 52%,
      rgba(17, 20, 30, 0.64) 100%
    );
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
  }

  .site-header::before {
    content: '';
    position: absolute;
    left: 12%;
    right: 12%;
    top: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.72) 22%,
      rgba(255, 255, 255, 0.24) 50%,
      transparent 100%
    );
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.24s ease, left 0.24s ease, right 0.24s ease;
  }

  .site-header::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.22) 0%,
      rgba(255, 255, 255, 0.06) 42%,
      rgba(255, 255, 255, 0) 100%
    );
    opacity: 0;
    transition: opacity 0.24s ease;
  }

  body.scrolled .site-header::before {
    opacity: 0.76;
    left: 16%;
    right: 16%;
  }

  :global(html[data-theme='dark']) body.scrolled .site-header::before {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.16) 22%,
      rgba(255, 255, 255, 0.06) 50%,
      transparent 100%
    );
  }

  body.scrolled .site-header::after {
    opacity: 1;
  }

  :global(html[data-theme='dark']) body.scrolled .site-header::after {
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.06) 0%,
      rgba(255, 255, 255, 0.02) 42%,
      rgba(255, 255, 255, 0) 100%
    );
  }

  .site-header-spacer {
    height: 5.6rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3rem;
    position: relative;
    z-index: 2;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    color: var(--foreground);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .site-logo:hover {
    opacity: 0.78;
    transform: translateY(-1px);
  }

  .site-logo-img {
    display: block;
    width: 8.9rem;
    height: auto;
    color: currentColor;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.35rem;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.69rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: color-mix(in oklab, var(--muted-foreground) 75%, transparent);
    transition: color var(--transition-base);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--foreground);
  }

  @media (max-width: 640px) {
    body.scrolled .site-header {
      backdrop-filter: saturate(145%) blur(8px);
      -webkit-backdrop-filter: saturate(145%) blur(8px);
      box-shadow: 0 4px 12px rgba(15, 15, 20, 0.03);
    }

    .site-header-spacer {
      height: 5rem;
    }

    .site-logo-img {
      width: 7.6rem;
    }

    .nav-links {
      gap: 0.9rem;
    }

    .nav-link {
      font-size: 0.64rem;
      letter-spacing: 0.12em;
    }
  }
</style>
