---
interface Props {
  title: string;
  date?: Date;
  publishedAt?: string | Date;
  tags: string[];
  slug: string;
  pinned?: boolean;
}

const { title, date, publishedAt, tags, slug, pinned } = Astro.props;

// 处理日期：优先使用 date，否则转换 publishedAt
let postDate: Date;
if (date) {
  postDate = date;
} else if (publishedAt) {
  postDate = typeof publishedAt === 'string' ? new Date(publishedAt) : publishedAt;
} else {
  postDate = new Date();
}

function formatDate(d: Date): string {
  return d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}
---

<a 
  href={`/blog/${slug}`}
  class="group block py-4 border-b border-border/50 hover:pl-4 transition-all duration-300"
>
  <div class="flex items-start justify-between gap-4">
    <h2 class="text-base font-medium group-hover:text-muted-foreground transition-colors">
      {title}
    </h2>
    <time class="text-xs font-mono text-muted-foreground/60 shrink-0 tracking-wider">
      {formatDate(postDate)}
    </time>
  </div>
  
  <div class="flex items-center gap-2 mt-1.5">
    {pinned && (
      <span class="text-[10px] font-mono text-muted-foreground/60">📌</span>
    )}
    {tags.map(tag => (
      <span class="text-[10px] font-mono text-muted-foreground/60">#{tag}</span>
    ))}
  </div>
</a>
