---
interface Props {
  slug: string;
  title: string;
  summary: string;
  publishedAt: Date;
  tags: string[];
  pinned?: boolean;
}

const { slug, title, summary, publishedAt, tags, pinned } = Astro.props;

// 格式化日期 - 完全匹配 flare-stack-blog
function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

const formattedDate = formatDate(publishedAt);
---

<article class="post-item">
  <a href={`/blog/${slug}`} class="post-link">
    <!-- 元数据行 -->
    <div class="post-meta">
      <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
      
      {tags.length > 0 && (
        <>
          <span class="meta-sep">/</span>
          <div class="post-tags">
            {tags.map(tag => (
              <span class="post-tag">#{tag}</span>
            ))}
          </div>
        </>
      )}
    </div>

    <!-- 标题 -->
    <h3 class="post-title">
      {pinned && <span class="pin-icon">📌</span>}
      <span class="title-text">{title}</span>
    </h3>

    <!-- 摘要 -->
    <p class="post-summary">{summary}</p>
  </a>
</article>

<style>
  .post-item {
    border-bottom: 1px solid var(--border);
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-link {
    display: block;
    padding: 2rem 0;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  @media (min-width: 768px) {
    .post-link {
      padding: 2.5rem 0;
    }
  }

  .post-link:hover {
    padding-left: 1rem;
  }

  /* 元数据行 - 完全匹配 */
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .meta-sep {
    opacity: 0.3;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-tag {
    opacity: 0.6;
  }

  /* 标题 - 完全匹配 */
  .post-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--foreground);
    margin: 0.75rem 0 0.5rem 0;
    line-height: 1.3;
    letter-spacing: -0.025em;
    transition: color 0.3s ease;
  }

  @media (min-width: 768px) {
    .post-title {
      font-size: 1.875rem;
    }
  }

  .post-link:hover .post-title {
    color: var(--muted-foreground);
  }

  .pin-icon {
    flex-shrink: 0;
    font-size: 1.25rem;
  }

  .title-text {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* 摘要 - 完全匹配 */
  .post-summary {
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.7;
    max-width: 42rem;
    margin: 0.25rem 0 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.3s ease;
  }

  @media (min-width: 768px) {
    .post-summary {
      font-size: 1rem;
    }
  }

  .post-link:hover .post-summary {
    color: var(--muted-foreground);
    opacity: 0.8;
  }
</style>
