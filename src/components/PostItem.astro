---
interface Props {
  title: string;
  date?: Date;
  publishedAt?: string | Date;
  tags: string[];
  slug: string;
  pinned?: boolean;
}

const { title, date, publishedAt, tags, slug, pinned } = Astro.props;

let postDate: Date;
if (date) {
  postDate = date;
} else if (publishedAt) {
  postDate = typeof publishedAt === 'string' ? new Date(publishedAt) : publishedAt;
} else {
  postDate = new Date();
}

function formatDate(d: Date): string {
  return d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}
---

<article class="post-item">
  <a href={`/blog/${slug}`} class="post-link">
    <div class="post-main">
      <div class="post-title-row">
        <h2 class="post-title">{title}</h2>
        <time class="post-date">{formatDate(postDate)}</time>
      </div>

      <div class="post-tags">
        {pinned && <span class="pin">📌</span>}
        {tags.map(tag => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    </div>
  </a>
</article>

<style>
  .post-item {
    border-bottom: 1px solid color-mix(in oklab, var(--border) 50%, transparent);
  }

  .post-link {
    display: block;
    padding: 1rem 0;
    transition: all var(--transition-base);
  }

  .post-link:hover {
    padding-left: 1rem;
  }

  .post-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .post-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color var(--transition-base);
  }

  .post-link:hover .post-title {
    color: var(--muted-foreground);
  }

  .post-date {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: color-mix(in oklab, var(--muted-foreground) 60%, transparent);
    letter-spacing: 0.08em;
  }

  .post-tags {
    margin-top: 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .pin,
  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
  }
</style>
