---
interface Props {
  slug: string;
  title: string;
  summary: string;
  publishedAt: Date;
  tags: string[];
  pinned?: boolean;
}

const { slug, title, summary, publishedAt, tags, pinned } = Astro.props;

// 格式化日期
function formatDate(date: Date): string {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

const formattedDate = formatDate(publishedAt);
---

<article class="post-item">
  <a href={`/blog/${slug}`} class="post-link">
    <!-- 元数据 -->
    <div class="post-meta">
      <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
      {tags.length > 0 && (
        <>
          <span class="meta-sep">/</span>
          <div class="post-tags">
            {tags.map(tag => (
              <span class="post-tag">#{tag}</span>
            ))}
          </div>
        </>
      )}
    </div>

    <!-- 标题 -->
    <h2 class="post-title">
      {pinned && <span class="pin-icon">📌</span>}
      {title}
    </h2>

    <!-- 摘要 -->
    <p class="post-summary">{summary}</p>
  </a>
</article>

<style>
  .post-item {
    border-bottom: 1px solid var(--border);
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-link {
    display: block;
    padding: 2rem 0;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .post-link:hover {
    padding-left: 0.5rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .meta-sep {
    opacity: 0.3;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-tag {
    opacity: 0.6;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--foreground);
    margin: 0.5rem 0;
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .post-link:hover .post-title {
    color: var(--muted-foreground);
  }

  .pin-icon {
    margin-right: 0.5rem;
    font-size: 1rem;
  }

  .post-summary {
    color: var(--muted-foreground);
    font-weight: 300;
    line-height: 1.7;
    max-width: 42rem;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.3s ease;
  }

  .post-link:hover .post-summary {
    color: var(--muted-foreground);
    opacity: 0.8;
  }

  @media (max-width: 640px) {
    .post-title {
      font-size: 1.5rem;
    }
  }
</style>
