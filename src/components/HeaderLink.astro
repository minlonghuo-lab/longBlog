---
type Props = {
	href: string;
};

const { href } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<a href={href} class:list={{ active: isActive }}>
	<slot />
</a>

<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: 600;
	}
</style>
