---
interface Props {
  name: string;
  url: string;
  description: string;
  avatar?: string;
}

const { name, url, description, avatar } = Astro.props;

// 提取域名
const displayUrl = url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<a href={url} target="_blank" rel="noopener noreferrer" class="friend-card">
  <!-- Logo -->
  <div class="friend-logo">
    {avatar ? (
      <img src={avatar} alt={name} class="logo-img" loading="lazy" />
    ) : (
      <span class="logo-placeholder">{name.charAt(0)}</span>
    )}
  </div>

  <!-- 信息 -->
  <div class="friend-info">
    <div class="friend-header">
      <h3 class="friend-name">{name}</h3>
      <span class="friend-url">{displayUrl}</span>
    </div>
    
    {description && (
      <p class="friend-desc">{description}</p>
    )}
  </div>
</a>

<style>
  .friend-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    transition: all 0.3s ease;
  }

  .friend-card:hover {
    background-color: var(--muted);
    opacity: 0.4;
    border-color: var(--border);
  }

  /* Logo - 完全匹配 w-10 h-10 rounded-md */
  .friend-logo {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.375rem;
    background-color: var(--muted);
    border: 1px solid var(--border);
    opacity: 0.4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .friend-card:hover .friend-logo {
    opacity: 1;
  }

  .logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo-placeholder {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
    opacity: 0.6;
  }

  /* 信息区 */
  .friend-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .friend-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .friend-name {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground);
    letter-spacing: -0.01em;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .friend-card:hover .friend-name {
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .friend-url {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--muted-foreground);
    opacity: 0.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 150px;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .friend-url {
      display: block;
    }
  }

  /* 描述 */
  .friend-desc {
    font-size: 0.875rem;
    color: var(--muted-foreground);
    opacity: 0.8;
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.5em;
  }
</style>
