---
interface Props {
  name: string;
  url: string;
  description: string;
  avatar?: string;
}

const { name, url, description, avatar } = Astro.props;
const displayUrl = url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const faviconUrl = avatar || '';
---

<a href={url} target="_blank" rel="noopener noreferrer" class="friend-card">
  <div class="friend-logo">
    {faviconUrl ? (
      <img src={faviconUrl} alt={name} class="logo-img" loading="lazy" />
    ) : (
      <span class="logo-placeholder">{name.charAt(0)}</span>
    )}
  </div>

  <div class="friend-info">
    <div class="friend-header">
      <h3 class="friend-name">{name}</h3>
      <span class="friend-url">{displayUrl}</span>
    </div>
    {description && <p class="friend-desc">{description}</p>}
  </div>
</a>

<style>
  .friend-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    transition: all var(--transition-base);
  }

  .friend-card:hover {
    background: var(--muted);
    border-color: var(--border);
  }

  .friend-logo {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.375rem;
    border: 1px solid var(--border);
    background: var(--muted);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo-placeholder {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .friend-info {
    min-width: 0;
    flex: 1;
  }

  .friend-header {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .friend-name {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .friend-url {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
  }

  @media (min-width: 640px) {
    .friend-url { display: block; }
  }

  .friend-desc {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--muted-foreground);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
