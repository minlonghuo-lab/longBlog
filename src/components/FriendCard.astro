---
interface Props {
  name: string;
  url: string;
  description: string;
  avatar?: string;
}

const { name, url, description, avatar } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="friend-card">
  <div class="friend-avatar">
    {avatar ? (
      <img src={avatar} alt={name} />
    ) : (
      <div class="avatar-placeholder">{name.charAt(0).toUpperCase()}</div>
    )}
  </div>
  <div class="friend-info">
    <h3 class="friend-name">{name}</h3>
    <p class="friend-desc">{description}</p>
  </div>
  <span class="friend-arrow">↗</span>
</a>

<style>
  .friend-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .friend-card:hover {
    border-color: var(--foreground);
    transform: translateY(-2px);
  }

  .friend-avatar {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--accent);
  }

  .friend-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    color: white;
  }

  .friend-info {
    flex: 1;
    min-width: 0;
  }

  .friend-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    color: var(--foreground);
    margin: 0 0 0.25rem 0;
  }

  .friend-desc {
    font-size: 0.875rem;
    color: var(--muted-foreground);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-arrow {
    flex-shrink: 0;
    font-size: 1.25rem;
    color: var(--muted-foreground);
    transition: all 0.3s ease;
  }

  .friend-card:hover .friend-arrow {
    transform: translate(2px, -2px);
    color: var(--foreground);
  }
</style>
