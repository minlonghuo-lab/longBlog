---
/**
 * 说说组件
 * 时间线样式 + 图片网格 + 图片预览
 */
import type { MemosPost } from '../memos/types';
import { memosConfig } from '../memos/config';

interface Props {
  memo: MemosPost;
}

const { memo } = Astro.props;

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('zh', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).format(date);
}

// 处理内容，去除标签前缀
function processContent(content: string): string {
  return content.split('\n').map(line => line.replace(/^#\S+(\s|$)/, '')).join('\n').trim();
}

// 获取处理后的内容
const processedContent = processContent(memo.content);
---

<article class="relative pl-8">
  <!-- 时间线竖线 -->
  <div class="absolute left-0 top-0 bottom-0 w-px bg-border"></div>
  
  <!-- 时间线圆点 -->
  <div class="absolute left-[-3px] top-2 w-2 h-2 rounded-full bg-foreground/30"></div>
  
  <div class="space-y-3">
    <!-- 时间 -->
    <div class="flex items-center gap-3 text-xs font-mono text-muted-foreground/60">
      <time datetime={memo.createdAt.toISOString()}>
        {formatDate(memo.createdAt)}
      </time>
      {memo.pinned && (
        <span class="text-primary font-medium">置顶</span>
      )}
    </div>
    
    <!-- 内容 -->
    <div class="whitespace-pre-wrap break-words text-sm leading-relaxed">
      {processedContent}
    </div>
    
    <!-- 图片网格 -->
    {memo.images && memo.images.length > 0 && (
      <div class="grid gap-2 mt-4" style={`grid-template-columns: repeat(${Math.min(memo.images.length, 3)}, 1fr)`}>
        {memo.images.slice(0, 9).map((img, idx) => (
          <div 
            class="aspect-square rounded-lg overflow-hidden bg-muted cursor-pointer hover:opacity-90 transition-opacity"
            data-src={img}
            onclick="openImagePreview(this.dataset.src)"
          >
            <img 
              src={img} 
              alt={`图片 ${idx + 1}`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    )}
    
    <!-- 标签 -->
    {memo.tags && memo.tags.filter(t => !t.startsWith('#')).length > 0 && (
      <div class="flex flex-wrap gap-2 pt-2">
        {memo.tags.filter(t => !t.startsWith('#')).map((tag) => (
          <span class="text-xs px-2 py-1 rounded-full bg-muted text-muted-foreground">#{tag}</span>
        ))}
      </div>
    )}
  </div>
</article>

<!-- 图片预览弹窗 -->
<div id="image-preview-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm" onclick="closeImagePreview()">
  <button class="absolute top-4 right-4 text-white/70 hover:text-white text-2xl w-10 h-10" onclick="closeImagePreview()">✕</button>
  <img id="preview-image" src="" alt="Preview" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg" onclick="event.stopPropagation()" />
</div>

<script is:inline>
  function openImagePreview(src) {
    const modal = document.getElementById('image-preview-modal');
    const img = document.getElementById('preview-image');
    if (modal && img) {
      img.src = src;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }
  
  function closeImagePreview() {
    const modal = document.getElementById('image-preview-modal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }
  
  // ESC 关闭
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeImagePreview();
  });
</script>
