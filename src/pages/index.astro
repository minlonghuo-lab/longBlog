---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostItem from '../components/PostItem.astro';
import { getSortedPosts } from '../data/posts';
import { AUTHOR, AUTHOR_INTRO, SOCIAL_LINKS, SITE_TITLE } from '../consts';

const displayPosts = getSortedPosts();

const socialIcons = {
  github: '/social-icons/github.svg',
  email: '/social-icons/email.svg',
};
---

<BaseLayout title={SITE_TITLE} description={AUTHOR_INTRO}>
  <section class="hero-section divider">
    <h1>
      你好 <span class="wave">👋</span>
    </h1>

    <p class="hero-intro">
      我是 <span class="hero-author">{AUTHOR}</span> —— {AUTHOR_INTRO}
    </p>

    <div class="hero-social">
      {SOCIAL_LINKS.map(link => (
        <a
          href={link.url}
          target={link.platform === 'email' ? undefined : '_blank'}
          rel={link.platform === 'email' ? undefined : 'noopener noreferrer'}
          aria-label={link.platform === 'github' ? 'GitHub' : 'Email'}
          title={link.platform === 'github' ? 'GitHub' : 'Email'}
        >
          <img src={socialIcons[link.platform as keyof typeof socialIcons]} alt="" aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>

  <section class="posts-section">
    <div class="section-head">
      <h2>最新文章</h2>
      <a href="/blog">查看全部 →</a>
    </div>

    <div>
      {displayPosts.map(post => (
        <PostItem
          slug={post.slug}
          title={post.title}
          date={post.date}
          tags={post.tags}
          pinned={post.pinned}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding: 3rem 0;
  }

  .hero-section h1 {
    margin: 0 0 1rem;
  }

  .wave {
    display: inline-block;
    animation: wave 2s ease-in-out infinite;
    transform-origin: 70% 70%;
  }

  .hero-intro {
    margin: 0;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  .hero-author {
    color: var(--foreground);
    font-weight: 500;
  }

  .hero-social {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .hero-social a {
    width: 2.1rem;
    height: 2.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in oklab, var(--border) 75%, transparent);
    border-radius: 999px;
    color: var(--muted-foreground);
    transition: color var(--transition-base), border-color var(--transition-base), transform var(--transition-base), background-color var(--transition-base);
  }

  .hero-social a:hover {
    color: var(--foreground);
    border-color: color-mix(in oklab, var(--foreground) 16%, transparent);
    background: color-mix(in oklab, var(--muted) 82%, white);
    transform: translateY(-1px);
  }

  .hero-social a img {
    width: 1rem;
    height: 1rem;
    display: block;
  }

  .posts-section {
    padding: 2rem 0;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .section-head h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .section-head a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
    transition: color var(--transition-base);
  }

  .section-head a:hover {
    color: var(--foreground);
  }

  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(20deg); }
    75% { transform: rotate(-20deg); }
  }
</style>
