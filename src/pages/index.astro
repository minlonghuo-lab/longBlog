---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostItem from '../components/PostItem.astro';
import { getSortedPosts, getPinnedPosts } from '../data/posts';
import { AUTHOR, AUTHOR_INTRO, SOCIAL_LINKS, SITE_TITLE } from '../consts';

const allPosts = getSortedPosts();
const pinnedPosts = getPinnedPosts();
const displayPosts = [...pinnedPosts, ...allPosts.filter(p => !p.pinned)];

const socialIcons = {
  github: `<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2C6.477 2 2 6.596 2 12.267c0 4.537 2.865 8.387 6.839 9.746.5.095.682-.223.682-.495 0-.244-.008-.89-.013-1.747-2.782.617-3.37-1.387-3.37-1.387-.455-1.176-1.11-1.49-1.11-1.49-.908-.636.069-.624.069-.624 1.004.072 1.532 1.053 1.532 1.053.892 1.568 2.341 1.115 2.91.853.091-.664.35-1.116.636-1.373-2.221-.259-4.555-1.14-4.555-5.073 0-1.12.389-2.036 1.029-2.754-.103-.26-.446-1.304.098-2.718 0 0 .84-.276 2.75 1.052A9.29 9.29 0 0 1 12 6.844c.85.004 1.706.118 2.504.346 1.909-1.328 2.748-1.052 2.748-1.052.546 1.414.202 2.458.1 2.718.64.718 1.027 1.634 1.027 2.754 0 3.943-2.338 4.811-4.566 5.065.359.318.679.946.679 1.907 0 1.377-.012 2.487-.012 2.825 0 .274.18.594.688.493C19.138 20.65 22 16.802 22 12.267 22 6.596 17.523 2 12 2Z"></path></svg>`,
  email: `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v12H4z"></path><path d="m4 7 8 6 8-6"></path></svg>`,
};
---

<BaseLayout title={SITE_TITLE} description={AUTHOR_INTRO}>
  <section class="hero-section divider">
    <h1>
      你好 <span class="wave">👋</span>
    </h1>

    <p class="hero-intro">
      我是 <span class="hero-author">{AUTHOR}</span> —— {AUTHOR_INTRO}
    </p>

    <div class="hero-social">
      {SOCIAL_LINKS.map(link => (
        <a
          href={link.url}
          target={link.platform === 'email' ? undefined : '_blank'}
          rel={link.platform === 'email' ? undefined : 'noopener noreferrer'}
          aria-label={link.platform === 'github' ? 'GitHub' : 'Email'}
          title={link.platform === 'github' ? 'GitHub' : 'Email'}
          set:html={socialIcons[link.platform as keyof typeof socialIcons]}
        />
      ))}
    </div>
  </section>

  <section class="posts-section">
    <div class="section-head">
      <h2>最新文章</h2>
      <a href="/blog">查看全部 →</a>
    </div>

    <div>
      {displayPosts.map(post => (
        <PostItem
          slug={post.slug}
          title={post.title}
          date={post.date}
          tags={post.tags}
          pinned={post.pinned}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding: 3rem 0;
  }

  .hero-section h1 {
    margin: 0 0 1rem;
  }

  .wave {
    display: inline-block;
    animation: wave 2s ease-in-out infinite;
    transform-origin: 70% 70%;
  }

  .hero-intro {
    margin: 0;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  .hero-author {
    color: var(--foreground);
    font-weight: 500;
  }

  .hero-social {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .hero-social a {
    width: 2.1rem;
    height: 2.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in oklab, var(--border) 75%, transparent);
    border-radius: 999px;
    color: var(--muted-foreground);
    transition: color var(--transition-base), border-color var(--transition-base), transform var(--transition-base), background-color var(--transition-base);
  }

  .hero-social a:hover {
    color: var(--foreground);
    border-color: color-mix(in oklab, var(--foreground) 16%, transparent);
    background: color-mix(in oklab, var(--muted) 82%, white);
    transform: translateY(-1px);
  }

  .hero-social a svg {
    width: 1rem;
    height: 1rem;
  }

  .posts-section {
    padding: 2rem 0;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .section-head h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .section-head a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
    transition: color var(--transition-base);
  }

  .section-head a:hover {
    color: var(--foreground);
  }

  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(20deg); }
    75% { transform: rotate(-20deg); }
  }
</style>
