---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostItem from '../components/PostItem.astro';
import { getSortedPosts, getPinnedPosts } from '../data/posts';
import { AUTHOR, AUTHOR_INTRO, SOCIAL_LINKS, SITE_TITLE } from '../consts';

// 获取文章
const allPosts = getSortedPosts();
const pinnedPosts = getPinnedPosts();

// 合并置顶文章和非置顶文章
const displayPosts = [...pinnedPosts, ...allPosts.filter(p => !p.pinned)];
---

<BaseLayout title={SITE_TITLE} description={AUTHOR_INTRO}>
  <!-- 简介区 -->
  <section class="py-12 border-b border-border/50">
    <h1 class="text-4xl md:text-5xl font-serif font-medium tracking-tight mb-4">
      你好 <span class="inline-block animate-[wave_2s_ease-in-out_infinite]">👋</span>
    </h1>
    
    <p class="text-muted-foreground leading-relaxed">
      我是 <span class="font-medium text-foreground">{AUTHOR}</span> —— {AUTHOR_INTRO}
    </p>

    <!-- 社交链接 -->
    <div class="flex items-center gap-4 mt-6">
      {SOCIAL_LINKS.map(link => (
        <a 
          href={link.url}
          target={link.platform === 'email' ? undefined : '_blank'}
          rel={link.platform === 'email' ? undefined : 'noopener noreferrer'}
          class="text-xs font-mono text-muted-foreground hover:text-foreground transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>
  </section>

  <!-- 最新文章区 -->
  <section class="py-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-medium">最新文章</h2>
      <a href="/blog" class="text-xs font-mono text-muted-foreground hover:text-foreground transition-colors">
        查看全部 →
      </a>
    </div>
    
    <div class="divide-y divide-border/50">
      {displayPosts.map(post => (
        <PostItem
          slug={post.slug}
          title={post.title}
          date={post.date}
          tags={post.tags}
          pinned={post.pinned}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(20deg); }
    75% { transform: rotate(-20deg); }
  }
</style>
