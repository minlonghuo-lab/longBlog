---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostItem from '../components/PostItem.astro';
import { getHomePosts } from '../data/posts';
import { AUTHOR, AUTHOR_INTRO, SOCIAL_LINKS, SITE_TITLE } from '../consts';
import { PAGE_PATHS } from '../lib/routes.js';

const displayPosts = getHomePosts(10);

// 首页 hero 下落文字的切分片段（与 DOM 中的文字顺序一致）
// 逗号单独成段，其余按语义切分
const [INTRO_PREFIX, ...INTRO_REST] = AUTHOR_INTRO.split(',');
const FALLING_SEGMENTS = [
  '你好',
  '👋',
  '我是',
  AUTHOR,
  '——',
  INTRO_PREFIX,
  '，',
  INTRO_REST.join(','),
].filter(Boolean);

---

<BaseLayout title={SITE_TITLE} description={AUTHOR_INTRO}>
  <section class="hero-section divider" id="hero-falling" data-falling-segments={JSON.stringify(FALLING_SEGMENTS)}>
    <div class="hero-copy" data-falling-root>
      <h1 data-falling-line>你好 👋</h1>
      <p class="hero-intro" data-falling-line>我是 {AUTHOR} —— {INTRO_PREFIX}，{INTRO_REST.join(',')}</p>
    </div>

    <div class="hero-social">
      {SOCIAL_LINKS.map(link => (
        <a
          href={link.url}
          target={link.platform === 'email' ? undefined : '_blank'}
          rel={link.platform === 'email' ? undefined : 'noopener noreferrer'}
          aria-label={link.platform === 'github' ? 'GitHub' : 'Email'}
          title={link.platform === 'github' ? 'GitHub' : 'Email'}
          class="icon-action"
        >
          {link.platform === 'github' ? (
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="social-icon">
              <path fill="currentColor" d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-1.03-.01-1.87-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.56 2.36 1.11 2.94.85.09-.67.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.08 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.95-2.34 4.82-4.57 5.07.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"/>
            </svg>
          ) : (
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="social-icon">
              <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5v10.5H3.75z"/>
              <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="m4.5 7.5 7.5 6 7.5-6"/>
            </svg>
          )}
        </a>
      ))}

      <button
        id="theme-toggle"
        class="theme-toggle icon-action"
        type="button"
        aria-label="切换深色 / 浅色模式"
        title="切换深色 / 浅色模式"
      >
        <svg width="16" height="16" class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="M12 2.75v2.1M12 19.15v2.1M21.25 12h-2.1M4.85 12h-2.1M18.54 5.46l-1.49 1.49M6.95 17.05l-1.49 1.49M18.54 18.54l-1.49-1.49M6.95 6.95 5.46 5.46" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <svg width="16" height="16" class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.2 14.35A7.95 7.95 0 0 1 9.65 3.8a8.6 8.6 0 1 0 10.55 10.55Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        </svg>
      </button>

      <button
        id="search-toggle"
        aria-expanded="false"
        aria-controls="search-panel"
        class="theme-toggle icon-action"
        type="button"
        aria-label="搜索文章"
        title="搜索文章"
      >
        <svg width="16" height="16" class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="5.2" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="M15.2 15.2 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div id="search-panel" class="search-panel" hidden>
      <div class="search-panel-inner" role="dialog" aria-modal="true" aria-label="搜索文章">
        <div class="search-head">
          <input id="search-input" type="search" placeholder="搜索文章标题、标签与正文…" aria-label="搜索文章标题、标签与正文" autocomplete="off" />
          <button id="search-close" type="button" aria-label="关闭搜索">✕</button>
        </div>
        <p id="search-status" class="search-status" role="status" aria-live="polite"></p>
        <div id="search-results" class="search-results" aria-busy="false"></div>
        <button id="search-more" class="search-more" type="button" hidden>加载更多</button>
      </div>
    </div>
  </section>

  <section class="posts-section">
    <div class="section-head">
      <h2>最新文章</h2>
      <a href={PAGE_PATHS.blog}>查看全部 →</a>
    </div>

    <div>
      {displayPosts.map(post => (
        <PostItem
          id={post.id}
          title={post.title}
          publishedAt={post.publishedAt}
          tags={post.tags}
          pinned={post.pinned}
        />
      ))}
    </div>
  </section>
</BaseLayout>



<style>
  .hero-section {
    padding: var(--page-title-padding-top) 0 3rem;
    position: relative;
  }

  .hero-copy {
    position: relative;
  }

  .hero-section h1 {
    margin: 0 0 1rem;
  }

  .wave {
    display: inline-block;
    animation: wave 2s ease-in-out infinite;
    transform-origin: 70% 70%;
  }

  .hero-intro {
    margin: 0;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  .hero-author {
    color: var(--foreground);
    font-weight: 500;
  }

  .icon-action {
    width: 2.1rem;
    height: 2.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in oklab, var(--border) 75%, transparent);
    border-radius: 999px;
    color: var(--muted-foreground);
    background: transparent;
    transition: color var(--transition-base), border-color var(--transition-base), transform var(--transition-base), background-color var(--transition-base), box-shadow var(--transition-base);
  }

  .hero-social .icon-action .social-icon,
  .hero-social .icon-action svg {
    width: 1rem;
    height: 1rem;
    display: block;
  }

  .hero-social .icon-action .social-icon {
    color: currentColor;
    transition: color var(--transition-base), opacity var(--transition-base);
  }

  .hero-social .icon-action:hover,
  .hero-social .icon-action:focus-visible {
    color: var(--foreground);
    border-color: color-mix(in oklab, var(--foreground) 22%, transparent);
    background: color-mix(in oklab, var(--muted) 82%, white);
    transform: translateY(-1px);
    box-shadow: 0 10px 24px color-mix(in oklab, black 8%, transparent);
  }

  .hero-social .icon-action:hover .social-icon,
  .hero-social .icon-action:focus-visible .social-icon {
    color: currentColor;
    opacity: 1;
  }

  .hero-social {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .theme-toggle {
    position: relative;
    cursor: pointer;
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
  }

  .theme-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--foreground) 10%, transparent);
  }

  .theme-icon,
  .search-icon {
    position: absolute;
    width: 1rem;
    height: 1rem;
    transition: opacity 0.28s ease, transform 0.38s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .search-icon {
    position: static;
    transition: none;
  }

  .search-panel {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: start center;
    padding: min(7rem, 12dvh) 1rem 1rem;
    background: rgba(255, 255, 255, 0.42);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
  }

  .search-panel[hidden] { display: none; }

  .search-panel.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  :global(html[data-theme='dark']) .search-panel {
    background: rgba(7, 10, 18, 0.48);
  }

  .search-panel-inner {
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - min(7rem, 12dvh) - 1rem);
    width: min(42rem, 100%);
    border: 1px solid color-mix(in oklab, var(--border) 78%, transparent);
    border-radius: 1.2rem;
    background: color-mix(in oklab, white 96%, var(--muted) 4%);
    box-shadow: 0 28px 80px rgba(15, 23, 42, 0.12);
    overflow: hidden;
  }

  :global(html[data-theme='dark']) .search-panel-inner {
    background: linear-gradient(180deg, rgba(22, 26, 38, 0.98), rgba(17, 21, 32, 0.96));
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.34);
  }

  .search-head {
    flex-shrink: 0;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 68%, transparent);
  }

  .search-head input {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--foreground);
    font-size: 0.98rem;
    outline: none;
  }

  .search-head input::placeholder {
    color: var(--muted-foreground);
  }

  .search-head button {
    border: 0;
    background: transparent;
    color: var(--muted-foreground);
    font-size: 1rem;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    transition: color var(--transition-base), background-color var(--transition-base);
  }

  .search-head button:hover {
    color: var(--foreground);
    background: color-mix(in oklab, var(--muted) 82%, white);
  }

  .search-results {
    min-height: 0;
    max-height: min(60vh, 34rem);
    overflow: auto;
    padding: 0.45rem;
  }

  :global(#search-results .search-result-item) {
    display: grid;
    gap: 0.3rem;
    padding: 0.8rem 0.9rem;
    border-radius: 0.95rem;
    transition: background-color var(--transition-base), transform var(--transition-base);
  }

  :global(#search-results .search-result-item:hover) {
    background: color-mix(in oklab, var(--muted) 80%, white);
    transform: translateY(-1px);
  }

  :global(html[data-theme='dark'] #search-results .search-result-item:hover) {
    background: rgba(255, 255, 255, 0.04);
  }

  :global(#search-results .search-result-title) {
    font-size: 0.95rem;
    color: var(--foreground);
    line-height: 1.7;
  }

  .search-status {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: color-mix(in oklab, var(--muted-foreground) 80%, transparent);
    padding: 0.8rem 1.2rem 0.3rem;
    margin: 0;
  }

  :global(#search-results .search-result-excerpt) {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  :global(#search-results mark) {
    color: var(--foreground);
    background: color-mix(in oklab, var(--foreground) 12%, transparent);
    border-radius: 0.15rem;
  }

  .search-more {
    flex-shrink: 0;
    display: block;
    margin: 0.3rem auto 0.8rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--foreground);
    background: var(--background);
    font: inherit;
    font-size: 0.8rem;
  }

  .search-more[hidden] { display: none; }
  .search-more:disabled { opacity: 0.6; }
  :global(#search-results .search-result-item:focus-visible),
  .search-more:focus-visible, .search-head button:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: -2px;
  }


  .theme-icon-sun {
    opacity: 0;
    transform: scale(0.72) rotate(-36deg);
  }

  .theme-icon-moon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  :global(html[data-theme='light']) .theme-icon-sun {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  :global(html[data-theme='light']) .theme-icon-moon {
    opacity: 0;
    transform: scale(0.72) rotate(28deg);
  }

  :global(html[data-theme='dark']) .theme-icon-sun {
    opacity: 0;
    transform: scale(0.72) rotate(-36deg);
  }

  :global(html[data-theme='dark']) .theme-icon-moon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  @media (max-width: 640px) {
    .search-panel {
      padding-top: min(6rem, 12dvh);
    }

    .search-panel-inner {
      border-radius: 1rem;
    }

    .search-head {
      padding: 0.7rem;
    }
  }

  .posts-section {
    padding: 2rem 0;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .section-head h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .section-head a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
    transition: color var(--transition-base);
  }

  .section-head a:hover {
    color: var(--foreground);
  }

  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(20deg); }
    75% { transform: rotate(-20deg); }
  }
</style>

<script>
  import { initFallingHeroText } from '../scripts/falling-hero-text.js';

  let disposeFalling = null;

  const setupFalling = () => {
    const hero = document.getElementById('hero-falling');
    if (!(hero instanceof HTMLElement)) return;

    let segments = [];
    try {
      segments = JSON.parse(hero.dataset.fallingSegments || '[]');
    } catch {
      segments = [];
    }

    disposeFalling?.();
    disposeFalling = initFallingHeroText(hero, {
      segments,
      gravity: 0.56,
      stiffness: 0.9,
    });
  };

  // 进入页面即初始化；离开时销毁物理世界，回到首页重新开始（等效于复原）
  setupFalling();
  document.addEventListener('astro:page-load', setupFalling);

  document.addEventListener('astro:before-swap', () => {
    disposeFalling?.();
    disposeFalling = null;
  }, { once: true });

  window.addEventListener('beforeunload', () => {
    disposeFalling?.();
    disposeFalling = null;
  });
</script>

