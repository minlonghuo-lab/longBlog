---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FriendCard from '../../components/FriendCard.astro';
import { friendLinks } from '../../data/friends';
---

<BaseLayout title="友链" description="友情链接与站点推荐">
  <header class="page-header">
    <h1>友链</h1>
    <p>交换友链，互访交流，发现更多有趣内容。</p>
  </header>

  <section class="friends-list">
    {friendLinks.length === 0 ? (
      <div class="empty-state">
        <p>暂无友链</p>
      </div>
    ) : (
      <div class="friends-grid">
        {friendLinks.map(link => (
          <FriendCard
            name={link.name}
            url={link.url}
            description={link.description}
            avatar={link.avatar}
          />
        ))}
      </div>
    )}
  </section>

  <section class="apply-section">
    <div class="apply-info">
      <h3>申请友链</h3>
      <p>欢迎交换友链，可通过邮箱联系我。</p>
    </div>
    <a href="mailto:hello@example.com" class="apply-link">✉️ 联系我</a>
  </section>
</BaseLayout>

<style>
  .friends-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    min-height: 10rem;
  }

  @media (min-width: 768px) {
    .friends-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .empty-state {
    padding: 5rem 0;
    text-align: center;
  }

  .empty-state p {
    font-family: var(--font-serif);
    color: var(--muted-foreground);
    opacity: 0.6;
  }

  .apply-section {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .apply-section {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .apply-info h3 {
    margin: 0 0 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }

  .apply-info p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .apply-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted-foreground);
    transition: color var(--transition-base);
  }

  .apply-link:hover {
    color: var(--foreground);
  }
</style>
