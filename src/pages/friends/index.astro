---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FriendCard from '../../components/FriendCard.astro';
import { friendLinks } from '../../data/friends';
---

<BaseLayout title="友链" description="友情链接">
  <!-- 页面标题 -->
  <header class="page-header">
    <h1>友链</h1>
    <p>交换友链，互访交流</p>
  </header>

  <!-- 友链列表 -->
  <div class="friends-list">
    {friendLinks.length === 0 ? (
      <div class="empty-state">
        <p>暂无友链</p>
      </div>
    ) : (
      <div class="friends-grid">
        {friendLinks.map(link => (
          <FriendCard 
            name={link.name}
            url={link.url}
            description={link.description}
            avatar={link.avatar}
          />
        ))}
      </div>
    )}
  </div>

  <!-- 申请友链 -->
  <div class="apply-section">
    <div class="apply-info">
      <h3>申请友链</h3>
      <p>欢迎交换友链，可以在留言板留言或通过邮箱联系</p>
    </div>
    <a href="mailto:hello@example.com" class="apply-link">
      <span>✉️ 联系我</span>
    </a>
  </div>
</BaseLayout>

<style>
  /* 友链网格 */
  .friends-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    min-height: 10rem;
  }

  @media (min-width: 768px) {
    .friends-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* 空状态 */
  .empty-state {
    padding: 5rem 0;
    text-align: center;
  }

  .empty-state p {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--muted-foreground);
    opacity: 0.5;
  }

  /* 申请友链区 */
  .apply-section {
    margin-top: 5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .apply-section {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .apply-info h3 {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground);
    margin: 0 0 0.25rem 0;
  }

  .apply-info p {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--muted-foreground);
    margin: 0;
  }

  .apply-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted-foreground);
    transition: color 0.3s ease;
  }

  .apply-link:hover {
    color: var(--foreground);
  }
</style>
