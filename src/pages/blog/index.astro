---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostItem from '../../components/PostItem.astro';
import { getSortedPosts, getAllTags } from '../../data/posts';

const posts = getSortedPosts();
const tags = getAllTags();
const currentTag = Astro.url.searchParams.get('tag');
---

<BaseLayout title="文章" description="博客文章列表">
  <!-- 页面标题 -->
  <header class="page-header">
    <h1>文章</h1>
    <p>技术随笔与生活感悟</p>
  </header>

  <!-- 标签筛选 -->
  {tags.length > 0 && (
    <div class="tags-filter">
      <a href="/blog" class:list={['tag', { active: !currentTag }]}>
        全部
      </a>
      {tags.map(tag => (
        <a 
          href={`/blog?tag=${encodeURIComponent(tag.name)}`}
          class:list={['tag', { active: currentTag === tag.name }]}
        >
          #{tag.name}
        </a>
      ))}
    </div>
  )}

  <!-- 文章列表 -->
  <div class="posts-list">
    {posts.length === 0 ? (
      <div class="empty-state">
        <p>暂无文章</p>
      </div>
    ) : (
      posts.map(post => (
        <PostItem
          slug={post.slug}
          title={post.title}
          summary={post.summary}
          publishedAt={post.publishedAt}
          tags={post.tags}
          pinned={post.pinned}
        />
      ))
    )}
  </div>
</BaseLayout>

<style>
  /* 标签筛选 */
  .tags-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background-color: var(--muted);
    color: var(--muted-foreground);
    opacity: 0.6;
    transition: all 0.3s ease;
  }

  .tag:hover {
    opacity: 0.8;
    color: var(--foreground);
  }

  .tag.active {
    opacity: 1;
    color: var(--foreground);
    background-color: var(--foreground);
    color: var(--background);
  }

  /* 空状态 */
  .empty-state {
    padding: 5rem 0;
    text-align: center;
  }

  .empty-state p {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--muted-foreground);
    opacity: 0.5;
  }
</style>
