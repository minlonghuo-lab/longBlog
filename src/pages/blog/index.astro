---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostItem from '../../components/PostItem.astro';
import { getSortedPosts, getAllTags } from '../../data/posts';

const posts = getSortedPosts();
const tags = getAllTags();
const selectedTag = Astro.url.searchParams.get('tag') || '';
const hasMoreTags = tags.length > 8;
const visibleTags = tags.slice(0, 7);
const hiddenTags = tags.slice(7);
---

<BaseLayout title="文章" description="文章列表与标签筛选">
  <header class="page-header">
    <h1>文章</h1>
    <p>沉淀技术、想法与实践记录。</p>
  </header>

  <section class="tag-filter">
    <div class="tag-hint">TAG FILTER</div>

    <div class="tag-row" id="tag-row">
      <a href="/blog" data-tag="" class:list={["tag-link", { active: !selectedTag }]}>全部</a>

      {visibleTags.map(tag => (
        <a
          href={`/blog?tag=${encodeURIComponent(tag.name)}`}
          data-tag={tag.name}
          class:list={["tag-link", { active: selectedTag === tag.name }]}
        >
          <span>{tag.name}</span>
          <small>{tag.count}</small>
        </a>
      ))}

      {hasMoreTags && (
        <>
          <div class="tag-extra" id="tag-extra" hidden>
            {hiddenTags.map(tag => (
              <a
                href={`/blog?tag=${encodeURIComponent(tag.name)}`}
                data-tag={tag.name}
                class:list={["tag-link", { active: selectedTag === tag.name }]}
              >
                <span>{tag.name}</span>
                <small>{tag.count}</small>
              </a>
            ))}
          </div>
          <button class="tag-toggle" id="tag-toggle" type="button" aria-expanded="false" aria-controls="tag-extra">+</button>
        </>
      )}
    </div>
  </section>

  <section class="posts-list" id="posts-list">
    {posts.map(post => (
      <div class="post-row" data-tags={post.tags.join('|')}>
        <PostItem
          title={post.title}
          publishedAt={post.publishedAt}
          tags={post.tags}
          slug={post.slug}
          pinned={post.pinned}
        />
      </div>
    ))}

    <div class="empty" id="posts-empty" style="display:none;">暂无文章</div>
  </section>
</BaseLayout>

<script>
  (() => {
    const rows = Array.from(document.querySelectorAll('.post-row'));
    const empty = document.getElementById('posts-empty');
    const tagLinks = Array.from(document.querySelectorAll('#tag-row .tag-link'));
    const tagToggle = document.getElementById('tag-toggle');
    const tagExtra = document.getElementById('tag-extra');

    const applyFilter = (selectedTag) => {
      let visibleCount = 0;

      for (const row of rows) {
        const tagStr = row.getAttribute('data-tags') || '';
        const tags = tagStr ? tagStr.split('|') : [];
        const visible = !selectedTag || tags.includes(selectedTag);

        if (visible) {
          row.classList.remove('is-hidden');
          row.style.display = '';
          requestAnimationFrame(() => row.classList.add('is-visible'));
          visibleCount += 1;
        } else {
          row.classList.remove('is-visible');
          row.classList.add('is-hidden');
          window.setTimeout(() => {
            if (row.classList.contains('is-hidden')) row.style.display = 'none';
          }, 120);
        }
      }

      if (empty) {
        empty.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      for (const link of tagLinks) {
        const tag = link.getAttribute('data-tag') || '';
        link.classList.toggle('active', tag === selectedTag);
      }
    };

    if (tagToggle && tagExtra) {
      tagToggle.addEventListener('click', () => {
        const expanded = tagToggle.getAttribute('aria-expanded') === 'true';
        tagToggle.setAttribute('aria-expanded', String(!expanded));
        tagToggle.textContent = expanded ? '+' : '-';

        if (expanded) {
          tagExtra.classList.remove('is-visible');
          window.setTimeout(() => {
            tagExtra.hidden = true;
          }, 180);
        } else {
          tagExtra.hidden = false;
          tagExtra.classList.remove('is-visible');
          void tagExtra.offsetWidth;
          requestAnimationFrame(() => {
            requestAnimationFrame(() => tagExtra.classList.add('is-visible'));
          });
          requestAnimationFrame(() => {
            tagExtra.scrollTop = 0;
          });
        }
      });
    }

    const currentTag = new URLSearchParams(window.location.search).get('tag') || '';
    applyFilter(currentTag);

    for (const link of tagLinks) {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const tag = link.getAttribute('data-tag') || '';
        const url = new URL(window.location.href);
        if (tag) {
          url.searchParams.set('tag', tag);
        } else {
          url.searchParams.delete('tag');
        }
        window.history.pushState({}, '', url);
        applyFilter(tag);
      });
    }

    window.addEventListener('popstate', () => {
      const tag = new URLSearchParams(window.location.search).get('tag') || '';
      applyFilter(tag);
    });
  })();
</script>

<style>
  .tag-filter { margin-bottom: 2.5rem; }

  .tag-hint {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);
    margin-bottom: 0.8rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.8rem 1.2rem;
  }

  .tag-extra {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: flex-start;
    align-content: flex-start;
    gap: 0.8rem 1.2rem;
    width: 100%;
    max-height: min(14rem, 36vh);
    overflow: auto;
    padding: 0.2rem 0.3rem 0.25rem 0;
    margin-top: 0.15rem;
    border-top: 1px solid color-mix(in oklab, var(--border) 50%, transparent);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.18s ease, transform 0.18s ease;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklab, var(--border) 85%, transparent) transparent;
  }

  .tag-extra.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .tag-extra[hidden] {
    display: none !important;
  }

  html[data-theme='dark'] .tag-extra {
    border-top-color: rgba(255, 255, 255, 0.08);
  }

  .tag-link {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--muted-foreground);
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    transition: color var(--transition-base);
  }

  .tag-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.15rem;
    width: 0;
    height: 1px;
    background: var(--foreground);
    transition: width var(--transition-base);
  }

  .tag-link:hover,
  .tag-link.active { color: var(--foreground); }

  .tag-link:hover::after,
  .tag-link.active::after { width: 100%; }

  .tag-link small {
    font-size: 0.62rem;
    opacity: 0.5;
  }

  .tag-toggle {
    width: 1.65rem;
    height: 1.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 999px;
    background: transparent;
    color: color-mix(in oklab, var(--muted-foreground) 78%, transparent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1;
    transition: color var(--transition-base), border-color var(--transition-base), background-color var(--transition-base);
  }

  .tag-toggle:hover {
    color: var(--foreground);
    border-color: color-mix(in oklab, var(--foreground) 18%, transparent);
    background: color-mix(in oklab, var(--muted) 84%, white);
  }

  .posts-list {
    border-top: 1px solid color-mix(in oklab, var(--border) 40%, transparent);
  }

  .post-row {
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.14s ease, transform 0.14s ease;
  }

  .post-row.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .post-row.is-hidden {
    opacity: 0;
    transform: translateY(4px);
  }

  .empty {
    padding: 5rem 0;
    font-family: var(--font-serif);
    color: color-mix(in oklab, var(--muted-foreground) 65%, transparent);
  }
</style>

