---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostItem from '../../components/PostItem.astro';
import { getSortedPosts, getAllTags } from '../../data/posts';

const posts = getSortedPosts();
const tags = getAllTags();
const selectedTag = Astro.url.searchParams.get('tag') || '';
const filteredPosts = selectedTag ? posts.filter(p => p.tags.includes(selectedTag)) : posts;
const hasMoreTags = tags.length > 8;
const visibleTags = tags.slice(0, 8);
---

<BaseLayout title="文章" description="文章列表与标签筛选">
  <header class="page-header">
    <h1>文章</h1>
    <p>沉淀技术、想法与实践记录。</p>
  </header>

  <section class="tag-filter">
    <div class="tag-hint">TAG FILTER</div>

    <div class="tag-row">
      <a href="/blog" class:list={["tag-link", { active: !selectedTag }]}>全部</a>

      {visibleTags.map(tag => (
        <a
          href={`/blog?tag=${encodeURIComponent(tag.name)}`}
          class:list={["tag-link", { active: selectedTag === tag.name }]}
        >
          <span>{tag.name}</span>
          <small>{tag.count}</small>
        </a>
      ))}

      {hasMoreTags && <span class="tag-more">+{tags.length - 8}</span>}
    </div>
  </section>

  <section class="posts-list">
    {filteredPosts.length === 0 ? (
      <div class="empty">暂无文章</div>
    ) : (
      filteredPosts.map(post => (
        <PostItem
          title={post.title}
          date={post.date}
          tags={post.tags}
          slug={post.slug}
          pinned={post.pinned}
        />
      ))
    )}
  </section>
</BaseLayout>

<style>
  .tag-filter { margin-bottom: 2.5rem; }

  .tag-hint {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);
    margin-bottom: 0.8rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.2rem;
  }

  .tag-link {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--muted-foreground);
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    transition: color var(--transition-base);
  }

  .tag-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.15rem;
    width: 0;
    height: 1px;
    background: var(--foreground);
    transition: width var(--transition-base);
  }

  .tag-link:hover,
  .tag-link.active { color: var(--foreground); }

  .tag-link:hover::after,
  .tag-link.active::after { width: 100%; }

  .tag-link small {
    font-size: 0.62rem;
    opacity: 0.5;
  }

  .tag-more {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: color-mix(in oklab, var(--muted-foreground) 60%, transparent);
  }

  .posts-list {
    border-top: 1px solid color-mix(in oklab, var(--border) 40%, transparent);
  }

  .empty {
    padding: 5rem 0;
    font-family: var(--font-serif);
    color: color-mix(in oklab, var(--muted-foreground) 65%, transparent);
  }
</style>
