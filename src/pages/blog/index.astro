---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostItem from '../../components/PostItem.astro';
import { getSortedPosts, getAllTags } from '../../data/posts';

const posts = getSortedPosts();
const tags = getAllTags();
---

<BaseLayout title="文章" description="博客文章列表">
  <div class="min-h-screen flex flex-col">
    <Header />
    
    <main class="flex-1 max-w-3xl mx-auto px-4 py-8 w-full">
      <div class="mb-8">
        <h1 class="text-4xl font-serif font-medium tracking-tight mb-2">文章</h1>
        <p class="text-muted-foreground font-mono text-xs tracking-wider">
          共 {posts.length} 篇
        </p>
      </div>

      <!-- 标签筛选 -->
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-6">
          <a href="/blog" class="px-2 py-0.5 text-xs font-mono bg-foreground text-background rounded-md">
            全部
          </a>
          {tags.map(tag => (
            <a 
              href={`/blog?tag=${tag}`}
              class="px-2 py-0.5 text-xs font-mono text-muted-foreground hover:text-foreground bg-muted rounded-md transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}

      <!-- 文章列表 -->
      <div class="divide-y divide-border/50">
        {posts.map(post => (
          <PostItem 
            title={post.title}
            date={post.date}
            tags={post.tags}
            slug={post.slug}
            pinned={post.pinned}
          />
        ))}
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
