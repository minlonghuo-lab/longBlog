---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostItem from '../../components/PostItem.astro';
import { getSortedPosts, getAllTags } from '../../data/posts';

const posts = getSortedPosts();
const tags = getAllTags();
const selectedTag = Astro.url.searchParams.get('tag') || '';
const pageSize = 10;
const hasMoreTags = tags.length > 8;
const visibleTags = tags.slice(0, 7);
const hiddenTags = tags.slice(7);
---

<BaseLayout title="文章" description="文章列表与标签筛选">
  <header class="page-header">
    <h1>文章</h1>
    <p>沉淀技术、想法与实践记录。</p>
  </header>

  <section class="tag-filter">
    <div class="tag-hint">TAG FILTER</div>

    <div class="tag-row" id="tag-row">
      <a href="/blog" data-tag="" class:list={["tag-link", { active: !selectedTag }]}>全部</a>

      {visibleTags.map(tag => (
        <a
          href={`/blog?tag=${encodeURIComponent(tag.name)}`}
          data-tag={tag.name}
          class:list={["tag-link", { active: selectedTag === tag.name }]}
        >
          <span>{tag.name}</span>
          <small>{tag.count}</small>
        </a>
      ))}

      {hasMoreTags && (
        <>
          <div class="tag-extra" id="tag-extra" hidden>
            {hiddenTags.map(tag => (
              <a
                href={`/blog?tag=${encodeURIComponent(tag.name)}`}
                data-tag={tag.name}
                class:list={["tag-link", { active: selectedTag === tag.name }]}
              >
                <span>{tag.name}</span>
                <small>{tag.count}</small>
              </a>
            ))}
          </div>
          <button class="tag-toggle" id="tag-toggle" type="button" aria-expanded="false" aria-controls="tag-extra">+</button>
        </>
      )}
    </div>
  </section>

  <section class="posts-list" id="posts-list" data-page-size={pageSize}>
    {posts.map((post, index) => (
      <div class="post-row" hidden={index >= pageSize} data-tags={post.tags.join('|')}>
        <PostItem
          title={post.title}
          publishedAt={post.publishedAt}
          tags={post.tags}
          slug={post.slug}
          pinned={post.pinned}
        />
      </div>
    ))}

    <div class="empty" id="posts-empty" style="display:none;">暂无文章</div>
  </section>

  <nav class="pagination" id="pagination" aria-label="文章分页" hidden>
    <button class="page-nav" id="page-prev" type="button" aria-label="上一页">←</button>
    <div class="page-numbers" id="page-numbers"></div>
    <button class="page-nav" id="page-next" type="button" aria-label="下一页">→</button>
  </nav>
</BaseLayout>



<style>
  .tag-filter { margin-bottom: 2.5rem; }

  .tag-hint {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);
    margin-bottom: 0.8rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.8rem 1.2rem;
  }

  .tag-extra {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: flex-start;
    align-content: flex-start;
    gap: 0.8rem 1.2rem;
    width: 100%;
    max-height: min(14rem, 36vh);
    overflow: auto;
    padding: 0.2rem 0.3rem 0.25rem 0;
    margin-top: 0.15rem;
    border-top: 1px solid color-mix(in oklab, var(--border) 50%, transparent);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.18s ease, transform 0.18s ease;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklab, var(--border) 85%, transparent) transparent;
  }

  .tag-extra.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .tag-extra[hidden] {
    display: none !important;
  }

  html[data-theme='dark'] .tag-extra {
    border-top-color: rgba(255, 255, 255, 0.08);
  }

  .tag-link {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--muted-foreground);
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    transition: color var(--transition-base);
  }

  .tag-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.15rem;
    width: 0;
    height: 1px;
    background: var(--foreground);
    transition: width var(--transition-base);
  }

  .tag-link:hover,
  .tag-link.active { color: var(--foreground); }

  .tag-link:hover::after,
  .tag-link.active::after { width: 100%; }

  .tag-link small {
    font-size: 0.62rem;
    opacity: 0.5;
  }

  .tag-toggle {
    width: 1.65rem;
    height: 1.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 999px;
    background: transparent;
    color: color-mix(in oklab, var(--muted-foreground) 78%, transparent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1;
    transition: color var(--transition-base), border-color var(--transition-base), background-color var(--transition-base);
  }

  .tag-toggle:hover {
    color: var(--foreground);
    border-color: color-mix(in oklab, var(--foreground) 18%, transparent);
    background: color-mix(in oklab, var(--muted) 84%, white);
  }

  .posts-list {
    border-top: 1px solid color-mix(in oklab, var(--border) 40%, transparent);
  }

  .post-row[hidden] {
    display: none;
  }

  :global(.pagination) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2rem;
    color: var(--muted-foreground);
    opacity: 0.72;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  :global(.pagination[hidden]) { display: none; }

  :global(.page-numbers) {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }

  :global(.page-nav),
  :global(.page-number) {
    min-width: 1.35rem;
    height: 1.5rem;
    padding: 0 0.18rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    line-height: 1;
    cursor: pointer;
    transition: color var(--transition-base), opacity var(--transition-base);
  }

  :global(.page-nav) {
    min-width: 1.55rem;
    font-size: 0.98rem;
  }

  :global(.page-nav:hover:not(:disabled)),
  :global(.page-number:hover),
  :global(.page-number.active) {
    color: var(--foreground);
    opacity: 1;
  }

  :global(.page-number.active) { cursor: default; }
  :global(.page-nav:disabled) { opacity: 0.42; cursor: default; }

  :global(.page-gap) {
    min-width: 0.65rem;
    color: inherit;
    text-align: center;
  }

  .empty {
    padding: 5rem 0;
    font-family: var(--font-serif);
    color: color-mix(in oklab, var(--muted-foreground) 65%, transparent);
  }
</style>


