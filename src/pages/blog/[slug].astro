---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}
---

<BaseLayout title={post.title} description={post.summary || `${post.title} - longBlog`}>
  <div class="reading-progress" aria-hidden="true">
    <div id="reading-progress-bar" class="reading-progress-bar"></div>
  </div>

  <div class="post-page-wrap">
    <div class="post-reading-stage">
      <aside class="post-sidebar" aria-label="文章目录侧栏">
        <div class="toc-card toc-card-desktop">
          <div class="toc-title-row">
            <span class="toc-title">文章导航</span>
            <span id="reading-progress-text" class="reading-progress-text">0%</span>
          </div>
          <nav id="post-toc-desktop" class="toc-nav" aria-label="文章目录"></nav>
        </div>
      </aside>

      <article class="post-paper">
        <a href="/blog" class="back-link">← 返回文章列表</a>

        <header class="post-header" id="post-top">
          <h1>{post.title}</h1>
          {post.summary && <p class="summary">{post.summary}</p>}

          <div class="meta">
            <time>创建：{formatDate(post.date)}</time>
            <time>更新：{formatDate(post.updatedAt)}</time>
            <div class="tags">
              {post.tags.map((tag) => <span>#{tag}</span>)}
            </div>
          </div>
        </header>

        <details class="toc-mobile" id="toc-mobile-wrap">
          <summary>
            <span>文章导航</span>
            <span id="reading-progress-text-mobile" class="reading-progress-text">0%</span>
          </summary>
          <nav id="post-toc-mobile" class="toc-nav toc-nav-mobile" aria-label="移动端文章目录"></nav>
        </details>

        <section id="post-content" class="content" set:html={post.contentHtml}></section>
      </article>
    </div>
  </div>

  <button id="back-to-top" class="back-to-top" type="button" aria-label="回到顶部" title="回到顶部">
    ↑
  </button>

  <script>
    (() => {
      const content = document.getElementById('post-content');
      const desktopToc = document.getElementById('post-toc-desktop');
      const mobileToc = document.getElementById('post-toc-mobile');
      const progressBar = document.getElementById('reading-progress-bar');
      const progressText = document.getElementById('reading-progress-text');
      const progressTextMobile = document.getElementById('reading-progress-text-mobile');
      const backToTop = document.getElementById('back-to-top');
      const mobileTocWrap = document.getElementById('toc-mobile-wrap');
      if (!(content instanceof HTMLElement) || !(desktopToc instanceof HTMLElement) || !(mobileToc instanceof HTMLElement)) return;

      const slugifyHeading = (text, index) => {
        const base = (text || `section-${index + 1}`)
          .trim()
          .toLowerCase()
          .replace(/[^\w\u4e00-\u9fff\-\s]/g, '')
          .replace(/\s+/g, '-');
        return base || `section-${index + 1}`;
      };

      const headings = Array.from(content.querySelectorAll('h1, h2, h3, h4'));
      const usedIds = new Set();
      const tocItems = headings.map((heading, index) => {
        let id = heading.id || slugifyHeading(heading.textContent || '', index);
        while (usedIds.has(id)) id = `${id}-${index + 1}`;
        usedIds.add(id);
        heading.id = id;
        return {
          id,
          text: (heading.textContent || '').trim() || `章节 ${index + 1}`,
          level: Number(heading.tagName.slice(1)),
          el: heading,
        };
      });

      const tocHTML = tocItems.length
        ? tocItems
            .map(
              (item) => `<a href="#${item.id}" class="toc-link toc-level-${item.level}" data-target="${item.id}">${item.text}</a>`
            )
            .join('')
        : '<span class="toc-empty">本文暂无可导航标题</span>';

      desktopToc.innerHTML = tocHTML;
      mobileToc.innerHTML = tocHTML;

      const getAllTocLinks = () => Array.from(document.querySelectorAll('.toc-link'));

      const updateReadingProgress = () => {
        const articleHeight = content.scrollHeight;
        const viewportHeight = window.innerHeight;
        const start = content.offsetTop;
        const max = Math.max(articleHeight - viewportHeight, 1);
        const scrolled = Math.min(Math.max(window.scrollY - start, 0), max);
        const percent = Math.max(0, Math.min(100, Math.round((scrolled / max) * 100)));
        if (progressBar) progressBar.style.width = `${percent}%`;
        if (progressText) progressText.textContent = `${percent}%`;
        if (progressTextMobile) progressTextMobile.textContent = `${percent}%`;
        if (backToTop) backToTop.classList.toggle('visible', window.scrollY > start + 260);
      };

      const updateActiveHeading = () => {
        const tocLinks = getAllTocLinks();
        if (!tocLinks.length) return;
        let currentId = tocItems[0]?.id;
        for (const item of tocItems) {
          if (item.el.getBoundingClientRect().top <= 140) currentId = item.id;
        }
        tocLinks.forEach((link) => {
          link.classList.toggle('active', link.dataset.target === currentId);
        });
      };

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const link = target.closest('.toc-link');
        if (!(link instanceof HTMLAnchorElement)) return;
        event.preventDefault();
        const id = link.dataset.target;
        const heading = id ? document.getElementById(id) : null;
        if (!heading) return;
        const top = heading.getBoundingClientRect().top + window.scrollY - 96;
        window.scrollTo({ top, behavior: 'smooth' });
        if (window.innerWidth < 1080 && mobileTocWrap instanceof HTMLDetailsElement) {
          mobileTocWrap.open = false;
        }
      });

      backToTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      const onScroll = () => {
        updateReadingProgress();
        updateActiveHeading();
      };

      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    })();
  </script>
</BaseLayout>

<style is:global>
  .post-page-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .post-reading-stage {
    position: relative;
    width: min(100%, 46rem);
  }

  .post-paper {
    position: relative;
    width: 100%;
    margin: 0 auto;
    padding: 0;
  }

  .post-sidebar {
    position: absolute;
    top: 10.5rem;
    left: calc(100% + 2.5rem);
    width: 14rem;
  }

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }

  .reading-progress-bar {
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, rgba(17, 17, 17, 0.95), rgba(17, 17, 17, 0.35));
    transition: width 0.12s linear;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2.3rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-foreground);
    transition: color var(--transition-base);
  }

  .back-link:hover { color: var(--foreground); }

  .post-header {
    margin-bottom: 2.75rem;
  }

  .post-header h1 {
    max-width: 34rem;
    margin: 0 0 1.15rem;
    font-size: clamp(2.5rem, 5.4vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .post-header .summary {
    max-width: 34rem;
    margin: 0 0 1.2rem;
    color: color-mix(in oklab, var(--muted-foreground) 88%, transparent);
    line-height: 1.95;
    font-size: 1rem;
    font-weight: 300;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted-foreground);
  }

  .tags {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .toc-card {
    position: sticky;
    top: 6.25rem;
    border: 1px solid color-mix(in oklab, var(--border) 86%, transparent);
    border-radius: 1rem;
    padding: 0.95rem 0.8rem;
    background: color-mix(in oklab, white 90%, var(--muted) 10%);
    box-shadow: 0 12px 32px color-mix(in oklab, black 5%, transparent);
  }

  .toc-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
  }

  .toc-title,
  .reading-progress-text {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted-foreground);
    letter-spacing: 0.02em;
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    max-height: calc(100vh - 10rem);
    overflow: auto;
    padding-right: 0.1rem;
  }

  .toc-link {
    display: block;
    padding: 0.38rem 0.55rem;
    border-radius: 0.7rem;
    color: var(--muted-foreground);
    line-height: 1.45;
    font-size: 0.84rem;
    transition: background-color var(--transition-base), color var(--transition-base), transform var(--transition-base);
  }

  .toc-link:hover {
    color: var(--foreground);
    background: color-mix(in oklab, var(--muted) 86%, white);
  }

  .toc-link.active {
    color: var(--foreground);
    background: color-mix(in oklab, var(--foreground) 8%, white);
  }

  .toc-level-1 { padding-left: 0.55rem; }
  .toc-level-2 { padding-left: 0.9rem; }
  .toc-level-3 { padding-left: 1.2rem; font-size: 0.8rem; }
  .toc-level-4 { padding-left: 1.45rem; font-size: 0.77rem; }
  .toc-empty { color: var(--muted-foreground); font-size: 0.88rem; }

  .toc-mobile {
    display: none;
    margin: 0 0 1.5rem;
    border: 1px solid color-mix(in oklab, var(--border) 85%, transparent);
    border-radius: 0.9rem;
    background: color-mix(in oklab, white 92%, var(--muted) 8%);
    overflow: hidden;
  }

  .toc-mobile summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted-foreground);
  }

  .toc-mobile summary::-webkit-details-marker { display: none; }
  .toc-nav-mobile {
    max-height: 16rem;
    padding: 0 0.7rem 0.8rem;
  }

  .content {
    max-width: 100%;
    margin: 0 auto;
  }

  .content p,
  .content li {
    line-height: 2;
    color: var(--foreground);
    font-size: 1rem;
  }

  .content p { margin: 0 0 1rem; }

  .content h1,
  .content h2,
  .content h3,
  .content h4 {
    margin: 2rem 0 0.85rem;
    scroll-margin-top: 6rem;
  }

  .content h2 {
    font-size: 1.55rem;
    line-height: 1.3;
  }

  .content h3 {
    font-size: 1.2rem;
    line-height: 1.45;
  }

  .content ul,
  .content ol {
    padding-left: 1.3rem;
    margin: 0.7rem 0 1rem;
  }

  .content blockquote {
    margin: 1rem 0;
    padding: 0.75rem 0.95rem;
    border-left: 3px solid color-mix(in oklab, var(--foreground) 22%, transparent);
    background: color-mix(in oklab, var(--muted) 90%, white);
  }

  .content figure {
    margin: 1.5rem auto;
    text-align: center;
  }

  .content img {
    display: block;
    max-width: min(100%, 760px);
    height: auto;
    border-radius: 0.45rem;
    margin: 0.9rem auto;
  }

  .content p > img,
  .content figure > img {
    margin-left: auto;
    margin-right: auto;
  }

  .content figcaption {
    margin-top: 0.45rem;
    color: var(--muted-foreground);
    font-size: 0.88rem;
    text-align: center;
  }

  .content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.92rem;
    display: block;
    overflow-x: auto;
  }

  .content th,
  .content td {
    border: 1px solid color-mix(in oklab, var(--border) 85%, transparent);
    padding: 0.5rem 0.6rem;
    vertical-align: top;
    white-space: normal;
  }

  .content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: color-mix(in oklab, var(--muted) 92%, white);
    padding: 0.1em 0.3em;
    border-radius: 0.25rem;
  }

  .content pre {
    overflow-x: auto;
    padding: 0.85rem;
    border-radius: 0.45rem;
    background: color-mix(in oklab, var(--muted) 94%, white);
  }

  .content pre code {
    background: transparent;
    padding: 0;
  }

  .back-to-top {
    position: fixed;
    right: max(1.25rem, calc((100vw - 1160px) / 2 + 1.25rem));
    bottom: 2rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in oklab, var(--border) 82%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, white 90%, var(--muted) 10%);
    color: var(--foreground);
    box-shadow: 0 10px 30px color-mix(in oklab, black 8%, transparent);
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity var(--transition-base), transform var(--transition-base), background-color var(--transition-base);
    z-index: 55;
  }

  .back-to-top.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top:hover {
    background: color-mix(in oklab, var(--muted) 82%, white);
  }

  @media (max-width: 1400px) {
    .post-reading-stage {
      width: min(100%, 58rem);
      padding-right: 16rem;
    }

    .post-sidebar {
      left: auto;
      right: 0;
      width: 13rem;
    }
  }

  @media (max-width: 1080px) {
    .post-reading-stage {
      width: 100%;
      padding-right: 0;
    }

    .post-sidebar {
      display: none;
    }

    .toc-mobile {
      display: block;
    }

    .post-header h1 {
      max-width: 100%;
      font-size: clamp(2.15rem, 10vw, 3rem);
      line-height: 1.08;
    }

    .post-header .summary {
      max-width: 100%;
      font-size: 0.98rem;
      line-height: 1.9;
    }

    .content p,
    .content li {
      font-size: 0.98rem;
      line-height: 1.95;
    }

    .content h2 {
      font-size: 1.35rem;
    }

    .content h3 {
      font-size: 1.12rem;
    }

    .back-to-top {
      right: 1rem;
      bottom: 1.2rem;
    }
  }

  @media (max-width: 640px) {
    .back-link {
      margin-bottom: 1.5rem;
      font-size: 0.68rem;
    }

    .post-header {
      margin-bottom: 1.9rem;
    }

    .meta {
      gap: 0.55rem;
      font-size: 0.64rem;
      line-height: 1.6;
    }

    .post-header .summary {
      font-size: 0.94rem;
    }

    .content p,
    .content li {
      font-size: 0.95rem;
      line-height: 1.9;
    }

    .content figure {
      margin: 1.15rem auto;
    }

    .content table {
      font-size: 0.85rem;
    }
  }
</style>
