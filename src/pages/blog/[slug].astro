---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}
---

<BaseLayout title={post.title} description={post.summary || `${post.title} - longBlog`}>
  <div class="reading-progress" aria-hidden="true">
    <div id="reading-progress-bar" class="reading-progress-bar"></div>
  </div>

  <div class="post-shell">
    <section class="post-main">
      <a href="/blog" class="back-link">← 返回文章列表</a>

      <header class="post-header" id="post-top">
        <h1>{post.title}</h1>
        {post.summary && <p class="summary">{post.summary}</p>}

        <div class="meta">
          <time>创建：{formatDate(post.date)}</time>
          <time>更新：{formatDate(post.updatedAt)}</time>
          <div class="tags">
            {post.tags.map((tag) => <span>#{tag}</span>)}
          </div>
        </div>
      </header>

      <article id="post-content" class="content" set:html={post.contentHtml}></article>
    </section>

    <aside class="post-sidebar">
      <div class="toc-card">
        <div class="toc-title-row">
          <span class="toc-title">文章导航</span>
          <span id="reading-progress-text" class="reading-progress-text">0%</span>
        </div>
        <nav id="post-toc" class="toc-nav" aria-label="文章目录"></nav>
      </div>
    </aside>
  </div>

  <button id="back-to-top" class="back-to-top" type="button" aria-label="回到顶部" title="回到顶部">
    ↑
  </button>

  <script>
    (() => {
      const content = document.getElementById('post-content');
      const toc = document.getElementById('post-toc');
      const progressBar = document.getElementById('reading-progress-bar');
      const progressText = document.getElementById('reading-progress-text');
      const backToTop = document.getElementById('back-to-top');
      if (!(content instanceof HTMLElement) || !(toc instanceof HTMLElement)) return;

      const slugifyHeading = (text, index) => {
        const base = (text || `section-${index + 1}`)
          .trim()
          .toLowerCase()
          .replace(/[^\w\u4e00-\u9fff\-\s]/g, '')
          .replace(/\s+/g, '-');
        return base || `section-${index + 1}`;
      };

      const headings = Array.from(content.querySelectorAll('h1, h2, h3, h4'));
      const usedIds = new Set();
      const tocItems = headings.map((heading, index) => {
        let id = heading.id || slugifyHeading(heading.textContent || '', index);
        while (usedIds.has(id)) id = `${id}-${index + 1}`;
        usedIds.add(id);
        heading.id = id;
        return {
          id,
          text: (heading.textContent || '').trim() || `章节 ${index + 1}`,
          level: Number(heading.tagName.slice(1)),
          el: heading,
        };
      });

      toc.innerHTML = tocItems.length
        ? tocItems
            .map(
              (item) => `<a href="#${item.id}" class="toc-link toc-level-${item.level}" data-target="${item.id}">${item.text}</a>`
            )
            .join('')
        : '<span class="toc-empty">本文暂无可导航标题</span>';

      const tocLinks = Array.from(toc.querySelectorAll('.toc-link'));
      const updateReadingProgress = () => {
        const articleHeight = content.scrollHeight;
        const viewportHeight = window.innerHeight;
        const start = content.offsetTop;
        const max = Math.max(articleHeight - viewportHeight, 1);
        const scrolled = Math.min(Math.max(window.scrollY - start, 0), max);
        const percent = Math.max(0, Math.min(100, Math.round((scrolled / max) * 100)));
        if (progressBar) progressBar.style.width = `${percent}%`;
        if (progressText) progressText.textContent = `${percent}%`;
        if (backToTop) backToTop.classList.toggle('visible', window.scrollY > start + 240);
      };

      const updateActiveHeading = () => {
        if (!tocLinks.length) return;
        let currentId = tocItems[0]?.id;
        for (const item of tocItems) {
          if (item.el.getBoundingClientRect().top <= 140) currentId = item.id;
        }
        tocLinks.forEach((link) => {
          link.classList.toggle('active', link.dataset.target === currentId);
        });
      };

      toc.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const link = target.closest('.toc-link');
        if (!(link instanceof HTMLAnchorElement)) return;
        event.preventDefault();
        const id = link.dataset.target;
        const heading = id ? document.getElementById(id) : null;
        if (!heading) return;
        const top = heading.getBoundingClientRect().top + window.scrollY - 96;
        window.scrollTo({ top, behavior: 'smooth' });
      });

      backToTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      const onScroll = () => {
        updateReadingProgress();
        updateActiveHeading();
      };

      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    })();
  </script>
</BaseLayout>

<style is:global>
  .post-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .post-main {
    min-width: 0;
  }

  .post-sidebar {
    position: sticky;
    top: 5.5rem;
  }

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: transparent;
    z-index: 60;
    pointer-events: none;
  }

  .reading-progress-bar {
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--foreground), color-mix(in oklab, var(--foreground) 55%, transparent));
    transition: width 0.12s linear;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
    transition: color var(--transition-base);
  }

  .back-link:hover { color: var(--foreground); }

  .post-header { margin-bottom: 2.5rem; }
  .post-header h1 { margin: 0 0 1rem; }

  .post-header .summary {
    margin: 0 0 1rem;
    color: color-mix(in oklab, var(--muted-foreground) 85%, transparent);
    line-height: 1.8;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-foreground);
  }

  .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .toc-card {
    border: 1px solid color-mix(in oklab, var(--border) 82%, transparent);
    border-radius: 1rem;
    padding: 1rem 0.9rem;
    background: color-mix(in oklab, white 82%, var(--muted) 18%);
    box-shadow: 0 10px 30px color-mix(in oklab, black 6%, transparent);
  }

  .toc-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }

  .toc-title,
  .reading-progress-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-foreground);
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-height: calc(100vh - 10rem);
    overflow: auto;
    padding-right: 0.15rem;
  }

  .toc-link {
    display: block;
    padding: 0.45rem 0.65rem;
    border-radius: 0.65rem;
    color: var(--muted-foreground);
    line-height: 1.5;
    transition: background-color var(--transition-base), color var(--transition-base), transform var(--transition-base);
  }

  .toc-link:hover {
    color: var(--foreground);
    background: color-mix(in oklab, var(--muted) 86%, white);
  }

  .toc-link.active {
    color: var(--foreground);
    background: color-mix(in oklab, var(--foreground) 10%, white);
    transform: translateX(2px);
  }

  .toc-level-1 { padding-left: 0.65rem; }
  .toc-level-2 { padding-left: 0.95rem; }
  .toc-level-3 { padding-left: 1.25rem; font-size: 0.95em; }
  .toc-level-4 { padding-left: 1.55rem; font-size: 0.92em; }
  .toc-empty { color: var(--muted-foreground); font-size: 0.9rem; }

  .content p, .content li {
    line-height: 1.9;
    color: var(--foreground);
  }

  .content p { margin: 0 0 1rem; }
  .content h1,.content h2,.content h3,.content h4 {
    margin: 1.8rem 0 0.8rem;
    scroll-margin-top: 6rem;
  }
  .content ul,.content ol { padding-left: 1.2rem; margin: 0.6rem 0 1rem; }
  .content blockquote {
    margin: 1rem 0;
    padding: 0.6rem 0.9rem;
    border-left: 3px solid color-mix(in oklab, var(--foreground) 22%, transparent);
    background: color-mix(in oklab, var(--muted) 90%, white);
  }
  .content figure {
    margin: 1.25rem auto;
    text-align: center;
  }
  .content img {
    display: block;
    max-width: min(100%, 760px);
    height: auto;
    border-radius: 0.45rem;
    margin: 0.8rem auto;
  }
  .content p > img,
  .content figure > img {
    margin-left: auto;
    margin-right: auto;
  }
  .content figcaption {
    margin-top: 0.45rem;
    color: var(--muted-foreground);
    font-size: 0.88rem;
    text-align: center;
  }
  .content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.92rem;
  }
  .content th,.content td {
    border: 1px solid color-mix(in oklab, var(--border) 85%, transparent);
    padding: 0.5rem 0.6rem;
    vertical-align: top;
  }
  .content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: color-mix(in oklab, var(--muted) 92%, white);
    padding: 0.1em 0.3em;
    border-radius: 0.25rem;
  }
  .content pre {
    overflow-x: auto;
    padding: 0.8rem;
    border-radius: 0.45rem;
    background: color-mix(in oklab, var(--muted) 94%, white);
  }
  .content pre code { background: transparent; padding: 0; }

  .back-to-top {
    position: fixed;
    right: max(1.2rem, calc((100vw - 1200px) / 2 + 1.2rem));
    bottom: 2rem;
    width: 2.8rem;
    height: 2.8rem;
    border: 1px solid color-mix(in oklab, var(--border) 82%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, white 86%, var(--muted) 14%);
    color: var(--foreground);
    box-shadow: 0 10px 30px color-mix(in oklab, black 8%, transparent);
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity var(--transition-base), transform var(--transition-base), background-color var(--transition-base);
    z-index: 55;
  }

  .back-to-top.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top:hover {
    background: color-mix(in oklab, var(--muted) 82%, white);
  }

  @media (max-width: 1080px) {
    .post-shell {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-sidebar {
      position: static;
      order: -1;
      margin-bottom: 1.25rem;
    }

    .toc-nav {
      max-height: none;
    }

    .back-to-top {
      right: 1rem;
      bottom: 1.25rem;
    }
  }
</style>
