---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}
---

<BaseLayout title={post.title} description={post.summary || `${post.title} - longBlog`}>
  <a href="/blog" class="back-link">← 返回文章列表</a>

  <header class="post-header">
    <h1>{post.title}</h1>
    {post.summary && <p class="summary">{post.summary}</p>}

    <div class="meta">
      <time>创建：{formatDate(post.date)}</time>
      <time>更新：{formatDate(post.updatedAt)}</time>
      <div class="tags">
        {post.tags.map((tag) => <span>#{tag}</span>)}
      </div>
    </div>
  </header>

  <article class="content" set:html={post.contentHtml}></article>
</BaseLayout>

<style is:global>
  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
    transition: color var(--transition-base);
  }

  .back-link:hover { color: var(--foreground); }

  .post-header { margin-bottom: 2.5rem; }

  .post-header h1 { margin: 0 0 1rem; }

  .post-header .summary {
    margin: 0 0 1rem;
    color: color-mix(in oklab, var(--muted-foreground) 85%, transparent);
    line-height: 1.8;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-foreground);
  }

  .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .content p, .content li {
    line-height: 1.9;
    color: var(--foreground);
  }

  .content p { margin: 0 0 1rem; }
  .content h1,.content h2,.content h3,.content h4 { margin: 1.5rem 0 0.8rem; }
  .content ul,.content ol { padding-left: 1.2rem; margin: 0.6rem 0 1rem; }
  .content blockquote {
    margin: 1rem 0;
    padding: 0.6rem 0.9rem;
    border-left: 3px solid color-mix(in oklab, var(--foreground) 22%, transparent);
    background: color-mix(in oklab, var(--muted) 90%, white);
  }
  .content img {
    max-width: min(100%, 760px);
    height: auto;
    border-radius: 0.45rem;
    margin: 0.8rem 0;
  }
  .content figure { margin: 1rem 0; }
  .content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.92rem;
  }
  .content th,.content td {
    border: 1px solid color-mix(in oklab, var(--border) 85%, transparent);
    padding: 0.5rem 0.6rem;
    vertical-align: top;
  }
  .content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: color-mix(in oklab, var(--muted) 92%, white);
    padding: 0.1em 0.3em;
    border-radius: 0.25rem;
  }
  .content pre {
    overflow-x: auto;
    padding: 0.8rem;
    border-radius: 0.45rem;
    background: color-mix(in oklab, var(--muted) 94%, white);
  }
  .content pre code { background: transparent; padding: 0; }
</style>
