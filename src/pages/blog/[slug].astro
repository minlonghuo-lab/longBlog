---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}
---

<BaseLayout title={post.title} description={post.summary || `${post.title} - longBlog`}>
  <div class="reading-progress" aria-hidden="true">
    <div id="reading-progress-bar" class="reading-progress-bar"></div>
  </div>

  <div class="post-page-wrap">
    <div class="post-reading-stage">
      <aside id="post-sidebar" class="post-sidebar" aria-label="文章目录侧栏">
        <button id="desktop-toc-toggle" class="desktop-toc-toggle" type="button" aria-expanded="true" aria-label="收起文章导航">⇥</button>
        <div class="toc-card toc-card-desktop">
          <div class="toc-title-row">
            <span class="toc-title">文章导航</span>
            <span id="reading-progress-text" class="reading-progress-text">0%</span>
          </div>
          <nav id="post-toc-desktop" class="toc-nav" aria-label="文章目录"></nav>
        </div>
      </aside>

      <article class="post-paper">
        <a href="/blog" class="back-link">← 返回文章列表</a>

        <header class="post-header" id="post-top">
          <h1>{post.title}</h1>
          {post.summary && <p class="summary">{post.summary}</p>}

          <div class="meta">
            <time>创建：{formatDate(post.date)}</time>
            <time>更新：{formatDate(post.updatedAt)}</time>
            <div class="tags">
              {post.tags.map((tag) => <span>#{tag}</span>)}
            </div>
          </div>
        </header>

        <section id="post-content" class="content" set:html={post.contentHtml}></section>
      </article>
    </div>
  </div>

  <button id="back-to-top" class="back-to-top" type="button" aria-label="回到顶部" title="回到顶部">↑</button>

  <button id="mobile-toc-trigger" class="mobile-toc-trigger" type="button" aria-label="打开文章导航">
    <span>目录</span>
    <span id="reading-progress-text-mobile" class="mobile-toc-progress">0%</span>
  </button>

  <div id="mobile-toc-sheet" class="mobile-toc-sheet" aria-hidden="true">
    <div id="mobile-toc-backdrop" class="mobile-toc-backdrop"></div>
    <div class="mobile-toc-panel" role="dialog" aria-modal="true" aria-label="文章导航">
      <div class="mobile-toc-header">
        <span>文章导航</span>
        <button id="mobile-toc-close" type="button" aria-label="关闭目录">✕</button>
      </div>
      <nav id="post-toc-mobile" class="toc-nav toc-nav-mobile" aria-label="移动端文章目录"></nav>
    </div>
  </div>

  <div id="image-lightbox" class="image-lightbox" aria-hidden="true">
    <button id="image-lightbox-close" class="image-lightbox-close" type="button" aria-label="关闭预览">✕</button>
    <img id="image-lightbox-img" src="" alt="文章图片预览" />
  </div>

  <script>
    (() => {
      const content = document.getElementById('post-content');
      const desktopToc = document.getElementById('post-toc-desktop');
      const mobileToc = document.getElementById('post-toc-mobile');
      const progressBar = document.getElementById('reading-progress-bar');
      const progressText = document.getElementById('reading-progress-text');
      const progressTextMobile = document.getElementById('reading-progress-text-mobile');
      const backToTop = document.getElementById('back-to-top');
      const mobileTocSheet = document.getElementById('mobile-toc-sheet');
      const mobileTocTrigger = document.getElementById('mobile-toc-trigger');
      const mobileTocClose = document.getElementById('mobile-toc-close');
      const mobileTocBackdrop = document.getElementById('mobile-toc-backdrop');
      const desktopTocToggle = document.getElementById('desktop-toc-toggle');
      const postSidebar = document.getElementById('post-sidebar');
      const lightbox = document.getElementById('image-lightbox');
      const lightboxImg = document.getElementById('image-lightbox-img');
      const lightboxClose = document.getElementById('image-lightbox-close');
      if (!(content instanceof HTMLElement) || !(desktopToc instanceof HTMLElement) || !(mobileToc instanceof HTMLElement)) return;

      const slugifyHeading = (text, index) => {
        const base = (text || `section-${index + 1}`)
          .trim()
          .toLowerCase()
          .replace(/[^\w\u4e00-\u9fff\-\s]/g, '')
          .replace(/\s+/g, '-');
        return base || `section-${index + 1}`;
      };

      const headings = Array.from(content.querySelectorAll('h1, h2, h3, h4'));
      const usedIds = new Set();
      const tocItems = headings.map((heading, index) => {
        let id = heading.id || slugifyHeading(heading.textContent || '', index);
        while (usedIds.has(id)) id = `${id}-${index + 1}`;
        usedIds.add(id);
        heading.id = id;
        return {
          id,
          text: (heading.textContent || '').trim() || `章节 ${index + 1}`,
          level: Number(heading.tagName.slice(1)),
          el: heading,
        };
      });

      const tocHTML = tocItems.length
        ? tocItems
            .map(
              (item) => `<a href="#${item.id}" class="toc-link toc-level-${item.level}" data-target="${item.id}"><span class="toc-link-text">${item.text}</span></a>`
            )
            .join('')
        : '<span class="toc-empty">本文暂无可导航标题</span>';

      desktopToc.innerHTML = tocHTML;
      mobileToc.innerHTML = tocHTML;

      const desktopTocLinks = Array.from(desktopToc.querySelectorAll('.toc-link'));
      const allTocLinks = () => Array.from(document.querySelectorAll('.toc-link'));

      const updateReadingProgress = () => {
        const articleHeight = content.scrollHeight;
        const viewportHeight = window.innerHeight;
        const start = content.offsetTop;
        const max = Math.max(articleHeight - viewportHeight, 1);
        const scrolled = Math.min(Math.max(window.scrollY - start, 0), max);
        const percent = Math.max(0, Math.min(100, Math.round((scrolled / max) * 100)));
        if (progressBar) progressBar.style.width = `${percent}%`;
        if (progressText) progressText.textContent = `${percent}%`;
        if (progressTextMobile) progressTextMobile.textContent = `${percent}%`;
        if (backToTop) backToTop.classList.toggle('visible', window.scrollY > start + 260);
      };

      const updateActiveHeading = () => {
        const tocLinks = allTocLinks();
        if (!tocLinks.length || !tocItems.length) return;

        const articleRect = content.getBoundingClientRect();
        const reachedBottom = articleRect.bottom - window.innerHeight <= 24;
        let currentId = tocItems[0]?.id;

        if (reachedBottom) {
          currentId = tocItems[tocItems.length - 1]?.id;
        } else {
          for (const item of tocItems) {
            if (item.el.getBoundingClientRect().top <= 150) currentId = item.id;
          }
        }

        tocLinks.forEach((link) => {
          const matched = link.dataset.target === currentId;
          link.classList.toggle('active', matched);
        });
      };

      const setDesktopTocCollapsed = (collapsed) => {
        if (!(postSidebar instanceof HTMLElement) || !(desktopTocToggle instanceof HTMLButtonElement)) return;
        postSidebar.classList.toggle('collapsed', collapsed);
        desktopTocToggle.setAttribute('aria-expanded', String(!collapsed));
        desktopTocToggle.setAttribute('aria-label', collapsed ? '展开文章导航' : '收起文章导航');
        desktopTocToggle.textContent = collapsed ? '⇤' : '⇥';
      };

      const openMobileToc = () => {
        if (!(mobileTocSheet instanceof HTMLElement)) return;
        mobileTocSheet.classList.add('open');
        mobileTocSheet.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };

      const closeMobileToc = () => {
        if (!(mobileTocSheet instanceof HTMLElement)) return;
        mobileTocSheet.classList.remove('open');
        mobileTocSheet.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };

      const openLightbox = (src, alt = '') => {
        if (!(lightbox instanceof HTMLElement) || !(lightboxImg instanceof HTMLImageElement)) return;
        lightboxImg.src = src;
        lightboxImg.alt = alt || '文章图片预览';
        lightbox.classList.add('open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };

      const closeLightbox = () => {
        if (!(lightbox instanceof HTMLElement) || !(lightboxImg instanceof HTMLImageElement)) return;
        lightbox.classList.remove('open');
        lightbox.setAttribute('aria-hidden', 'true');
        lightboxImg.src = '';
        document.body.style.overflow = mobileTocSheet?.classList.contains('open') ? 'hidden' : '';
      };

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        const link = target.closest('.toc-link');
        if (link instanceof HTMLAnchorElement) {
          event.preventDefault();
          const id = link.dataset.target;
          const heading = id ? document.getElementById(id) : null;
          if (!heading) return;
          const top = heading.getBoundingClientRect().top + window.scrollY - 96;
          window.scrollTo({ top, behavior: 'smooth' });
          if (window.innerWidth < 1080) closeMobileToc();
          return;
        }

        const image = target.closest('#post-content img');
        if (image instanceof HTMLImageElement) {
          openLightbox(image.currentSrc || image.src, image.alt || '文章图片预览');
        }
      });

      desktopTocToggle?.addEventListener('click', () => {
        if (!(postSidebar instanceof HTMLElement)) return;
        setDesktopTocCollapsed(!postSidebar.classList.contains('collapsed'));
      });

      mobileTocTrigger?.addEventListener('click', openMobileToc);
      mobileTocClose?.addEventListener('click', closeMobileToc);
      mobileTocBackdrop?.addEventListener('click', closeMobileToc);
      backToTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      lightboxClose?.addEventListener('click', closeLightbox);
      lightbox?.addEventListener('click', (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMobileToc();
          closeLightbox();
        }
      });

      const onScroll = () => {
        updateReadingProgress();
        updateActiveHeading();
      };

      setDesktopTocCollapsed(false);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    })();
  </script>
</BaseLayout>

<style is:global>
  .post-page-wrap {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    display: flex;
    justify-content: center;
  }

  .post-reading-stage {
    position: relative;
    width: 100%;
    max-width: 100%;
  }

  .post-paper {
    position: relative;
    width: min(60rem, calc(100vw - (2 * clamp(1.25rem, 8vw, 15rem))));
    max-width: calc(100vw - 2rem);
    margin: 0 auto;
    padding: clamp(1.6rem, 3vw, 2.4rem) clamp(1.35rem, 2.8vw, 2.35rem) clamp(2.2rem, 4vw, 3.2rem);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.98), rgba(250,250,249,0.96)),
      repeating-linear-gradient(180deg, rgba(17,17,17,0.02) 0, rgba(17,17,17,0.02) 1px, transparent 1px, transparent 28px);
    border: 1px solid color-mix(in oklab, var(--border) 88%, white);
    border-radius: 1.4rem;
    box-shadow:
      0 30px 80px rgba(15, 23, 42, 0.06),
      0 8px 24px rgba(15, 23, 42, 0.04),
      inset 0 1px 0 rgba(255,255,255,0.92);
  }

  .post-paper::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.65);
  }

  html[data-theme='dark'] .post-paper {
    background:
      linear-gradient(180deg, rgba(23, 28, 40, 0.96), rgba(19, 23, 34, 0.95)),
      repeating-linear-gradient(180deg, rgba(255,255,255,0.018) 0, rgba(255,255,255,0.018) 1px, transparent 1px, transparent 28px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 28px 72px rgba(0, 0, 0, 0.34),
      0 8px 24px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255,255,255,0.05);
  }

  html[data-theme='dark'] .post-paper::before {
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.03);
  }

  .post-sidebar {
    position: fixed;
    top: 10.5rem;
    right: max(1.5rem, calc((100vw - 1460px) / 2 + 1.5rem));
    width: clamp(14.5rem, 16vw, 16.5rem);
    z-index: 30;
    transition: right var(--transition-base), width var(--transition-base), transform var(--transition-base);
  }

  .post-sidebar.collapsed {
    width: 2.8rem;
  }

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }

  .reading-progress-bar {
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, rgba(17, 17, 17, 0.95), rgba(17, 17, 17, 0.35));
    transition: width 0.12s linear;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2.3rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-foreground);
    transition: color var(--transition-base);
  }

  .back-link:hover { color: var(--foreground); }

  .post-header {
    margin-bottom: 2.75rem;
    text-align: left;
  }

  .post-header h1 {
    max-width: 100%;
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 5vw, 4.1rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    text-align: left;
    text-wrap: pretty;
    overflow-wrap: anywhere;
    word-break: normal;
    hyphens: auto;
  }

  .post-header .summary {
    max-width: 100%;
    margin: 0 auto 1.25rem;
    padding: 1rem 1.15rem;
    border: 1px solid color-mix(in oklab, var(--border) 78%, transparent);
    border-radius: 0.9rem;
    color: color-mix(in oklab, var(--muted-foreground) 88%, transparent);
    line-height: 1.95;
    font-size: clamp(0.96rem, 1.2vw, 1.02rem);
    font-weight: 300;
    text-align: justify;
    text-justify: inter-ideograph;
    text-indent: 2em;
    background: color-mix(in oklab, white 92%, var(--muted) 8%);
    box-sizing: border-box;
  }

  html[data-theme='dark'] .post-header .summary {
    border-color: rgba(255, 255, 255, 0.1);
    color: rgba(223, 229, 239, 0.82);
    background: linear-gradient(180deg, rgba(34, 40, 56, 0.94), rgba(29, 34, 48, 0.9));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted-foreground);
  }

  .tags {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .toc-card {
    position: sticky;
    top: 6.25rem;
    border: 1px solid color-mix(in oklab, var(--border) 86%, transparent);
    border-radius: 1rem;
    padding: 0.95rem 0.8rem;
    background: color-mix(in oklab, white 92%, var(--muted) 8%);
    box-shadow: 0 12px 32px color-mix(in oklab, black 5%, transparent);
  }

  html[data-theme='dark'] .toc-card {
    border-color: rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(28, 33, 46, 0.96), rgba(23, 28, 40, 0.94));
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.26);
  }

  .desktop-toc-toggle {
    position: absolute;
    top: 0.25rem;
    left: -2.8rem;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid color-mix(in oklab, var(--border) 82%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, white 94%, var(--muted) 6%);
    color: var(--muted-foreground);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
    transition: color var(--transition-base), background-color var(--transition-base), transform var(--transition-base), opacity var(--transition-base);
  }

  html[data-theme='dark'] .desktop-toc-toggle {
    border-color: rgba(255, 255, 255, 0.08);
    background: rgba(31, 37, 51, 0.96);
    color: rgba(214, 221, 232, 0.82);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
  }

  .desktop-toc-toggle:hover {
    color: var(--foreground);
    transform: translateX(-1px);
  }

  .post-sidebar.collapsed .toc-card {
    opacity: 0;
    transform: translateX(1rem);
    pointer-events: none;
  }

  .post-sidebar .toc-card {
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .toc-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
  }

  .toc-title,
  .reading-progress-text,
  .mobile-toc-progress {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted-foreground);
    letter-spacing: 0.02em;
  }

  .toc-nav {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.08rem;
    max-height: calc(100vh - 10rem);
    overflow: auto;
    padding-right: 0.1rem;
  }

  .toc-link {
    position: relative;
    display: block;
    padding: 0.38rem 0.55rem;
    border-radius: 0.7rem;
    color: var(--muted-foreground);
    line-height: 1.45;
    font-size: 0.84rem;
    transition: background-color var(--transition-base), color var(--transition-base);
  }

  .toc-link::before {
    content: '';
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 1px;
    background: color-mix(in oklab, var(--border) 88%, transparent);
    transition: background-color var(--transition-base), opacity var(--transition-base);
  }

  .toc-level-1::before {
    opacity: 0;
  }

  .toc-level-2::before {
    left: 0.78rem;
    opacity: 1;
  }

  .toc-level-3::before {
    left: 1.08rem;
    opacity: 1;
  }

  .toc-level-4::before {
    left: 1.36rem;
    opacity: 1;
  }

  .toc-link:hover {
    color: var(--foreground);
    background: color-mix(in oklab, var(--muted) 86%, white);
  }

  .toc-link.active {
    color: var(--foreground);
    background: color-mix(in oklab, var(--foreground) 8%, white);
  }

  .toc-link.active::before {
    background: color-mix(in oklab, var(--foreground) 24%, transparent);
  }

  html[data-theme='dark'] .toc-link {
    color: rgba(205, 213, 225, 0.72);
  }

  html[data-theme='dark'] .toc-link::before {
    background: rgba(255, 255, 255, 0.08);
  }

  html[data-theme='dark'] .toc-link:hover {
    color: rgba(245, 247, 251, 0.95);
    background: rgba(255, 255, 255, 0.06);
  }

  html[data-theme='dark'] .toc-link.active {
    color: rgba(255, 255, 255, 0.98);
    background: rgba(255, 255, 255, 0.1);
  }

  html[data-theme='dark'] .toc-link.active::before {
    background: rgba(255, 255, 255, 0.22);
  }

  .toc-level-1 { padding-left: 0.55rem; }
  .toc-level-2 { padding-left: 1.2rem; }
  .toc-level-3 { padding-left: 1.52rem; font-size: 0.8rem; }
  .toc-level-4 { padding-left: 1.82rem; font-size: 0.77rem; }
  .toc-empty { color: var(--muted-foreground); font-size: 0.88rem; }

  .content {
    max-width: 100%;
    margin: 0 auto;
  }

  .content p,
  .content li {
    line-height: 2;
    color: var(--foreground);
    font-size: 1rem;
  }

  .content p {
    margin: 0 0 1rem;
    text-align: justify;
    text-justify: inter-ideograph;
  }

  .content h1,
  .content h2,
  .content h3,
  .content h4 {
    margin: 2rem 0 0.85rem;
    scroll-margin-top: 6rem;
  }

  .content h2 {
    font-size: 1.55rem;
    line-height: 1.3;
  }

  .content h3 {
    font-size: 1.2rem;
    line-height: 1.45;
  }

  .content ul,
  .content ol {
    padding-left: 1.3rem;
    margin: 0.7rem 0 1rem;
  }

  .content blockquote {
    margin: 1rem 0;
    padding: 0.75rem 0.95rem;
    border-left: 3px solid color-mix(in oklab, var(--foreground) 22%, transparent);
    background: color-mix(in oklab, var(--muted) 90%, white);
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .content blockquote * {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .content a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .content figure {
    margin: 1.5rem auto;
    text-align: center;
  }

  .content img {
    display: block;
    max-width: min(100%, 760px);
    height: auto;
    border-radius: 0.55rem;
    margin: 0.9rem auto;
    cursor: zoom-in;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
  }

  .content img:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 34px rgba(15, 23, 42, 0.1);
  }

  .content p > img,
  .content figure > img {
    margin-left: auto;
    margin-right: auto;
  }

  .content figcaption {
    margin-top: 0.45rem;
    color: var(--muted-foreground);
    font-size: 0.88rem;
    text-align: center;
  }

  .content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.92rem;
    display: block;
    overflow-x: auto;
  }

  .content th,
  .content td {
    border: 1px solid color-mix(in oklab, var(--border) 85%, transparent);
    padding: 0.5rem 0.6rem;
    vertical-align: top;
    white-space: normal;
  }

  .content code,
  .content pre,
  .content td,
  .content th {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: color-mix(in oklab, var(--muted) 92%, white);
    padding: 0.1em 0.3em;
    border-radius: 0.25rem;
  }

  .content pre {
    overflow-x: auto;
    padding: 0.85rem;
    border-radius: 0.45rem;
