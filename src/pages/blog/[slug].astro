---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const optimizedContentHtml = post.contentHtml.replace(/<img\b([^>]*)>/gi, (_match, attributes) => {
  const clean = attributes
    .replace(/\sloading=(['"])[^'"]*\1/gi, '')
    .replace(/\sdecoding=(['"])[^'"]*\1/gi, '')
    .replace(/\sfetchpriority=(['"])[^'"]*\1/gi, '');
  return `<img${clean} decoding="async" loading="lazy" fetchpriority="low">`;
});

function formatDate(date: Date): string {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).replace(/\//g, '/');
}
---

<BaseLayout title={post.title} description={post.summary || `${post.title} - longBlog`}>
  <div class="reading-progress" aria-hidden="true">
    <div id="reading-progress-bar" class="reading-progress-bar"></div>
  </div>

  <div class="post-page-wrap">
    <div class="post-reading-stage">
      <aside id="post-sidebar" class="post-sidebar collapsed" aria-label="文章目录侧栏">
        <button id="desktop-toc-toggle" class="desktop-toc-tab" type="button" aria-expanded="false" aria-label="展开文章导航" title="展开目录">
          <svg class="toc-tab-list-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 6h9M8 12h9M8 18h9M5 6h.01M5 12h.01M5 18h.01" />
          </svg>
          <span id="reading-progress-text-tab" class="desktop-toc-progress">0%</span>
          <svg class="toc-tab-chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 6l6 6-6 6" />
          </svg>
        </button>
        <div class="toc-card toc-card-desktop" aria-hidden="true" inert>
          <div class="toc-title-row">
            <span class="toc-title">文章导航</span>
          </div>
          <nav id="post-toc-desktop" class="toc-nav" aria-label="文章目录"></nav>
        </div>
      </aside>

      <article class="post-paper">
        <a href="/blog" class="back-link">← 返回文章列表</a>

        <header class="post-header" id="post-top">
          <h1>{post.title}</h1>
          {post.summary && <p class="summary">{post.summary}</p>}

          <div class="meta">
            <time>发布：{formatDate(post.publishedAt)}</time>
            <time>更新：{formatDate(post.updatedAt)}</time>
            <div class="tags">
              {post.tags.map((tag) => <span>#{tag}</span>)}
            </div>
          </div>
        </header>

        <section id="post-content" class="content" set:html={optimizedContentHtml}></section>
      </article>
    </div>
  </div>

  <button id="back-to-top" class="back-to-top floating-action" type="button" aria-label="回到顶部" title="回到顶部">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
  </button>

  <button id="mobile-toc-trigger" class="mobile-toc-trigger floating-action" type="button" aria-label="打开文章导航" title="打开目录">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h8M8 12h8M8 18h8" /></svg>
    <span id="reading-progress-text-mobile" class="mobile-toc-progress">0%</span>
  </button>

  <div id="mobile-toc-sheet" class="mobile-toc-sheet" aria-hidden="true">
    <div id="mobile-toc-backdrop" class="mobile-toc-backdrop"></div>
    <div class="mobile-toc-panel" role="dialog" aria-modal="true" aria-label="文章导航">
      <div class="mobile-toc-header">
        <span>文章导航</span>
        <button id="mobile-toc-close" type="button" aria-label="关闭目录">✕</button>
      </div>
      <nav id="post-toc-mobile" class="toc-nav toc-nav-mobile" aria-label="移动端文章目录"></nav>
    </div>
  </div>

  <div id="image-lightbox" class="image-lightbox" aria-hidden="true">
    <button id="image-lightbox-close" class="image-lightbox-close" type="button" aria-label="关闭预览">✕</button>
    <img id="image-lightbox-img" src="" alt="文章图片预览" />
  </div>

  <script data-astro-rerun>
    (() => {
      const content = document.getElementById('post-content');
      const desktopToc = document.getElementById('post-toc-desktop');
      const mobileToc = document.getElementById('post-toc-mobile');
      const progressBar = document.getElementById('reading-progress-bar');
      const progressText = document.getElementById('reading-progress-text');
      const progressTextMobile = document.getElementById('reading-progress-text-mobile');
      const progressTextTab = document.getElementById('reading-progress-text-tab');
      const backToTop = document.getElementById('back-to-top');
      const mobileTocSheet = document.getElementById('mobile-toc-sheet');
      const mobileTocTrigger = document.getElementById('mobile-toc-trigger');
      const mobileTocClose = document.getElementById('mobile-toc-close');
      const mobileTocBackdrop = document.getElementById('mobile-toc-backdrop');
      const desktopTocToggle = document.getElementById('desktop-toc-toggle');
      const postSidebar = document.getElementById('post-sidebar');
      const desktopTocCard = document.querySelector('.toc-card-desktop');
      const lightbox = document.getElementById('image-lightbox');
      const lightboxImg = document.getElementById('image-lightbox-img');
      const lightboxClose = document.getElementById('image-lightbox-close');
      const postPaper = document.querySelector('.post-paper');
      if (!(content instanceof HTMLElement) || !(desktopToc instanceof HTMLElement) || !(mobileToc instanceof HTMLElement)) return;

      const DESKTOP_TOC_STORAGE_KEY = 'LONG_BLOG_DESKTOP_TOC_STATE';
      let activeHeadingId = '';

      const slugifyHeading = (text, index) => {
        const base = (text || `section-${index + 1}`)
          .trim()
          .toLowerCase()
          .replace(/[^\w\u4e00-\u9fff\-\s]/g, '')
          .replace(/\s+/g, '-');
        return base || `section-${index + 1}`;
      };

      const headings = Array.from(content.querySelectorAll('h1, h2, h3, h4'));
      const usedIds = new Set();
      const tocItems = headings.map((heading, index) => {
        let id = heading.id || slugifyHeading(heading.textContent || '', index);
        while (usedIds.has(id)) id = `${id}-${index + 1}`;
        usedIds.add(id);
        heading.id = id;
        const level = Number(heading.tagName.slice(1));
        return {
          id,
          text: (heading.textContent || '').trim() || `章节 ${index + 1}`,
          level,
          depth: Math.max(0, level - 2),
          el: heading,
        };
      });

      const tocHTML = tocItems.length
        ? tocItems
            .map(
              (item) => `<a href="#${item.id}" class="toc-link toc-level-${item.level}" data-target="${item.id}" data-depth="${item.depth}"><span class="toc-link-text">${item.text}</span></a>`
            )
            .join('')
        : '<span class="toc-empty">本文暂无可导航标题</span>';

      desktopToc.innerHTML = tocHTML;
      mobileToc.innerHTML = tocHTML;

      const desktopTocLinks = Array.from(desktopToc.querySelectorAll('.toc-link'));
      const allTocLinks = () => Array.from(document.querySelectorAll('.toc-link'));

      const updateFloatingActions = () => {
        const articleHeight = content.scrollHeight;
        const viewportHeight = window.innerHeight;
        const start = content.offsetTop;
        const max = Math.max(articleHeight - viewportHeight, 1);
        const scrolled = Math.min(Math.max(window.scrollY - start, 0), max);
        const percent = Math.max(0, Math.min(100, Math.round((scrolled / max) * 100)));
        const isMobile = window.innerWidth < 1080;
        const shouldShowBackToTop = window.scrollY > start + 260;
        const isMobileTocOpen = mobileTocSheet instanceof HTMLElement ? mobileTocSheet.classList.contains('open') : false;
        const shouldHideBackToTopForMobileToc = isMobile && isMobileTocOpen;

        if (progressBar) progressBar.style.width = `${percent}%`;
        if (progressText) progressText.textContent = `${percent}%`;
        if (progressTextMobile) progressTextMobile.textContent = `${percent}%`;
        if (progressTextTab) progressTextTab.textContent = `${percent}%`;
        if (backToTop) backToTop.classList.toggle('visible', shouldShowBackToTop && !shouldHideBackToTopForMobileToc);

        if (postSidebar instanceof HTMLElement && postPaper instanceof HTMLElement) {
          const paperRect = postPaper.getBoundingClientRect();
          const shouldShowSidebar = window.innerWidth >= 1280 && paperRect.bottom > 220;
          postSidebar.classList.toggle('is-outside-article', !shouldShowSidebar);
        }
      };

      const updateActiveHeading = () => {
        const tocLinks = allTocLinks();
        if (!tocLinks.length || !tocItems.length) return;

        const articleRect = content.getBoundingClientRect();
        const reachedBottom = articleRect.bottom - window.innerHeight <= 24;
        let currentId = tocItems[0]?.id;

        if (reachedBottom) {
          currentId = tocItems[tocItems.length - 1]?.id;
        } else {
          for (const item of tocItems) {
            if (item.el.getBoundingClientRect().top <= 150) currentId = item.id;
          }
        }

        tocLinks.forEach((link) => {
          const matched = link.dataset.target === currentId;
          link.classList.toggle('active', matched);
          if (matched) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        });

        if (currentId && currentId !== activeHeadingId) {
          activeHeadingId = currentId;
          const activeDesktopLink = desktopToc.querySelector(`[data-target="${CSS.escape(currentId)}"]`);
          activeDesktopLink?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
      };

      const syncDesktopTocGeometry = () => {
        if (!(postSidebar instanceof HTMLElement) || !(postPaper instanceof HTMLElement)) return;
        const paperRect = postPaper.getBoundingClientRect();
        const paperDocumentTop = paperRect.top + window.scrollY;
        const gap = 8;
        const viewportPadding = 16;
        const collapsedWidth = 48;
        const availableWidth = window.innerWidth - paperRect.right - gap - viewportPadding;
        const drawerWidth = Math.max(collapsedWidth, Math.min(264, availableWidth));
        const openHeight = Math.max(260, Math.min(512, window.innerHeight - paperDocumentTop - 32));

        postSidebar.style.setProperty('--toc-anchor-left', `${Math.round(paperRect.right + gap)}px`);
        postSidebar.style.setProperty('--toc-anchor-top', `${Math.round(paperDocumentTop)}px`);
        postSidebar.style.setProperty('--toc-drawer-width', `${Math.round(drawerWidth)}px`);
        postSidebar.style.setProperty('--toc-panel-height', `${Math.round(openHeight)}px`);
        postSidebar.classList.add('is-ready');
      };

      const setDesktopTocCollapsed = (collapsed, persist = true) => {
        if (!(postSidebar instanceof HTMLElement) || !(desktopTocToggle instanceof HTMLButtonElement)) return;
        postSidebar.classList.toggle('collapsed', collapsed);
        if (desktopTocCard instanceof HTMLElement) {
          desktopTocCard.inert = collapsed;
          desktopTocCard.setAttribute('aria-hidden', String(collapsed));
        }
        desktopTocToggle.setAttribute('aria-expanded', String(!collapsed));
        desktopTocToggle.setAttribute('aria-label', collapsed ? '展开文章导航' : '收起文章导航');
        desktopTocToggle.title = collapsed ? '展开目录' : '收起目录';
        if (persist) {
          try {
            localStorage.setItem(DESKTOP_TOC_STORAGE_KEY, collapsed ? 'collapsed' : 'open');
          } catch {}
        }
      };

      const getInitialDesktopTocCollapsed = () => {
        try {
          return localStorage.getItem(DESKTOP_TOC_STORAGE_KEY) !== 'open';
        } catch {
          return true;
        }
      };

      const openMobileToc = () => {
        if (!(mobileTocSheet instanceof HTMLElement)) return;
        mobileTocSheet.classList.add('open');
        mobileTocSheet.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        updateFloatingActions();
      };

      const closeMobileToc = () => {
        if (!(mobileTocSheet instanceof HTMLElement)) return;
        mobileTocSheet.classList.remove('open');
        mobileTocSheet.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        updateFloatingActions();
      };

      const openLightbox = (src, alt = '') => {
        if (!(lightbox instanceof HTMLElement) || !(lightboxImg instanceof HTMLImageElement)) return;
        lightboxImg.src = src;
        lightboxImg.alt = alt || '文章图片预览';
        lightbox.classList.add('open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.classList.add('lightbox-open');
        document.body.style.overflow = 'hidden';
      };

      const closeLightbox = () => {
        if (!(lightbox instanceof HTMLElement) || !(lightboxImg instanceof HTMLImageElement)) return;
        lightbox.classList.remove('open');
        lightbox.setAttribute('aria-hidden', 'true');
        lightboxImg.src = '';
        document.body.classList.remove('lightbox-open');
        document.body.style.overflow = mobileTocSheet?.classList.contains('open') ? 'hidden' : '';
      };

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        const link = target.closest('.toc-link');
        if (link instanceof HTMLAnchorElement) {
          event.preventDefault();
          const id = link.dataset.target;
          const heading = id ? document.getElementById(id) : null;
          if (!heading) return;
          const top = heading.getBoundingClientRect().top + window.scrollY - 96;
          window.scrollTo({ top, behavior: 'smooth' });
          if (window.innerWidth < 1080) closeMobileToc();
          return;
        }

        const image = target.closest('#post-content img');
        if (image instanceof HTMLImageElement) {
          openLightbox(image.currentSrc || image.src, image.alt || '文章图片预览');
          return;
        }

        if (
          window.innerWidth >= 1280
          && postSidebar instanceof HTMLElement
          && !postSidebar.classList.contains('collapsed')
          && target.closest('.post-paper')
        ) {
          setDesktopTocCollapsed(true);
        }
      });

      desktopTocToggle?.addEventListener('click', () => {
        if (!(postSidebar instanceof HTMLElement)) return;
        setDesktopTocCollapsed(!postSidebar.classList.contains('collapsed'));
      });

      mobileTocTrigger?.addEventListener('click', openMobileToc);
      mobileTocClose?.addEventListener('click', closeMobileToc);
      mobileTocBackdrop?.addEventListener('click', closeMobileToc);
      const scrollToTop = (event) => {
        event?.preventDefault?.();
        event?.stopPropagation?.();
        event?.stopImmediatePropagation?.();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      };

      backToTop?.addEventListener('pointerdown', scrollToTop, { passive: false });
      backToTop?.addEventListener('mousedown', scrollToTop, { passive: false });
      backToTop?.addEventListener('click', scrollToTop, { passive: false });
      lightboxClose?.addEventListener('click', closeLightbox);
      lightbox?.addEventListener('click', (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMobileToc();
          closeLightbox();
          if (window.innerWidth >= 1280) setDesktopTocCollapsed(true);
        }
      });

      const onScroll = () => {
        updateFloatingActions();
        updateActiveHeading();
      };

      syncDesktopTocGeometry();
      setDesktopTocCollapsed(getInitialDesktopTocCollapsed(), false);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => {
        syncDesktopTocGeometry();
        onScroll();
      });
    })();
  </script>
</BaseLayout>

<style is:global>
  .post-page-wrap {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    display: flex;
    justify-content: center;
    position: static;
    isolation: auto;
  }

  .post-reading-stage {
    position: static;
    width: 100%;
    max-width: 100%;
  }

  .post-paper {
    position: relative;
    z-index: 2;
    width: min(60rem, calc(100vw - (2 * clamp(1.25rem, 8vw, 15rem))));
    max-width: calc(100vw - 2rem);
    margin: 0 auto;
    padding: clamp(1.6rem, 3vw, 2.4rem) clamp(1.35rem, 2.8vw, 2.35rem) clamp(2.2rem, 4vw, 3.2rem);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.98), rgba(250,250,249,0.96)),
      repeating-linear-gradient(180deg, rgba(17,17,17,0.02) 0, rgba(17,17,17,0.02) 1px, transparent 1px, transparent 28px);
    border: 1px solid color-mix(in oklab, var(--border) 88%, white);
    border-radius: 1.4rem;
    box-shadow:
      0 30px 80px rgba(15, 23, 42, 0.06),
      0 8px 24px rgba(15, 23, 42, 0.04),
      inset 0 1px 0 rgba(255,255,255,0.92);
  }

  .post-paper::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.65);
  }

  html[data-theme='dark'] .post-paper {
    background:
      linear-gradient(180deg, rgba(23, 28, 40, 0.96), rgba(19, 23, 34, 0.95)),
      repeating-linear-gradient(180deg, rgba(255,255,255,0.018) 0, rgba(255,255,255,0.018) 1px, transparent 1px, transparent 28px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 28px 72px rgba(0, 0, 0, 0.34),
      0 8px 24px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255,255,255,0.05);
  }

  html[data-theme='dark'] .post-paper::before {
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.03);
  }

  .post-sidebar {
    --toc-collapsed-width: 3rem;
    --toc-collapsed-height: 7rem;
    --toc-drawer-width: 16.5rem;
    --toc-panel-height: 32rem;
    position: fixed;
    top: var(--toc-anchor-top, 13rem);
    left: var(--toc-anchor-left, calc(50% + 31rem));
    width: var(--toc-drawer-width);
    height: var(--toc-panel-height);
    z-index: 3;
    pointer-events: auto;
    opacity: 0;
    transition:
      width 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.18s ease;
    will-change: width, height;
  }

  .post-sidebar.is-ready {
    opacity: 1;
  }

  .post-sidebar.collapsed {
    width: var(--toc-collapsed-width);
    height: var(--toc-collapsed-height);
  }

  .post-sidebar.is-outside-article {
    opacity: 0;
    pointer-events: none;
  }

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }

  .reading-progress-bar {
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, rgba(17, 17, 17, 0.95), rgba(17, 17, 17, 0.35));
    transition: width 0.12s linear;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2.3rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-foreground);
    transition: color var(--transition-base);
  }

  .back-link:hover { color: var(--foreground); }

  .post-header {
    margin-bottom: 2.75rem;
    text-align: left;
  }

  .post-header h1 {
    max-width: 100%;
    margin: 0 0 1.25rem;
    font-size: clamp(2.2rem, 5vw, 4.1rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    text-align: left;
    text-wrap: pretty;
    overflow-wrap: anywhere;
    word-break: normal;
    hyphens: auto;
  }

  .post-header .summary {
    max-width: 100%;
    margin: 0 auto 1.25rem;
    padding: 1rem 1.15rem;
    border: 1px solid color-mix(in oklab, var(--border) 78%, transparent);
    border-radius: 0.9rem;
    color: color-mix(in oklab, var(--muted-foreground) 88%, transparent);
    line-height: 1.95;
    font-size: clamp(0.96rem, 1.2vw, 1.02rem);
    font-weight: 300;
    text-align: justify;
    text-justify: inter-ideograph;
    text-indent: 2em;
    background: color-mix(in oklab, white 92%, var(--muted) 8%);
    box-sizing: border-box;
  }

  html[data-theme='dark'] .post-header .summary {
    border-color: rgba(255, 255, 255, 0.1);
    color: rgba(223, 229, 239, 0.82);
    background: linear-gradient(180deg, rgba(34, 40, 56, 0.94), rgba(29, 34, 48, 0.9));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted-foreground);
  }

  .tags {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .toc-card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    border: 1px solid color-mix(in oklab, var(--border) 86%, transparent);
    border-radius: 1rem;
    padding: 0.95rem 0.8rem 0.85rem;
    background: color-mix(in oklab, white 92%, var(--muted) 8%);
    box-shadow: 0 12px 32px color-mix(in oklab, black 5%, transparent);
    overflow: hidden;
    opacity: 1;
    transform: scale(1);
    transform-origin: top left;
    transition:
      opacity 0.16s ease 0.08s,
      transform 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear;
  }

  html[data-theme='dark'] .toc-card {
    border-color: rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(28, 33, 46, 0.96), rgba(23, 28, 40, 0.94));
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.26);
  }

  .floating-action {
    width: 2.55rem;
    height: 2.55rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in oklab, var(--border) 72%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, white 84%, transparent);
    color: color-mix(in oklab, var(--foreground) 76%, transparent);
    box-shadow: 0 8px 22px color-mix(in oklab, black 6%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: pointer;
    transition: color var(--transition-base), border-color var(--transition-base), background-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base), opacity var(--transition-base);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .floating-action svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .floating-action:hover {
    color: var(--foreground);
    border-color: color-mix(in oklab, var(--foreground) 16%, transparent);
    background: color-mix(in oklab, white 92%, var(--muted) 8%);
    box-shadow: 0 10px 26px color-mix(in oklab, black 8%, transparent);
    transform: translateY(-1px);
  }

  html[data-theme='dark'] .floating-action {
    border-color: rgba(255, 255, 255, 0.08);
    background: rgba(29, 34, 48, 0.76);
    color: rgba(244, 247, 251, 0.86);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.24);
  }

  html[data-theme='dark'] .floating-action:hover {
    background: rgba(39, 46, 63, 0.9);
