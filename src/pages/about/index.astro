---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_HISTORY_IMAGE_URL, TRILIUM_BASE_URL, TRILIUM_TREE_API_URL } from '../../consts';

const treeApiUrl = TRILIUM_TREE_API_URL || '';
const siteHistoryImageUrl = SITE_HISTORY_IMAGE_URL || '';
const triliumBaseUrl = TRILIUM_BASE_URL || 'https://blog.ssaw.top';
---

<BaseLayout title="关于" description="关于本站、知识体系与建站历史">
  <header class="page-header about-header">
    <div class="eyebrow">ABOUT</div>
    <h1>关于</h1>
    <p>这里放一些与站点本身有关的内容：一个是来自 TriliumNext 的知识地图，一个是记录折腾过程的建站历史。</p>
  </header>

  <section class="about-grid">
    <section class="about-card knowledge-card">
      <div class="card-head">
        <div>
          <div class="card-kicker">Knowledge Map</div>
          <h2>可见笔记知识地图</h2>
        </div>
        <a href={triliumBaseUrl} target="_blank" rel="noopener noreferrer" class="card-link">打开 Trilium ↗</a>
      </div>

      <p class="card-intro">
        展示 Trilium 中 <code>root</code> 下的可见笔记结构，并以可拖动、可缩放、可交互的图谱形式呈现。点击节点可展开下一层，双击节点可跳转到 Trilium 对应笔记。
      </p>

      <div class="tree-toolbar">
        <div class="tree-toolbar-info">
          <span class="dot"></span>
          <span id="tree-status">准备加载知识地图…</span>
        </div>
        <div class="tree-toolbar-actions">
          <button id="graph-fit" type="button">适配视图</button>
          <button id="graph-reset" type="button">重新加载</button>
        </div>
      </div>

      <div class="graph-shell">
        <div id="knowledge-tree-empty" class="placeholder" style="display:none;">
          <strong>还没有配置知识地图接口</strong>
          <p>请在部署环境中设置 <code>PUBLIC_TRILIUM_TREE_API_URL</code>，值建议指向你自己的服务端代理接口。</p>
        </div>
        <div id="knowledge-tree-error" class="placeholder" style="display:none;">
          <strong>知识地图加载失败</strong>
          <p>请检查代理接口是否可访问、返回格式是否正确，或确认 Trilium 端服务状态。</p>
        </div>
        <div id="knowledge-tree-loading" class="placeholder is-loading">
          <strong>正在连接知识地图…</strong>
          <p>首次加载可能会稍慢一点点。</p>
        </div>
        <div id="knowledge-graph" class="knowledge-graph" aria-label="Trilium 知识地图交互图" data-api-url={treeApiUrl} data-trilium-base-url={triliumBaseUrl}></div>
      </div>
    </section>

    <section class="about-card history-card">
      <div class="card-head">
        <div>
          <div class="card-kicker">Site History</div>
          <h2>建站历史</h2>
        </div>
        {siteHistoryImageUrl ? (
          <a href={siteHistoryImageUrl} target="_blank" rel="noopener noreferrer" class="card-link">查看原图 ↗</a>
        ) : (
          <span class="card-link disabled">等待配置</span>
        )}
      </div>

      <p class="card-intro">
        这里用于展示站点演进、迭代记录、版本截图或阶段性成果。你只需要在环境变量中填入建站历史图片外链，我会在这里以大图卡片的形式展示。
      </p>

      {siteHistoryImageUrl ? (
        <a href={siteHistoryImageUrl} target="_blank" rel="noopener noreferrer" class="history-image-link" aria-label="查看建站历史原图">
          <figure class="history-image-wrap">
            <img
              src={siteHistoryImageUrl}
              alt="建站历史时间线图片"
              loading="lazy"
              referrerpolicy="no-referrer"
              class="history-image"
            />
            <figcaption class="history-caption">点击可查看原图，适合放时间线、版本演进图、阶段截图拼图等内容。</figcaption>
          </figure>
        </a>
      ) : (
        <div class="placeholder history-placeholder">
          <strong>还没有配置建站历史图片</strong>
          <p>请在部署环境中设置 <code>PUBLIC_SITE_HISTORY_IMAGE_URL</code>，例如你图床中的时间线长图地址。</p>
        </div>
      )}
    </section>
  </section>
</BaseLayout>

<script>
  import { Network } from 'vis-network/standalone/esm/vis-network';
  import { DataSet } from 'vis-data/peer/esm/vis-data';

  const graphEl = document.getElementById('knowledge-graph');
  const loading = document.getElementById('knowledge-tree-loading');
  const empty = document.getElementById('knowledge-tree-empty');
  const error = document.getElementById('knowledge-tree-error');
  const status = document.getElementById('tree-status');
  const fitBtn = document.getElementById('graph-fit');
  const resetBtn = document.getElementById('graph-reset');

  if (graphEl instanceof HTMLElement) {
    const apiUrl = graphEl.dataset.apiUrl?.trim() || '';
    const triliumBaseUrl = graphEl.dataset.triliumBaseUrl?.trim() || 'https://blog.ssaw.top';
    const rootHint = 'root';
    const nodeStore = new Map();
    const loadedNodes = new Set();

    const nodes = new DataSet();
    const edges = new DataSet();

    const network = new Network(graphEl, { nodes, edges }, {
      autoResize: true,
      interaction: {
        hover: true,
        dragNodes: true,
        dragView: true,
        zoomView: true,
        navigationButtons: true,
        keyboard: true,
      },
      layout: { improvedLayout: true },
      physics: {
        enabled: true,
        stabilization: { iterations: 300, fit: true },
        barnesHut: {
          gravitationalConstant: -5000,
          springLength: 150,
          springConstant: 0.03,
          damping: 0.2,
          avoidOverlap: 0.4,
        },
      },
      nodes: { borderWidth: 0 },
      edges: { selectionWidth: 0 },
    });

    const setStatus = (text) => {
      if (status) status.textContent = text;
    };

    const show = (el, visible) => {
      if (el instanceof HTMLElement) el.style.display = visible ? '' : 'none';
    };

    const createUrl = (noteId) => {
      const url = new URL(apiUrl);
      url.searchParams.set('rootNoteId', noteId);
      return url.toString();
    };

    const normalizeNode = (node, depth = 0, parentId = '') => {
      if (!node || typeof node !== 'object') return null;
      const noteId = String(node.noteId || node.id || node.note_id || '');
      const title = String(node.title || node.name || node.noteTitle || noteId || '未命名笔记');
      const href = String(node.href || (noteId ? `${triliumBaseUrl}/#root/${noteId}` : triliumBaseUrl));
      const path = String(node.path || `/${title}`);
      const type = String(node.type || 'text');
      const childCount = Number(node.childCount || 0);
      const hasChildren = Boolean(node.hasChildren || childCount > 0);
      const loaded = Boolean(node.loaded);
      const prefix = node.prefix ? String(node.prefix) : '';
      const childrenRaw = Array.isArray(node.children) ? node.children : [];
      const children = childrenRaw.map((child) => normalizeNode(child, depth + 1, noteId)).filter(Boolean);
      return { noteId, title, href, path, type, childCount, hasChildren, loaded, prefix, depth, parentId, children };
    };

    const nodeColor = (node) => {
      if (node.type === 'noteMap') return '#ef4444';
      if (node.type === 'search') return '#f59e0b';
      if (node.hasChildren) return '#264f3a';
      return '#111827';
    };

    const upsertGraphNode = (node) => {
      nodeStore.set(node.noteId, node);
      const label = node.prefix ? `${node.prefix} · ${node.title}` : node.title;
      const payload = {
        id: node.noteId,
        label,
        title: `${node.path}${node.hasChildren ? `\n子节点：${node.childCount}` : ''}`,
        shape: 'dot',
        size: node.hasChildren ? 14 : 8,
        color: {
          background: nodeColor(node),
          border: nodeColor(node),
          highlight: { background: '#dc2626', border: '#dc2626' },
          hover: { background: '#0f172a', border: '#0f172a' },
        },
        font: { color: '#374151', size: node.hasChildren ? 16 : 11, face: 'Inter, system-ui, sans-serif', strokeWidth: 0 },
        physics: true,
      };
      if (nodes.get(node.noteId)) nodes.update(payload);
      else nodes.add(payload);
    };

    const edgeId = (from, to) => `${from}-->${to}`;
    const upsertEdge = (from, to) => {
      const id = edgeId(from, to);
      if (edges.get(id)) return;
      edges.add({ id, from, to, color: { color: 'rgba(148, 163, 184, 0.7)', highlight: '#94a3b8', hover: '#64748b' }, smooth: { type: 'dynamic' }, width: 1 });
    };

    const ingestNode = (node) => {
      upsertGraphNode(node);
      for (const child of node.children || []) {
        upsertGraphNode(child);
        upsertEdge(node.noteId, child.noteId);
      }
    };

    const loadChildren = async (noteId) => {
      const res = await fetch(createUrl(noteId), { headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const normalized = normalizeNode(data?.root, 0, '');
      if (!normalized) throw new Error('Invalid graph node response');
      return normalized;
    };

    const renderGraph = async (data) => {
      const root = normalizeNode(data?.root, 0, '');
      if (!root) {
        show(loading, false);
        show(error, true);
        setStatus('知识地图暂无可展示内容');
        return;
      }

      nodes.clear();
      edges.clear();
      nodeStore.clear();
      loadedNodes.clear();

      ingestNode(root);
      root.children.forEach((child) => {
        child.parentId = root.noteId;
        ingestNode(child);
      });
      loadedNodes.add(root.noteId);

      show(loading, false);
      graphEl.style.display = 'block';
      network.once('stabilizationIterationsDone', () => {
        network.fit({ animation: { duration: 400, easingFunction: 'easeInOutQuad' } });
      });
      network.stabilize(180);
      setStatus('知识地图已加载：展示 root 下可见笔记，支持拖动画布、滚轮缩放、点击节点展开、双击节点打开 Trilium');
    };

    network.on('doubleClick', (params) => {
      const noteId = params.nodes?.[0];
      if (!noteId) return;
      const node = nodeStore.get(String(noteId));
      if (node?.href) window.open(node.href, '_blank', 'noopener,noreferrer');
    });

    network.on('click', async (params) => {
      const noteId = params.nodes?.[0];
      if (!noteId) return;
      const currentNode = nodeStore.get(String(noteId));
      if (!currentNode?.hasChildren) return;
      if (loadedNodes.has(String(noteId))) return;

      setStatus(`正在加载「${currentNode.title}」的子节点…`);
      try {
        const loaded = await loadChildren(String(noteId));
        currentNode.loaded = true;
        currentNode.children = loaded.children || [];
        currentNode.childCount = loaded.childCount;
        ingestNode(currentNode);
        currentNode.children.forEach((child) => {
          child.parentId = currentNode.noteId;
          ingestNode(child);
        });
        loadedNodes.add(String(noteId));
        network.stabilize(120);
        setStatus(`已加载「${currentNode.title}」的 ${currentNode.children.length} 个子节点，双击节点可打开 Trilium`);
      } catch (err) {
        console.error('[about] graph children load failed', err);
        setStatus('图谱子节点加载失败，请稍后重试');
      }
    });

    fitBtn?.addEventListener('click', () => {
      network.fit({ animation: { duration: 400, easingFunction: 'easeInOutQuad' } });
      setStatus('已适配当前视图');
    });

    resetBtn?.addEventListener('click', async () => {
      if (!apiUrl) return;
      show(loading, true);
      show(error, false);
      try {
        const data = await fetch(createUrl(rootHint), { headers: { Accept: 'application/json' } }).then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json();
        });
        await renderGraph(data);
      } catch (err) {
        console.error('[about] graph reload failed', err);
        show(loading, false);
        show(error, true);
        setStatus('知识地图重新加载失败');
      }
    });

    if (!apiUrl) {
      show(loading, false);
      show(empty, true);
      setStatus('等待配置知识地图接口');
    } else {
      fetch(createUrl(rootHint), { headers: { Accept: 'application/json' } })
        .then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json();
        })
        .then((data) => {
          show(empty, false);
          show(error, false);
          return renderGraph(data);
        })
        .catch((err) => {
          console.error('[about] knowledge graph load failed', err);
          show(loading, false);
          show(error, true);
          setStatus('知识地图加载失败');
        });
    }
  }
</script>

<style>
  .about-header {
    padding-bottom: 2rem;
  }

  .eyebrow {
    margin-bottom: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    color: color-mix(in oklab, var(--muted-foreground) 55%, transparent);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.4rem;
  }

  @media (min-width: 1100px) {
    .about-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: start;
    }
  }

  .about-card {
    position: relative;
    padding: 1.3rem;
    border: 1px solid color-mix(in oklab, var(--border) 78%, transparent);
    border-radius: 1.35rem;
    background: linear-gradient(180deg, color-mix(in oklab, white 94%, var(--muted) 6%), color-mix(in oklab, white 98%, var(--muted) 2%));
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.04);
    overflow: hidden;
  }

  :global(html[data-theme='dark']) .about-card {
    background: linear-gradient(180deg, rgba(24, 29, 41, 0.96), rgba(18, 23, 34, 0.94));
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 22px 54px rgba(0, 0, 0, 0.18);
  }

  .card-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .card-head {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }

  .card-kicker {
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    color: color-mix(in oklab, var(--muted-foreground) 58%, transparent);
    text-transform: uppercase;
  }

  .card-head h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted-foreground);
    transition: color var(--transition-base);
    white-space: nowrap;
  }

  .card-link:hover {
    color: var(--foreground);
  }

  .card-link.disabled {
    opacity: 0.5;
    cursor: default;
  }

  .card-intro {
    margin: 0 0 1rem;
    color: var(--muted-foreground);
    line-height: 1.8;
  }

  .tree-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid color-mix(in oklab, var(--border) 75%, transparent);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--muted) 82%, white);
  }

  :global(html[data-theme='dark']) .tree-toolbar {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 640px) {
    .tree-toolbar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .tree-toolbar-info {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--muted-foreground);
    font-size: 0.92rem;
  }

  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #2dd4bf, #60a5fa);
    box-shadow: 0 0 0 5px color-mix(in oklab, #60a5fa 14%, transparent);
    flex-shrink: 0;
  }

  .tree-toolbar-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .tree-toolbar-actions button {
    border: 1px solid color-mix(in oklab, var(--border) 75%, transparent);
    border-radius: 999px;
    background: transparent;
    color: var(--foreground);
    padding: 0.45rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    transition: background-color var(--transition-base), border-color var(--transition-base), transform var(--transition-base);
  }

  .tree-toolbar-actions button:hover {
    transform: translateY(-1px);
    background: color-mix(in oklab, var(--muted) 76%, white);
    border-color: color-mix(in oklab, var(--foreground) 14%, transparent);
  }

  .graph-shell {
    position: relative;
    min-height: 30rem;
    padding: 0.75rem;
    border-radius: 1.15rem;
    border: 1px solid color-mix(in oklab, var(--border) 72%, transparent);
    background:
      radial-gradient(circle at top right, color-mix(in oklab, #93c5fd 14%, transparent), transparent 34%),
      linear-gradient(180deg, color-mix(in oklab, white 98%, var(--muted) 2%), color-mix(in oklab, var(--muted) 78%, white));
    overflow: hidden;
  }

  :global(html[data-theme='dark']) .graph-shell {
    border-color: rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(circle at top right, rgba(96, 165, 250, 0.12), transparent 34%),
      linear-gradient(180deg, rgba(16, 20, 30, 0.98), rgba(20, 24, 34, 0.95));
  }

  .placeholder {
    display: grid;
    place-items: center;
    min-height: 22rem;
    text-align: center;
    color: var(--muted-foreground);
    padding: 1rem;
  }

  .placeholder strong {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--foreground);
    font-family: var(--font-serif);
    font-size: 1.08rem;
  }

  .placeholder p {
    max-width: 30rem;
    margin: 0;
    line-height: 1.8;
  }

  .placeholder code {
    padding: 0.15rem 0.38rem;
    border-radius: 0.45rem;
    background: color-mix(in oklab, var(--muted) 78%, white);
    font-family: var(--font-mono);
    font-size: 0.8em;
  }

  .knowledge-graph {
    display: none;
    width: 100%;
    min-height: 28rem;
    height: 62vh;
    max-height: 46rem;
    border-radius: 0.95rem;
    background:
      radial-gradient(circle at center, rgba(255,255,255,0.7), rgba(255,255,255,0.15));
  }

  :global(html[data-theme='dark']) .knowledge-graph {
    background:
      radial-gradient(circle at center, rgba(17, 24, 39, 0.72), rgba(17, 24, 39, 0.18));
  }

  @media (max-width: 640px) {
    .knowledge-graph {
      height: 24rem;
      min-height: 24rem;
    }
  }

  .history-image-link {
    display: block;
  }

  .history-image-wrap {
    margin: 0;
    border-radius: 1.15rem;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--border) 78%, transparent);
    background: color-mix(in oklab, var(--muted) 84%, white);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .history-image-link:hover .history-image-wrap {
    transform: translateY(-2px);
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
    border-color: color-mix(in oklab, var(--foreground) 12%, transparent);
  }

  :global(html[data-theme='dark']) .history-image-wrap {
    border-color: rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }

  .history-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 58rem;
    object-fit: contain;
    background: color-mix(in oklab, var(--muted) 90%, white);
  }

  .history-caption {
    padding: 0.9rem 1rem 1rem;
    color: var(--muted-foreground);
    font-size: 0.9rem;
    line-height: 1.7;
    border-top: 1px solid color-mix(in oklab, var(--border) 75%, transparent);
  }

  .history-placeholder {
    min-height: 28rem;
    border: 1px dashed color-mix(in oklab, var(--border) 85%, transparent);
    border-radius: 1.15rem;
  }
</style>
