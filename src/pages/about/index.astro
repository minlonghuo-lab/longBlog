---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TRILIUM_BASE_URL, TRILIUM_TREE_API_URL } from '../../consts';

const treeApiUrl = TRILIUM_TREE_API_URL || '';
const triliumBaseUrl = TRILIUM_BASE_URL || 'https://blog.ssaw.top';
---

<BaseLayout title="关于" description="关于本站、知识体系与建站历史">
  <header class="page-header about-header">
    <h1>关于</h1>
    <p>这里展示的是我的知识结构与建站脉络。</p>
  </header>

  <section class="about-single">
    <section class="about-paper knowledge-card">
      <p class="card-intro">
        这张地图展示的是我 Trilium 中所有笔记，longBlog 仅为其中一条分支。你可以把它理解成我整个知识系统的一张总览图：支持拖动画布、滚轮缩放、点击节点展开下一层。
      </p>

      <div class="tree-toolbar">
        <div class="tree-toolbar-info">
          <span class="dot"></span>
          <span id="tree-status">正在准备这张知识地图…</span>
        </div>
        <div class="tree-toolbar-actions">
          <button id="graph-fit" type="button">回到全图</button>
          <button id="graph-reset" type="button">从根节点重载</button>
        </div>
      </div>

      <div class="graph-shell">
        <div id="knowledge-tree-empty" class="placeholder" style="display:none;">
          <strong>还没有配置知识地图接口</strong>
          <p>请在部署环境中设置 <code>PUBLIC_TRILIUM_TREE_API_URL</code>，值建议指向你自己的服务端代理接口。</p>
        </div>
        <div id="knowledge-tree-error" class="placeholder" style="display:none;">
          <strong>知识地图加载失败</strong>
          <p>请检查代理接口是否可访问、返回格式是否正确，或确认 Trilium 端服务状态。</p>
        </div>
        <div id="knowledge-tree-loading" class="placeholder is-loading">
          <p class="placeholder-copy">正在连接知识地图，首次加载可能会稍慢一点点。</p>
        </div>
        <div id="knowledge-graph" class="knowledge-graph" aria-label="Trilium 知识地图交互图" data-api-url={treeApiUrl} data-trilium-base-url={triliumBaseUrl}></div>
      </div>
    </section>
  </section>
</BaseLayout>

<script data-astro-rerun>
  import { Network } from 'vis-network/standalone';
  import { DataSet } from 'vis-data';

  const graphEl = document.getElementById('knowledge-graph');
  const loading = document.getElementById('knowledge-tree-loading');
  const empty = document.getElementById('knowledge-tree-empty');
  const error = document.getElementById('knowledge-tree-error');
  const status = document.getElementById('tree-status');
  const fitBtn = document.getElementById('graph-fit');
  const resetBtn = document.getElementById('graph-reset');

  if (graphEl instanceof HTMLElement) {
    const apiUrl = graphEl.dataset.apiUrl?.trim() || '';
    const triliumBaseUrl = graphEl.dataset.triliumBaseUrl?.trim() || 'https://blog.ssaw.top';
    const rootHint = 'root';
    const nodeStore = new Map();
    const loadedNodes = new Set();
    const loadingNodes = new Set();
    let isDragging = false;
    let dragEndAt = 0;
    let fitTimer = 0;
    let renderVersion = 0;

    const nodes = new DataSet();
    const edges = new DataSet();

    const network = new Network(graphEl, { nodes, edges }, {
      autoResize: true,
      interaction: {
        hover: true,
        dragNodes: true,
        dragView: true,
        zoomView: true,
        navigationButtons: true,
        keyboard: true,
        tooltipDelay: 120,
      },
      layout: { improvedLayout: true },
      physics: {
        enabled: true,
        stabilization: { iterations: 120, fit: false, updateInterval: 20 },
        barnesHut: {
          gravitationalConstant: -4200,
          springLength: 145,
          springConstant: 0.028,
          damping: 0.28,
          avoidOverlap: 0.55,
        },
      },
      nodes: { borderWidth: 0 },
      edges: { selectionWidth: 0 },
    });

    const LARGE_CHILDREN_THRESHOLD = 30;
    const HUGE_CHILDREN_THRESHOLD = 60;
    const CHUNK_SIZE = 12;
    const INITIAL_CHILD_LIMIT = 8;
    const LOAD_MORE_STEP = 8;
    const LOAD_MORE_PREFIX = '__load_more__:';

    const normalizeTitle = (value) => String(value || '').replace(/\s+/g, '').trim();

    const getLoadMoreNodeId = (parentId) => `${LOAD_MORE_PREFIX}${parentId}`;
    const isLoadMoreNodeId = (nodeId) => String(nodeId || '').startsWith(LOAD_MORE_PREFIX);
    const getParentIdFromLoadMore = (nodeId) => String(nodeId || '').slice(LOAD_MORE_PREFIX.length);

    const isBlogNode = (node) => {
      const title = normalizeTitle(node?.title);
      const path = normalizeTitle(node?.path);
      return title === '我的博客' || title.includes('博客') || path.includes('我的博客') || path.includes('/longBlog');
    };

    const setStatus = (text) => {
      if (status) status.textContent = text;
    };

    const show = (el, visible) => {
      if (el instanceof HTMLElement) el.style.display = visible ? '' : 'none';
    };

    const nextFrame = () => new Promise((resolve) => requestAnimationFrame(() => resolve(undefined)));

    const safeFit = (duration = 420) => {
      if (fitTimer) window.clearTimeout(fitTimer);
      fitTimer = window.setTimeout(() => {
        requestAnimationFrame(() => {
          network.fit({ animation: { duration, easingFunction: 'easeInOutQuad' } });
        });
      }, 60);
    };

    const safeStabilize = (iterations = 80) => {
      network.stopSimulation();
      network.stabilize(iterations);
    };

    const createUrl = (noteId) => {
      const url = new URL(apiUrl);
      url.searchParams.set('rootNoteId', noteId);
      return url.toString();
    };

    const normalizeNode = (node, depth = 0, parentId = '') => {
      if (!node || typeof node !== 'object') return null;
      const noteId = String(node.noteId || node.id || node.note_id || '');
      const title = String(node.title || node.name || node.noteTitle || noteId || '未命名笔记');
      const href = String(node.href || (noteId ? `${triliumBaseUrl}/#root/${noteId}` : triliumBaseUrl));
      const path = String(node.path || `/${title}`);
      const type = String(node.type || 'text');
      const childCount = Number(node.childCount || 0);
      const hasChildren = Boolean(node.hasChildren || childCount > 0);
      const loaded = Boolean(node.loaded);
      const prefix = node.prefix ? String(node.prefix) : '';
      const childrenRaw = Array.isArray(node.children) ? node.children : [];
      const children = childrenRaw.map((child) => normalizeNode(child, depth + 1, noteId)).filter(Boolean);
      return { noteId, title, href, path, type, childCount, hasChildren, loaded, prefix, depth, parentId, children };
    };

    const nodeColor = (node) => {
      if (node.type === 'noteMap') return '#ef4444';
      if (node.type === 'search') return '#f59e0b';
      if (node.hasChildren) return '#264f3a';
      return '#111827';
    };

    const upsertGraphNode = (node, options = {}) => {
      nodeStore.set(node.noteId, node);
      const label = node.prefix ? `${node.prefix} · ${node.title}` : node.title;
      const physicsEnabled = options.physics ?? true;
      const payload = {
        id: node.noteId,
        label,
        title: `${node.path}${node.hasChildren ? `\n子节点：${node.childCount}` : ''}`,
        shape: 'dot',
        size: node.hasChildren ? 14 : 8,
        color: {
          background: nodeColor(node),
          border: nodeColor(node),
          highlight: { background: '#dc2626', border: '#dc2626' },
          hover: { background: '#0f172a', border: '#0f172a' },
        },
        font: { color: '#374151', size: node.hasChildren ? 16 : 11, face: 'Inter, system-ui, sans-serif', strokeWidth: 0 },
        physics: physicsEnabled,
      };
      if (nodes.get(node.noteId)) nodes.update(payload);
      else nodes.add(payload);
    };

    const edgeId = (from, to) => `${from}-->${to}`;
    const removeLoadMoreNode = (parentId) => {
      const loadMoreId = getLoadMoreNodeId(parentId);
      if (nodes.get(loadMoreId)) {
        nodes.remove(loadMoreId);
      }
      const loadMoreEdgeId = edgeId(parentId, loadMoreId);
      if (edges.get(loadMoreEdgeId)) {
        edges.remove(loadMoreEdgeId);
      }
    };

    const upsertLoadMoreNode = (parentNode, remainingCount) => {
      if (!parentNode?.noteId) return;
      const loadMoreId = getLoadMoreNodeId(parentNode.noteId);
      if (remainingCount <= 0) {
        removeLoadMoreNode(parentNode.noteId);
        return;
      }
      const payload = {
        id: loadMoreId,
        label: `继续加载 ${remainingCount} 个子节点`,
        title: `${parentNode.title}\n还有 ${remainingCount} 个子节点未显示`,
        shape: 'box',
        margin: 10,
        borderWidth: 1,
        color: {
          background: 'rgba(255,255,255,0.92)',
          border: 'rgba(148, 163, 184, 0.72)',
          highlight: { background: '#eef2ff', border: '#6366f1' },
          hover: { background: '#f8fafc', border: '#64748b' },
        },
        font: { color: '#475569', size: 12, face: 'Inter, system-ui, sans-serif', strokeWidth: 0 },
        physics: false,
      };
      if (nodes.get(loadMoreId)) nodes.update(payload);
      else nodes.add(payload);
      upsertEdge(parentNode.noteId, loadMoreId);
    };

    const upsertEdge = (from, to) => {
      const id = edgeId(from, to);
      if (edges.get(id)) return;
      edges.add({ id, from, to, color: { color: 'rgba(148, 163, 184, 0.7)', highlight: '#94a3b8', hover: '#64748b' }, smooth: { type: 'dynamic' }, width: 1 });
    };

    const ingestNode = (node, options = {}) => {
      upsertGraphNode(node, options);
      for (const child of node.children || []) {
        upsertGraphNode(child, options);
        upsertEdge(node.noteId, child.noteId);
      }
    };

    const ingestChildrenInChunks = async (parentNode, children, options = {}) => {
      const chunkSize = Math.max(1, options.chunkSize || CHUNK_SIZE);
      const startIndex = Math.max(0, options.startIndex || 0);
      const endIndex = Math.min(children.length, options.endIndex ?? children.length);
      for (let index = startIndex; index < endIndex; index += chunkSize) {
        const batch = children.slice(index, Math.min(index + chunkSize, endIndex));
        for (const child of batch) {
          child.parentId = parentNode.noteId;
          upsertGraphNode(child, options);
          upsertEdge(parentNode.noteId, child.noteId);
        }
        if (endIndex - startIndex > chunkSize) {
          await nextFrame();
        }
      }
    };

    const loadChildren = async (noteId) => {
      const res = await fetch(createUrl(noteId), { headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const normalized = normalizeNode(data?.root, 0, '');
      if (!normalized) throw new Error('Invalid graph node response');
      return normalized;
    };

    const loadMoreChildren = async (parentId) => {
      const parentNode = nodeStore.get(String(parentId));
      if (!parentNode || !Array.isArray(parentNode.children) || !parentNode.children.length) {
        return { loadedCount: 0, remainingCount: 0 };
      }

      const currentOffset = Number(parentNode.loadedChildCount || 0);
      const nextOffset = Math.min(parentNode.children.length, currentOffset + LOAD_MORE_STEP);
      const chunkSize = CHUNK_SIZE;

      removeLoadMoreNode(parentNode.noteId);
      await ingestChildrenInChunks(parentNode, parentNode.children, {
        physics: false,
        chunkSize,
        startIndex: currentOffset,
        endIndex: nextOffset,
      });

      parentNode.loadedChildCount = nextOffset;
      const remainingCount = Math.max(0, parentNode.children.length - nextOffset);
      if (remainingCount > 0) {
        upsertLoadMoreNode(parentNode, remainingCount);
      }

      return { loadedCount: nextOffset, remainingCount };
    };

    const expandNode = async (noteId, version = renderVersion) => {
      const id = String(noteId);
      const currentNode = nodeStore.get(id);
      if (!currentNode?.hasChildren) return { node: currentNode, expanded: false, reason: 'no-children' };
      if (loadedNodes.has(id)) return { node: currentNode, expanded: false, reason: 'already-loaded', childCount: currentNode.children?.length || 0 };
      if (loadingNodes.has(id)) return { node: currentNode, expanded: false, reason: 'loading' };

      loadingNodes.add(id);
      try {
        const loaded = await loadChildren(id);
        if (version !== renderVersion) {
          return { node: currentNode, expanded: false, reason: 'stale-render' };
        }

        const childCount = Array.isArray(loaded.children) ? loaded.children.length : 0;
        const useIncrementalLoading = childCount >= LARGE_CHILDREN_THRESHOLD;
        const disableChildPhysics = childCount >= LARGE_CHILDREN_THRESHOLD;
        const stabilizeIterations = childCount >= HUGE_CHILDREN_THRESHOLD ? 12 : childCount >= LARGE_CHILDREN_THRESHOLD ? 16 : 70;
        const initialLimit = useIncrementalLoading ? Math.min(childCount, INITIAL_CHILD_LIMIT) : childCount;
        const chunkSize = useIncrementalLoading ? CHUNK_SIZE : 18;

        currentNode.loaded = true;
        currentNode.children = loaded.children || [];
        currentNode.childCount = loaded.childCount;
        currentNode.loadedChildCount = 0;
        upsertGraphNode(currentNode, { physics: true });

        try {
          await ingestChildrenInChunks(currentNode, currentNode.children, {
            physics: !disableChildPhysics,
            chunkSize,
            startIndex: 0,
            endIndex: initialLimit,
          });
        } catch (chunkError) {
          removeLoadMoreNode(currentNode.noteId);
          currentNode.loadedChildCount = 0;
          throw chunkError;
        }

        currentNode.loadedChildCount = initialLimit;
        const remainingCount = Math.max(0, childCount - initialLimit);
        if (useIncrementalLoading && remainingCount > 0) {
          upsertLoadMoreNode(currentNode, remainingCount);
        }

        loadedNodes.add(id);
        safeStabilize(stabilizeIterations);
        return {
          node: currentNode,
          expanded: true,
          reason: 'expanded',
          childCount,
          shownCount: initialLimit,
          remainingCount,
          degradedPhysics: disableChildPhysics,
        };
      } catch (error) {
        currentNode.loaded = false;
        currentNode.loadedChildCount = 0;
        removeLoadMoreNode(id);
        throw new Error(error instanceof Error ? error.message : String(error || 'expand failed'));
      } finally {
        loadingNodes.delete(id);
      }
    };

    const expandDefaultPath = async (version = renderVersion) => {
      const rootChildren = Array.from(nodeStore.values()).filter((node) => node.parentId === 'root');
      const blogNode = rootChildren.find((node) => isBlogNode(node));

      if (!blogNode) {
        safeFit(520);
        setStatus('知识地图已加载：未找到「我的博客」节点，当前展示全图。');
        return;
      }

      setStatus(`正在展开「${blogNode.title}」…`);
      try {
        const result = await expandNode(blogNode.noteId, version);
        if (version !== renderVersion) return;

        if (result?.expanded) {
          safeFit(520);
          setStatus(`已默认展开「${blogNode.title}」，并适配当前视图。`);
        } else {
          safeFit(520);
          setStatus(`已定位到「${blogNode.title}」，当前节点无需额外展开。`);
        }
      } catch (err) {
        console.error('[about] default blog path expand failed', err);
        safeFit(520);
        setStatus(`默认展开「${blogNode.title}」失败，已回退为全图视角。`);
      }
    };

    const renderGraph = async (data) => {
      renderVersion += 1;
      const currentVersion = renderVersion;
      const root = normalizeNode(data?.root, 0, '');
      if (!root) {
        show(loading, false);
        show(error, true);
        setStatus('知识地图暂无可展示内容');
        return;
      }

      nodes.clear();
      edges.clear();
      nodeStore.clear();
      loadedNodes.clear();
      loadingNodes.clear();

      ingestNode(root);
      root.children.forEach((child) => {
        child.parentId = root.noteId;
        ingestNode(child);
      });
      loadedNodes.add(root.noteId);

      show(loading, false);
      graphEl.style.display = 'block';
      requestAnimationFrame(() => {
        safeStabilize(90);
        safeFit(420);
      });
      setStatus('知识地图已加载：拖动画布、滚轮缩放，点击节点可继续展开。');
      await expandDefaultPath(currentVersion);
    };

    network.on('dragStart', () => {
      isDragging = true;
    });

    network.on('dragEnd', () => {
      dragEndAt = Date.now();
      window.setTimeout(() => {
        isDragging = false;
      }, 120);
    });

    network.on('click', async (params) => {
      if (isDragging || Date.now() - dragEndAt < 180) return;
      const noteId = params.nodes?.[0];
      if (!noteId) return;

      if (isLoadMoreNodeId(noteId)) {
        const parentId = getParentIdFromLoadMore(noteId);
        const parentNode = nodeStore.get(parentId);
        if (!parentNode) return;
        setStatus(`正在继续加载「${parentNode.title}」的更多子节点…`);
        try {
          const result = await loadMoreChildren(parentId);
          if (result.remainingCount > 0) {
            setStatus(`已继续加载「${parentNode.title}」的子节点，剩余 ${result.remainingCount} 个可继续展开`);
          } else {
            setStatus(`已完整展开「${parentNode.title}」的全部 ${result.loadedCount} 个子节点`);
          }
        } catch (err) {
          console.error('[about] graph load more failed', err);
          setStatus('继续加载子节点失败，请稍后重试');
        }
        return;
      }

      const currentNode = nodeStore.get(String(noteId));
      if (!currentNode?.hasChildren) return;
      if (loadedNodes.has(String(noteId))) return;

      setStatus(`正在加载「${currentNode.title}」的子节点…`);
      try {
        const result = await expandNode(String(noteId));
        if (result?.expanded) {
          if ((result.remainingCount || 0) > 0) {
            setStatus(`已先展开「${currentNode.title}」的前 ${result.shownCount} 个子节点，剩余 ${result.remainingCount} 个可继续加载`);
          } else if ((result.childCount || 0) >= LARGE_CHILDREN_THRESHOLD) {
            setStatus(`已展开「${currentNode.title}」的 ${result.childCount} 个子节点，并启用性能优化模式`);
          } else {
            setStatus(`已展开「${currentNode.title}」，继续点击其它节点可向下浏览`);
          }
        } else if (result?.reason === 'already-loaded') {
          setStatus(`「${currentNode.title}」已展开，可继续浏览其它节点`);
        } else {
          setStatus(`「${currentNode.title}」当前没有新的子节点可展开`);
        }
      } catch (err) {
        console.error('[about] graph children load failed', {
          noteId,
          title: currentNode.title,
          childCount: currentNode.childCount,
          err,
        });
        setStatus(`展开「${currentNode.title}」失败：节点较多，已自动降载；请再次点击继续尝试`);
      }
    });

    fitBtn?.addEventListener('click', () => {
      safeFit(420);
      setStatus('已适配当前视图');
    });

    resetBtn?.addEventListener('click', async () => {
      if (!apiUrl) return;
      show(loading, true);
      show(error, false);
      isDragging = false;
      dragEndAt = 0;
      loadingNodes.clear();
      try {
        const data = await fetch(createUrl(rootHint), { headers: { Accept: 'application/json' } }).then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json();
        });
        await renderGraph(data);
      } catch (err) {
        console.error('[about] graph reload failed', err);
        show(loading, false);
        show(error, true);
        setStatus('知识地图重新加载失败');
      }
    });

    if (!apiUrl) {
      show(loading, false);
      show(empty, true);
      setStatus('等待配置知识地图接口');
    } else {
      fetch(createUrl(rootHint), { headers: { Accept: 'application/json' } })
        .then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json();
        })
        .then((data) => {
          show(empty, false);
          show(error, false);
          return renderGraph(data);
        })
        .catch((err) => {
          console.error('[about] knowledge graph load failed', err);
          show(loading, false);
          show(error, true);
          setStatus('知识地图加载失败');
        });
    }
  }
</script>

<style>
  .about-header {
    padding-bottom: 1.25rem;
  }

  .eyebrow {
    margin-bottom: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    color: color-mix(in oklab, var(--muted-foreground) 55%, transparent);
  }

  .about-single {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    display: flex;
    justify-content: center;
  }

  .about-paper {
    position: relative;
    width: min(66rem, calc(100vw - (2 * clamp(1.25rem, 7vw, 12rem))));
    max-width: calc(100vw - 2rem);
    margin: 0 auto;
    padding: clamp(1.7rem, 3vw, 2.5rem) clamp(1.35rem, 2.8vw, 2.4rem) clamp(2.4rem, 4vw, 3.4rem);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.98), rgba(250,250,249,0.96)),
      repeating-linear-gradient(180deg, rgba(17,17,17,0.02) 0, rgba(17,17,17,0.02) 1px, transparent 1px, transparent 28px);
    border: 1px solid color-mix(in oklab, var(--border) 88%, white);
    border-radius: 1.4rem;
    box-shadow:
      0 30px 80px rgba(15, 23, 42, 0.06),
      0 8px 24px rgba(15, 23, 42, 0.04),
      inset 0 1px 0 rgba(255,255,255,0.92);
  }

  .about-paper::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.65);
  }

  :global(html[data-theme='dark']) .about-paper {
    background:
      linear-gradient(180deg, rgba(23, 28, 40, 0.96), rgba(19, 23, 34, 0.95)),
      repeating-linear-gradient(180deg, rgba(255,255,255,0.018) 0, rgba(255,255,255,0.018) 1px, transparent 1px, transparent 28px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 28px 72px rgba(0, 0, 0, 0.34),
      0 8px 24px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255,255,255,0.05);
  }

  :global(html[data-theme='dark']) .about-paper::before {
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.03);
  }

  .card-intro {
    margin: 0 0 1.2rem;
    color: var(--muted-foreground);
    line-height: 1.95;
    font-size: 0.98rem;
  }

  .tree-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin: 0 0 1.15rem;
    padding: 0.85rem 0 0.95rem;
    border-top: 1px solid color-mix(in oklab, var(--border) 65%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--border) 45%, transparent);
  }

  @media (min-width: 640px) {
    .tree-toolbar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .tree-toolbar-info {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
