---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MEMOS_URL } from '../../consts';

const memosApiBase = MEMOS_URL;
---

<BaseLayout title="说说" description="日常碎碎念">
  <header class="page-header">
    <h1>说说</h1>
    <p>日常碎碎念。</p>
  </header>

  <section class="memos-wrap">
    <div id="memos-list" class="memos-list"></div>

    <div id="memos-loading" class="memos-status">加载中...</div>
    <div id="memos-end" class="memos-status" style="display:none;">- END -</div>
    <div id="memos-empty" class="memos-status" style="display:none;">暂无内容</div>
    <div id="memos-error" class="memos-status" style="display:none;">加载失败，请稍后刷新重试</div>

    <div id="memos-sentinel" class="memos-sentinel"></div>
  </section>

  <div id="image-preview" class="image-preview" style="display:none;">
    <button id="preview-close" class="preview-close" aria-label="关闭">✕</button>
    <img id="preview-image" src="" alt="预览图" />
  </div>
</BaseLayout>

<script define:vars={{ memosApiBase }} data-astro-rerun>
  const listEl = document.getElementById('memos-list');
  const loadingEl = document.getElementById('memos-loading');
  const endEl = document.getElementById('memos-end');
  const emptyEl = document.getElementById('memos-empty');
  const errorEl = document.getElementById('memos-error');

  document.documentElement.classList.add('memos-page');
  document.body.classList.add('memos-page');
  const sentinelEl = document.getElementById('memos-sentinel');
  const previewEl = document.getElementById('image-preview');
  const previewImgEl = document.getElementById('preview-image');
  const closeBtn = document.getElementById('preview-close');

  let cursor = '';
  let offset = 0;
  let hasMore = true;
  let loading = false;
  const seen = new Set();
  const memoStore = new Map();

  const PAGE_SIZE = 10;
  const CACHE_KEY = 'LONG_BLOG_MEMOS_CACHE_V3';
  const CACHE_TTL = 30 * 1000;

  // 新版（v1.0.0）用 /api/v1/memo 偏移分页，旧版用 /api/v1/memos 游标分页
  // null = 尚未探测，true = 新接口，false = 旧接口
  let modernApi = null;
  let apiBase = memosApiBase;

  function formatDate(input) {
    const d = new Date(input);
    return d.toLocaleString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  function processContent(content) {
    return content
      .split('\n')
      .map((line) => line.replace(/^(\s*#\S+\s*)+/, '').trimStart())
      .join('\n')
      .trim();
  }

  function escapeHTML(str) {
    return (str || '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function extractMarkdownImages(content) {
    const images = [];
    const regex = /!\[[^\]]*\]\(([^)]+)\)/g;
    let match;
    while ((match = regex.exec(content)) !== null) {
      images.push(match[1]);
    }
    return images;
  }

  function mapAttachments(memo) {
    const images = [];
    const files = [];
    // 新版字段是 resourceList，旧版是 attachments
    const attachments = Array.isArray(memo.resourceList)
      ? memo.resourceList
      : (Array.isArray(memo.attachments) ? memo.attachments : []);

    for (const att of attachments) {
      const filename = att.filename || '';
      if (!filename) continue;

      let fileUrl = att.externalLink || '';
      if (!fileUrl) {
        const rawId = String(att.id || att.name || '').replace(/^(attachments|resource)\//, '');
        if (!rawId) continue;
        fileUrl = modernApi
          ? `${apiBase}/api/v1/resource/${encodeURIComponent(rawId)}/file`
          : `${apiBase}/file/attachments/${rawId}/${encodeURIComponent(filename)}`;
      }

      if ((att.type || '').startsWith('image/')) {
        images.push(fileUrl);
      } else {
        files.push({
          name: filename,
          url: fileUrl,
          type: att.type || 'file',
        });
      }
    }

    for (const mdImg of extractMarkdownImages(memo.content || '')) {
      if (!images.includes(mdImg)) images.push(mdImg);
    }

    return { images, files };
  }

  function normalizeTags(memo) {
    const raw = Array.isArray(memo.tagList)
      ? memo.tagList.map((t) => (t && typeof t === 'object' ? t.name : t))
      : (Array.isArray(memo.tags) ? memo.tags : []);
    return raw
      .map((t) => String(t || '').replace(/^#/, '').trim())
      .filter(Boolean);
  }

  // 把新旧两种接口返回统一成内部结构
  function normalizeMemo(raw) {
    const id = String(raw.id ?? raw.name ?? '');
    const createdTs = typeof raw.createdTs === 'number'
      ? raw.createdTs
      : Math.floor(new Date(raw.createTime || 0).getTime() / 1000);
    const updatedTs = typeof raw.updatedTs === 'number'
      ? raw.updatedTs
      : Math.floor(new Date(raw.updateTime || raw.createTime || 0).getTime() / 1000);
    const displayTs = typeof raw.displayTs === 'number' ? raw.displayTs : createdTs;

    return {
      id,
      content: raw.content || '',
      // 新旧字段名不同，统一到 pinned / visibility / state
      pinned: Boolean(raw.pinned),
      visibility: String(raw.visibility || 'PUBLIC'),
      state: String(raw.rowStatus || raw.state || 'NORMAL'),
      createdTs,
      updatedTs,
      displayTs,
      tagList: normalizeTags(raw),
      resourceList: raw.resourceList,
      attachments: raw.attachments,
      name: raw.name,
    };
  }

  function renderMemo(memo) {
    const content = processContent(memo.content || '');
    const { images, files } = mapAttachments(memo);
    const tags = normalizeTags(memo);
    const article = document.createElement('article');
    article.className = 'memo-item';

    const imageGridHTML = images.length
      ? `<div class="memo-images memo-images-${Math.min(images.length, 9)}" style="--thumb-size:4.8rem;max-width:15.2rem;">${images
          .map((img) => `<button class="memo-img-btn" data-img="${escapeHTML(img)}" style="width:4.8rem;height:4.8rem;max-width:4.8rem;max-height:4.8rem;" aria-label="查看大图"><img src="${escapeHTML(img)}" loading="lazy" alt="图片缩略图" style="width:100%;height:100%;object-fit:cover;" /></button>`)
          .join('')}</div>`
      : '';

    const filesHTML = files.length
      ? `<div class="memo-files">${files
          .map((file) => `<a href="${escapeHTML(file.url)}" target="_blank" rel="noopener noreferrer" class="memo-file"><span class="memo-file-name">📎 ${escapeHTML(file.name)}</span><span class="memo-file-type">${escapeHTML(file.type)}</span></a>`)
          .join('')}</div>`
      : '';

    const tagsHTML = tags.length
      ? `<div class="memo-tags">${tags
          .map((tag) => `<span>#${escapeHTML(String(tag))}</span>`)
          .join('')}</div>`
      : '';

    article.innerHTML = `
      <div class="timeline-line"></div>
      <div class="timeline-dot"></div>
      <div class="memo-body">
        <div class="memo-meta">
          <time>${escapeHTML(formatDate(memo.displayTs * 1000))}</time>
          ${memo.pinned ? '<span class="memo-pinned">置顶</span>' : ''}
        </div>
        <div class="memo-content">${escapeHTML(content).replaceAll('\n', '<br>')}</div>
        ${imageGridHTML}
        ${filesHTML}
        ${tagsHTML}
      </div>
    `;

    return article;
  }

  function renderAllMemos() {
    const items = [...memoStore.values()].sort((a, b) => {
      if (a.pinned && !b.pinned) return -1;
      if (!a.pinned && b.pinned) return 1;
      return (b.displayTs || b.createdTs) - (a.displayTs || a.createdTs);
    });

    listEl.innerHTML = '';
    for (const memo of items) {
      const node = renderMemo(memo);
      if (node) listEl.appendChild(node);
    }

    emptyEl.style.display = items.length ? 'none' : 'block';
    endEl.style.display = !hasMore && items.length ? 'block' : 'none';
  }

  function mergeMemos(memos) {
    for (const memo of memos) {
      const memoKey = String(memo.id || `${memo.displayTs}-${memo.content?.slice(0, 16) || ''}`);
      seen.add(memoKey);
      memoStore.set(memoKey, memo);
    }
    renderAllMemos();
  }

  function getCachedFirstPage() {
    try {
      const raw = sessionStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (!parsed?.ts || Date.now() - parsed.ts > CACHE_TTL) return null;
      return parsed.data || null;
    } catch {
      return null;
    }
  }

  function setCachedFirstPage(data) {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data }));
    } catch {}
  }

  async function requestJson(url) {
    const resp = await fetch(url, { cache: 'no-store' });
    if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
    // 旧路径在新版实例上会被前端路由接管并返回 HTML，这里显式拦掉
    const contentType = resp.headers.get('content-type') || '';
    if (!contentType.includes('json')) throw new Error(`Unexpected content-type: ${contentType}`);
    return await resp.json();
  }

  // 探测实例版本：新版 /api/v1/memo 返回 JSON 数组，旧版 /api/v1/memos 返回 { memos: [...] }
  async function detectApi() {
    if (modernApi !== null) return modernApi;

    const bases = [apiBase, 'https://memos.ssaw.top'].filter((v, i, arr) => v && arr.indexOf(v) === i);

    for (const base of bases) {
      try {
        const data = await requestJson(`${base}/api/v1/memo?limit=1`);
        if (Array.isArray(data)) {
          modernApi = true;
          apiBase = base;
          return true;
        }
      } catch {}
      try {
        const data = await requestJson(`${base}/api/v1/memos?pageSize=1`);
        if (data && Array.isArray(data.memos)) {
          modernApi = false;
          apiBase = base;
          return false;
        }
      } catch {}
    }

    modernApi = false;
    return false;
  }

  // 新版：offset/limit 分页，直接返回数组；旧版：pageToken 游标分页
  async function fetchPage(pageSize = PAGE_SIZE) {
    await detectApi();

    if (modernApi) {
      const qs = new URLSearchParams({ limit: String(pageSize), offset: String(offset) });
      const data = await requestJson(`${apiBase}/api/v1/memo?${qs.toString()}`);
      return { memos: Array.isArray(data) ? data : [], nextToken: '' };
    }

    const qs = new URLSearchParams({ pageSize: String(pageSize) });
    if (cursor) qs.set('pageToken', cursor);
    const data = await requestJson(`${apiBase}/api/v1/memos?${qs.toString()}`);
    return { memos: Array.isArray(data?.memos) ? data.memos : [], nextToken: data?.nextPageToken || '' };
  }

  async function loadMore() {
    if (!hasMore || loading) return;
    loading = true;
    loadingEl.style.display = 'block';
    errorEl.style.display = 'none';

    try {
      const data = await fetchPage(PAGE_SIZE);
      const batch = data.memos.map(normalizeMemo);
      // 隐藏：只展示公开且未被归档的说说，PRIVATE / ARCHIVED 一律不渲染
      const visible = batch.filter((m) => m.visibility === 'PUBLIC' && m.state === 'NORMAL');
      const beforeCount = seen.size;
      mergeMemos(visible);
      const addedCount = seen.size - beforeCount;

      if (modernApi) {
        offset += PAGE_SIZE;
        // 返回数量不足一页说明已到底
        hasMore = batch.length >= PAGE_SIZE;
      } else {
        cursor = data.nextToken;
        hasMore = Boolean(cursor);
      }

      if (hasMore && addedCount === 0) {
        // 防止整页都是不可见内容时无限循环
        hasMore = false;
      }

      if (offset === PAGE_SIZE || cursor) {
        setCachedFirstPage({ memos: [...memoStore.values()], hasMore, offset, cursor });
      }

      if (!hasMore) {
        loadingEl.style.display = 'none';
        endEl.style.display = listEl.children.length ? 'block' : 'none';
      }
      if (!listEl.children.length) emptyEl.style.display = 'block';
    } catch (err) {
      loadingEl.style.display = 'none';
      errorEl.textContent = '加载失败，请稍后刷新重试';
      errorEl.style.display = 'block';
      console.error('[memos] load error:', err);
      return;
    } finally {
      loading = false;
      if (hasMore) loadingEl.style.display = 'none';
    }
  }

  async function boot() {
    const cached = getCachedFirstPage();
    if (cached?.memos?.length) {
      mergeMemos(cached.memos);
      offset = cached.offset || 0;
      cursor = cached.cursor || '';
      hasMore = cached.hasMore !== false;
      loadingEl.style.display = 'none';

      // 用最新第一页覆盖缓存，确保新说说刷新后能看到
      try {
        memoStore.clear();
        seen.clear();
        offset = 0;
        cursor = '';
        hasMore = true;
        const data = await fetchPage(PAGE_SIZE);
        const visible = data.memos
          .map(normalizeMemo)
          .filter((m) => m.visibility === 'PUBLIC' && m.state === 'NORMAL');
        mergeMemos(visible);
        if (modernApi) {
          offset = PAGE_SIZE;
          hasMore = data.memos.length >= PAGE_SIZE;
        } else {
          cursor = data.nextToken;
          hasMore = Boolean(cursor);
        }
        setCachedFirstPage({ memos: [...memoStore.values()], hasMore, offset, cursor });
      } catch {}
    } else {
      await loadMore();
    }
  }

  const io = new IntersectionObserver(
    (entries) => {
      const entry = entries[0];
      if (entry && entry.isIntersecting) loadMore();
    },
    { rootMargin: '360px 0px' },
  );

  io.observe(sentinelEl);

  window.addEventListener('scroll', () => {
    if (!hasMore || loading) return;
    const remain = document.documentElement.scrollHeight - (window.scrollY + window.innerHeight);
    if (remain < 420) loadMore();
  }, { passive: true });

  listEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.memo-img-btn');
    if (!btn) return;
    const src = btn.getAttribute('data-img');
    if (!src) return;
    previewImgEl.setAttribute('src', src);
    previewEl.style.display = 'flex';
    document.body.classList.add('lightbox-open');
    document.body.style.overflow = 'hidden';
  });

  closeBtn.addEventListener('click', () => {
    previewEl.style.display = 'none';
    previewImgEl.setAttribute('src', '');
    document.body.classList.remove('lightbox-open');
    document.body.style.overflow = '';
  });

  previewEl.addEventListener('click', (e) => {
    if (e.target === previewEl) {
      previewEl.style.display = 'none';
      previewImgEl.setAttribute('src', '');
      document.body.classList.remove('lightbox-open');
      document.body.style.overflow = '';
    }
  });

  document.addEventListener('astro:before-swap', () => {
    io.disconnect();
    document.documentElement.classList.remove('memos-page');
    document.body.classList.remove('memos-page', 'lightbox-open');
    document.body.style.overflow = '';
  }, { once: true });

  window.addEventListener('beforeunload', () => {
    document.documentElement.classList.remove('memos-page');
    document.body.classList.remove('memos-page');
  });

  boot();
</script>

<style is:global>
  html.memos-page,
  body.memos-page {
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
  }

  html.memos-page::-webkit-scrollbar,
  body.memos-page::-webkit-scrollbar {
    width: 0 !important;
    height: 0 !important;
    display: none !important;
    background: transparent !important;
  }

  html.memos-page *::-webkit-scrollbar,
  body.memos-page *::-webkit-scrollbar {
    width: 0 !important;
    height: 0 !important;
    display: none !important;
    background: transparent !important;
  }

  .memos-wrap { padding-bottom: 4.5rem; }
  .memos-list { display: flex; flex-direction: column; gap: 2.55rem; }
  .memo-item { position: relative; padding-left: 2.04rem; }
  .timeline-line { position: absolute; left: 0.36rem; top: 0; bottom: -2.55rem; width: 1px; background: color-mix(in oklab, var(--border) 92%, transparent); }
  .timeline-dot { position: absolute; left: 0.15rem; top: 0.49rem; width: 0.43rem; height: 0.43rem; border-radius: 999px; background: color-mix(in oklab, var(--foreground) 28%, transparent); }
  .memo-meta { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.02em; color: color-mix(in oklab, var(--muted-foreground) 78%, transparent); margin-bottom: 0.62rem; line-height: 1.2; }
  .memo-pinned { color: var(--foreground); font-weight: 500; font-size: 0.64rem; border: 1px solid color-mix(in oklab, var(--border) 92%, transparent); border-radius: 999px; padding: 0.04rem 0.34rem; }
  .memo-content { font-family: var(--font-serif); font-size: 1.02rem; font-weight: 400; font-optical-sizing: auto; font-synthesis: none; line-height: 1.88; color: color-mix(in oklab, var(--foreground) 95%, transparent); white-space: pre-wrap; overflow-wrap: anywhere; word-break: normal; max-width: 42rem; letter-spacing: 0.006em; }
  .memo-body { padding-right: 0.25rem; }
  .memo-item::after { content: ''; position: absolute; left: 2.04rem; right: 0; bottom: -1.24rem; height: 1px; background: color-mix(in oklab, var(--border) 66%, transparent); opacity: 0.4; }
  .memo-item:last-child::after { display: none; }
  .memo-images { --thumb-size: 5.25rem; margin-top: 0.72rem; display: grid; grid-template-columns: repeat(3, var(--thumb-size)); grid-auto-rows: var(--thumb-size); gap: 0.38rem; justify-content: flex-start; width: fit-content; }
  .memo-images-1 { grid-template-columns: var(--thumb-size); }
  .memo-images-2 { grid-template-columns: repeat(2, var(--thumb-size)); }
  @media (min-width: 768px) { .memo-images { --thumb-size: 5.6rem; gap: 0.4rem; } }
  .memo-img-btn { display: block; width: 100%; height: 100%; border: 1px solid color-mix(in oklab, var(--border) 88%, transparent); padding: 0; overflow: hidden; border-radius: 0.48rem; cursor: zoom-in; background: color-mix(in oklab, var(--muted) 96%, transparent); }
  .memo-img-btn img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--transition-base), opacity var(--transition-base); }
  .memo-img-btn:hover img { transform: scale(1.04); opacity: 0.97; }
  .memo-content img { max-width: min(11rem, 40vw); max-height: 8rem; width: auto; height: auto; border-radius: 0.45rem; display: block; margin-top: 0.5rem; }
  .memo-files { margin-top: 0.68rem; display: flex; flex-direction: column; gap: 0.34rem; max-width: 26rem; }
  .memo-file { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; border: 1px solid color-mix(in oklab, var(--border) 84%, transparent); border-radius: 0.44rem; padding: 0.34rem 0.52rem; background: color-mix(in oklab, var(--muted) 94%, white); transition: border-color var(--transition-base), background-color var(--transition-base); }
  .memo-file:hover { border-color: color-mix(in oklab, var(--muted-foreground) 28%, var(--border)); background: color-mix(in oklab, var(--muted) 88%, white); }
  .memo-file-name { font-size: 0.78rem; color: color-mix(in oklab, var(--foreground) 88%, transparent); line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .memo-file-type { flex-shrink: 0; font-family: var(--font-mono); font-size: 0.64rem; color: color-mix(in oklab, var(--muted-foreground) 74%, transparent); text-transform: uppercase; letter-spacing: 0.04em; }
  .memo-tags { margin-top: 0.7rem; display: flex; flex-wrap: wrap; gap: 0.42rem; }
  .memo-tags span { font-size: 0.71rem; color: color-mix(in oklab, var(--muted-foreground) 86%, transparent); background: color-mix(in oklab, var(--muted) 92%, white); border-radius: 999px; padding: 0.11rem 0.48rem; }
  .memos-status { text-align: center; margin-top: 2.2rem; font-family: var(--font-mono); font-size: 0.72rem; color: color-mix(in oklab, var(--muted-foreground) 82%, transparent); letter-spacing: 0.08em; }
  .memos-sentinel { height: 1px; }
  .image-preview { position: fixed; inset: 0; z-index: 999; background: rgba(0, 0, 0, 0.84); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); display: flex; align-items: center; justify-content: center; padding: 1rem; width: 100vw; height: 100dvh; min-height: 100vh; }
  body.lightbox-open .site-header,
  body.lightbox-open .site-header-spacer {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateY(-12px);
  }
  .image-preview img { max-width: min(90vw, 960px); max-height: 88dvh; object-fit: contain; border-radius: 0.52rem; }
  .preview-close { position: absolute; right: 1rem; top: 1rem; border: none; background: transparent; color: white; font-size: 1.4rem; cursor: pointer; z-index: 1000; }
</style>
