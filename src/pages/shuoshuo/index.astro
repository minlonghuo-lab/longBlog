---
/**
 * 说说页面
 * 从 Memos API 获取数据
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MemosItem from '../../components/MemosItem.astro';
import { memosConfig } from '../../memos/config';
import { getMemos } from '../../memos/api';

// 获取说说数据
const memos = await getMemos();
---

<BaseLayout title={memosConfig.pageTitle} description={memosConfig.pageDescription}>
  <Header />
  
  <main class="w-full max-w-3xl mx-auto px-6 md:px-0 py-12 md:py-20">
    <!-- 页面标题 -->
    <header class="mb-12">
      <h1 class="text-4xl md:text-5xl font-serif font-medium tracking-tight">
        {memosConfig.pageTitle}
      </h1>
      <p class="text-muted-foreground mt-2">
        {memosConfig.pageDescription}
      </p>
    </header>
    
    {memos.length === 0 ? (
      <!-- 空状态 -->
      <div class="text-center py-20">
        <p class="text-muted-foreground">暂无说说内容</p>
      </div>
    ) : (
      <!-- 说说列表 -->
      <div class="space-y-12">
        {memos.map((memo) => (
          <MemosItem memo={memo} />
        ))}
      </div>
    )}
  </main>
  
  <Footer />
</BaseLayout>
