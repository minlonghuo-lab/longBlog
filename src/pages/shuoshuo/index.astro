---
import BaseLayout from '../../layouts/BaseLayout.astro';

const memosApiBase = 'https://memos.ssaw.top';
---

<BaseLayout title="说说" description="日常碎碎念">
  <header class="page-header">
    <h1>说说</h1>
    <p>日常碎碎念</p>
  </header>

  <section class="memos-wrap">
    <div id="memos-list" class="memos-list"></div>

    <div id="memos-loading" class="memos-status">加载中...</div>
    <div id="memos-end" class="memos-status" style="display:none;">- END -</div>
    <div id="memos-empty" class="memos-status" style="display:none;">暂无内容</div>

    <div id="memos-sentinel" class="memos-sentinel"></div>
  </section>

  <div id="image-preview" class="image-preview" style="display:none;">
    <button id="preview-close" class="preview-close" aria-label="关闭">✕</button>
    <img id="preview-image" src="" alt="预览图" />
  </div>
</BaseLayout>

<script define:vars={{ memosApiBase }}>
  const listEl = document.getElementById('memos-list');
  const loadingEl = document.getElementById('memos-loading');
  const endEl = document.getElementById('memos-end');
  const emptyEl = document.getElementById('memos-empty');
  const sentinelEl = document.getElementById('memos-sentinel');
  const previewEl = document.getElementById('image-preview');
  const previewImgEl = document.getElementById('preview-image');
  const closeBtn = document.getElementById('preview-close');

  let pageToken = '';
  let hasMore = true;
  let loading = false;
  let currentApiBase = memosApiBase;
  const apiBaseCandidates = Array.from(new Set([
    window.location.origin,
    memosApiBase,
    'https://ssaw.top',
  ]));
  const seen = new Set();

  const PAGE_SIZE = 10;
  let io = null;

  function formatDate(input) {
    const d = new Date(input);
    return d.toLocaleString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  function processContent(content) {
    return content
      .split('\n')
      .map((line) => line.replace(/^#\S+(\s|$)/, ''))
      .join('\n')
      .trim();
  }

  function escapeHTML(str) {
    return (str || '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function extractMarkdownImages(content) {
    const images = [];
    const regex = /!\[[^\]]*\]\(([^)]+)\)/g;
    let match;
    while ((match = regex.exec(content)) !== null) {
      images.push(match[1]);
    }
    return images;
  }

  function mapImages(memo) {
    const images = [];
    const attachments = Array.isArray(memo.attachments) ? memo.attachments : [];

    for (const att of attachments) {
      const attachmentId = (att.name || '').replace('attachments/', '');
      const filename = att.filename || '';
      if (!attachmentId || !filename) continue;
      const fileUrl = `${memosApiBase}/file/attachments/${attachmentId}/${encodeURIComponent(filename)}`;
      if ((att.type || '').startsWith('image/')) {
        images.push(fileUrl);
      }
    }

    for (const mdImg of extractMarkdownImages(memo.content || '')) {
      if (!images.includes(mdImg)) images.push(mdImg);
    }

    return images;
  }

  function renderMemo(memo) {
    const memoKey = String(memo.name || `${memo.createTime}-${memo.updateTime}-${memo.content?.slice(0, 16) || ''}`);
    if (seen.has(memoKey)) return;
    seen.add(memoKey);

    const content = processContent(memo.content || '');
    const images = mapImages(memo);
    const tags = (memo.tags || []).filter((t) => !String(t).startsWith('#'));

    const article = document.createElement('article');
    article.className = 'memo-item';

    const contentLen = content.length;
    const lineExtra = Math.max(32, Math.min(92, Math.round(contentLen / 5)));
    const dotTop = contentLen > 220 ? '0.58rem' : contentLen > 100 ? '0.52rem' : '0.48rem';
    article.style.setProperty('--line-extra', `${lineExtra}px`);
    article.style.setProperty('--dot-top', dotTop);
    article.classList.add(contentLen > 180 ? 'memo-long' : contentLen < 45 ? 'memo-short' : 'memo-mid');

    const prevLast = listEl.lastElementChild;
    if (prevLast) prevLast.classList.remove('memo-last');
    article.classList.add('memo-last');

    const imageGridHTML = images.length
      ? `<div class="memo-images">${images
          .map((img) => `<button class="memo-img-btn" data-img="${escapeHTML(img)}"><img src="${escapeHTML(img)}" loading="lazy" alt="图片" /></button>`)
          .join('')}</div>`
      : '';

    const tagsHTML = tags.length
      ? `<div class="memo-tags">${tags
          .map((tag) => `<span>#${escapeHTML(String(tag))}</span>`)
          .join('')}</div>`
      : '';

    article.innerHTML = `
      <div class="timeline-line"></div>
      <div class="timeline-dot"></div>
      <div class="memo-body">
        <div class="memo-meta">
          <time>${escapeHTML(formatDate(memo.createTime))}</time>
          ${memo.pinned ? '<span class="memo-pinned">置顶</span>' : ''}
        </div>
        <div class="memo-content">${escapeHTML(content).replaceAll('\n', '<br>')}</div>
        ${imageGridHTML}
        ${tagsHTML}
      </div>
    `;

    listEl.appendChild(article);
  }

  async function fetchMemosWithFallback(qs) {
    let lastError = null;

    for (const base of apiBaseCandidates) {
      try {
        const resp = await fetch(`${base}/api/v1/memos?${qs.toString()}`, { credentials: 'omit' });
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const data = await resp.json();
        if (!Array.isArray(data?.memos)) throw new Error('Invalid memos payload');
        currentApiBase = base;
        return data;
      } catch (err) {
        lastError = err;
      }
    }

    throw lastError || new Error('No available memos API');
  }

  async function loadMore() {
    if (!hasMore || loading) return;

    loading = true;
    loadingEl.style.display = 'block';

    try {
      const qs = new URLSearchParams({ pageSize: String(PAGE_SIZE) });
      if (pageToken) qs.set('pageToken', pageToken);

      const data = await fetchMemosWithFallback(qs);
      const memos = Array.isArray(data.memos) ? data.memos : [];
      const publicMemos = memos.filter((m) => m.visibility === 'PUBLIC');

      publicMemos.sort((a, b) => {
        if (a.pinned && !b.pinned) return -1;
        if (!a.pinned && b.pinned) return 1;
        return new Date(b.createTime).getTime() - new Date(a.createTime).getTime();
      });

      publicMemos.forEach(renderMemo);

      pageToken = data.nextPageToken || '';
      hasMore = !!pageToken;

      if (!hasMore) {
        loadingEl.style.display = 'none';
        endEl.style.display = listEl.children.length ? 'block' : 'none';
        if (io && sentinelEl) io.unobserve(sentinelEl);
      } else {
        endEl.style.display = 'none';
      }

      if (!listEl.children.length) {
        emptyEl.style.display = 'block';
      }
    } catch (err) {
      loadingEl.textContent = '加载失败，请稍后刷新重试';
      console.error('[memos] load error:', err);
      return;
    } finally {
      loading = false;
      if (hasMore) loadingEl.style.display = 'none';
    }
  }

  io = new IntersectionObserver(
    (entries) => {
      const entry = entries[0];
      if (entry && entry.isIntersecting) loadMore();
    },
    { rootMargin: '220px 0px' },
  );

  io.observe(sentinelEl);

  listEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.memo-img-btn');
    if (!btn) return;
    const src = btn.getAttribute('data-img');
    if (!src) return;
    previewImgEl.setAttribute('src', src);
    previewEl.style.display = 'flex';
  });

  closeBtn.addEventListener('click', () => {
    previewEl.style.display = 'none';
    previewImgEl.setAttribute('src', '');
  });

  previewEl.addEventListener('click', (e) => {
    if (e.target === previewEl) {
      previewEl.style.display = 'none';
      previewImgEl.setAttribute('src', '');
    }
  });

  loadMore();
</script>

<style>
  .memos-wrap {
    padding-bottom: 5rem;
  }

  .memos-list {
    display: flex;
    flex-direction: column;
    gap: 2.1rem;
    margin-top: 0.2rem;
  }

  .memo-item {
    position: relative;
    padding-left: 1.85rem;
    --line-extra: 56px;
    --dot-top: 0.52rem;
  }

  .timeline-line {
    position: absolute;
    left: 0.32rem;
    top: 0;
    bottom: calc(var(--line-extra) * -1);
    width: 1px;
    background: color-mix(in oklab, var(--muted-foreground) 28%, transparent);
  }

  .memo-item.memo-last .timeline-line {
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--muted-foreground) 28%, transparent) 0%,
      color-mix(in oklab, var(--muted-foreground) 10%, transparent) 68%,
      transparent 100%
    );
  }

  .timeline-dot {
    position: absolute;
    left: 0.13rem;
    top: var(--dot-top);
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--foreground) 44%, transparent);
  }

  .memo-meta {
    display: flex;
    align-items: center;
    gap: 0.58rem;
    font-family: var(--font-mono);
    font-size: 0.685rem;
    font-weight: 500;
    letter-spacing: 0.015em;
    color: color-mix(in oklab, var(--muted-foreground) 86%, transparent);
    margin-bottom: 0.52rem;
    line-height: 1.2;
  }

  .memo-pinned {
    color: color-mix(in oklab, var(--foreground) 78%, transparent);
    font-weight: 500;
    font-size: 0.66rem;
    border: 1px solid color-mix(in oklab, var(--border) 86%, transparent);
    border-radius: 999px;
    padding: 0.06rem 0.35rem;
  }

  .memo-content {
    font-size: 0.93rem;
    line-height: 1.76;
    color: var(--foreground);
    white-space: pre-wrap;
    word-break: break-word;
    max-width: 40rem;
  }

  .memo-images {
    margin-top: 0.78rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
    max-width: 15.2rem;
  }

  @media (min-width: 768px) {
    .memo-images {
      max-width: 17.1rem;
    }
  }

  .memo-img-btn {
    display: block;
    width: 100%;
    aspect-ratio: 1/1;
    border: none;
    padding: 0;
    overflow: hidden;
    border-radius: 0.48rem;
    cursor: zoom-in;
    background: color-mix(in oklab, var(--muted) 94%, transparent);
  }

  .memo-img-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base), opacity var(--transition-base);
  }

  .memo-img-btn:hover img {
    transform: scale(1.04);
    opacity: 0.96;
  }

  .memo-tags {
    margin-top: 0.7rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .memo-tags span {
    font-size: 0.72rem;
    color: color-mix(in oklab, var(--muted-foreground) 95%, transparent);
    background: color-mix(in oklab, var(--muted) 88%, white);
    border-radius: 999px;
    padding: 0.12rem 0.5rem;
  }

  .memos-status {
    text-align: center;
    margin-top: 2.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
    opacity: 0.7;
  }

  .memos-sentinel {
    height: 1px;
  }

  .image-preview {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.86);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: fadeIn 0.16s ease;
  }

  .image-preview img {
    max-width: min(90vw, 960px);
    max-height: 88vh;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.45);
  }

  .preview-close {
    position: absolute;
    right: 1rem;
    top: 1rem;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.86);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    transition: color var(--transition-base);
  }

  .preview-close:hover {
    color: #fff;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
