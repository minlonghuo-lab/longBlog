---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShuoshuoItem from '../../components/ShuoshuoItem.astro';
import { getSortedShuoshuo } from '../../data/shuoshuo';

const shuoshuoList = getSortedShuoshuo();
---

<BaseLayout title="说说" description="碎碎念">
  <div class="shuoshuo-page">
    <!-- 页面标题 -->
    <header class="page-header">
      <h1 class="page-title">说说</h1>
      <p class="page-desc">碎碎念，记录生活点滴</p>
    </header>

    <!-- 说说列表 -->
    <div class="shuoshuo-list">
      {shuoshuoList.length === 0 ? (
        <div class="empty-state">
          <p>暂无说说</p>
        </div>
      ) : (
        shuoshuoList.map(item => (
          <ShuoshuoItem 
            content={item.content}
            createdAt={item.createdAt}
            images={item.images}
          />
        ))
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .shuoshuo-page {
    width: 100%;
    max-width: 48rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  /* 页面标题 */
  .page-header {
    padding: 3rem 0;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 500;
    color: var(--foreground);
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  .page-desc {
    max-width: 28rem;
    font-size: 1rem;
    font-weight: 300;
    color: var(--muted-foreground);
    margin: 0;
    line-height: 1.6;
  }

  /* 说说列表 */
  .shuoshuo-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .empty-state {
    padding: 4rem 0;
    text-align: center;
  }

  .empty-state p {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--muted-foreground);
    opacity: 0.5;
  }

  @media (max-width: 640px) {
    .shuoshuo-page {
      padding: 2rem 1rem 4rem;
    }

    .page-title {
      font-size: 2rem;
    }
  }
</style>
