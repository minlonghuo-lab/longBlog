---
import BaseLayout from '../../layouts/BaseLayout.astro';

const memosApiBase = 'https://memos.ssaw.top';
---

<BaseLayout title="说说" description="日常碎碎念">
  <header class="page-header">
    <h1>说说</h1>
    <p>日常碎碎念</p>
  </header>

  <section class="memos-wrap">
    <div id="memos-list" class="memos-list"></div>

    <div id="memos-loading" class="memos-status">加载中...</div>
    <div id="memos-end" class="memos-status" style="display:none;">- END -</div>
    <div id="memos-empty" class="memos-status" style="display:none;">暂无内容</div>

    <div id="memos-sentinel" class="memos-sentinel"></div>
  </section>

  <div id="image-preview" class="image-preview" style="display:none;">
    <button id="preview-close" class="preview-close" aria-label="关闭">✕</button>
    <img id="preview-image" src="" alt="预览图" />
  </div>
</BaseLayout>

<script define:vars={{ memosApiBase }}>
  const listEl = document.getElementById('memos-list');
  const loadingEl = document.getElementById('memos-loading');
  const endEl = document.getElementById('memos-end');
  const emptyEl = document.getElementById('memos-empty');
  const sentinelEl = document.getElementById('memos-sentinel');
  const previewEl = document.getElementById('image-preview');
  const previewImgEl = document.getElementById('preview-image');
  const closeBtn = document.getElementById('preview-close');

  let pageToken = '';
  let hasMore = true;
  let loading = false;
  const seen = new Set();

  const PAGE_SIZE = 10;
  const MAX_SAME_TOKEN_HITS = 2;
  let lastNextPageToken = '';
  let sameTokenHits = 0;
  let requestPageSize = PAGE_SIZE;

  function formatDate(input) {
    const d = new Date(input);
    return d.toLocaleString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  function processContent(content) {
    return content
      .split('\n')
      .map((line) => line.replace(/^#\S+(\s|$)/, ''))
      .join('\n')
      .trim();
  }

  function escapeHTML(str) {
    return (str || '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function extractMarkdownImages(content) {
    const images = [];
    const regex = /!\[[^\]]*\]\(([^)]+)\)/g;
    let match;
    while ((match = regex.exec(content)) !== null) {
      images.push(match[1]);
    }
    return images;
  }

  function mapImages(memo) {
    const images = [];
    const attachments = Array.isArray(memo.attachments) ? memo.attachments : [];

    for (const att of attachments) {
      const attachmentId = (att.name || '').replace('attachments/', '');
      const filename = att.filename || '';
      if (!attachmentId || !filename) continue;
      const fileUrl = `${memosApiBase}/file/attachments/${attachmentId}/${encodeURIComponent(filename)}`;
      if ((att.type || '').startsWith('image/')) {
        images.push(fileUrl);
      }
    }

    for (const mdImg of extractMarkdownImages(memo.content || '')) {
      if (!images.includes(mdImg)) images.push(mdImg);
    }

    return images;
  }

  function renderMemo(memo) {
    const memoKey = String(memo.name || `${memo.createTime}-${memo.updateTime}-${memo.content?.slice(0, 16) || ''}`);
    if (seen.has(memoKey)) return;
    seen.add(memoKey);

    const content = processContent(memo.content || '');
    const images = mapImages(memo);
    const tags = (memo.tags || []).filter((t) => !String(t).startsWith('#'));

    const article = document.createElement('article');
    article.className = 'memo-item';

    const imageGridHTML = images.length
      ? `<div class="memo-images memo-images-${Math.min(images.length, 9)}" style="--thumb-size:4.8rem;max-width:15.2rem;">${images
          .map((img) => `<button class="memo-img-btn" data-img="${escapeHTML(img)}" style="width:4.8rem;height:4.8rem;max-width:4.8rem;max-height:4.8rem;" aria-label="查看大图"><img src="${escapeHTML(img)}" loading="lazy" alt="图片缩略图" style="width:100%;height:100%;object-fit:cover;" /></button>`)
          .join('')}</div>`
      : '';

    const tagsHTML = tags.length
      ? `<div class="memo-tags">${tags
          .map((tag) => `<span>#${escapeHTML(String(tag))}</span>`)
          .join('')}</div>`
      : '';

    article.innerHTML = `
      <div class="timeline-line"></div>
      <div class="timeline-dot"></div>
      <div class="memo-body">
        <div class="memo-meta">
          <time>${escapeHTML(formatDate(memo.createTime))}</time>
          ${memo.pinned ? '<span class="memo-pinned">置顶</span>' : ''}
        </div>
        <div class="memo-content">${escapeHTML(content).replaceAll('\n', '<br>')}</div>
        ${imageGridHTML}
        ${tagsHTML}
      </div>
    `;

    listEl.appendChild(article);
  }

  async function loadMore() {
    if (!hasMore || loading) return;

    loading = true;
    loadingEl.style.display = 'block';

    try {
      let data = null;

      if (!pageToken && requestPageSize === PAGE_SIZE) {
        const cached = sessionStorage.getItem('LONG_BLOG_MEMOS_CACHE');
        if (cached) {
          try {
            const parsed = JSON.parse(cached);
            if (parsed?.data?.memos && Date.now() - parsed.ts < 30 * 1000) {
              data = parsed.data;
            }
          } catch (e) {}
          sessionStorage.removeItem('LONG_BLOG_MEMOS_CACHE');
        }
      }

      if (!data) {
        const qs = new URLSearchParams({ pageSize: String(requestPageSize) });
        if (pageToken) qs.set('pageToken', pageToken);

        const resp = await fetch(`${memosApiBase}/api/v1/memos?${qs.toString()}`);
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        data = await resp.json();
      }

      const memos = Array.isArray(data.memos) ? data.memos : [];
      const publicMemos = memos.filter((m) => m.visibility === 'PUBLIC');

      publicMemos.sort((a, b) => {
        if (a.pinned && !b.pinned) return -1;
        if (!a.pinned && b.pinned) return 1;
        return new Date(b.createTime).getTime() - new Date(a.createTime).getTime();
      });

      const beforeCount = seen.size;
      publicMemos.forEach(renderMemo);
      const addedCount = seen.size - beforeCount;

      const nextToken = data.nextPageToken || '';
      if (nextToken) {
        if (nextToken === lastNextPageToken) {
          sameTokenHits += 1;
        } else {
          sameTokenHits = 0;
        }
        lastNextPageToken = nextToken;
        pageToken = nextToken;
        hasMore = sameTokenHits < MAX_SAME_TOKEN_HITS;
      } else {
        pageToken = '';
        if (addedCount > 0 && memos.length >= requestPageSize) {
          requestPageSize += PAGE_SIZE;
          hasMore = true;
        } else {
          hasMore = false;
        }
      }

      if (!hasMore) {
        loadingEl.style.display = 'none';
        endEl.style.display = listEl.children.length ? 'block' : 'none';
      }

      if (!listEl.children.length) {
        emptyEl.style.display = 'block';
      }
    } catch (err) {
      loadingEl.textContent = '加载失败，请稍后刷新重试';
      console.error('[memos] load error:', err);
      return;
    } finally {
      loading = false;
      if (hasMore) loadingEl.style.display = 'none';
    }
  }

  const io = new IntersectionObserver(
    (entries) => {
      const entry = entries[0];
      if (entry && entry.isIntersecting) loadMore();
    },
    { rootMargin: '360px 0px' },
  );

  io.observe(sentinelEl);

  window.addEventListener('scroll', () => {
    if (!hasMore || loading) return;
    const remain = document.documentElement.scrollHeight - (window.scrollY + window.innerHeight);
    if (remain < 420) loadMore();
  }, { passive: true });

  listEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.memo-img-btn');
    if (!btn) return;
    const src = btn.getAttribute('data-img');
    if (!src) return;
    previewImgEl.setAttribute('src', src);
    previewEl.style.display = 'flex';
  });

  closeBtn.addEventListener('click', () => {
    previewEl.style.display = 'none';
    previewImgEl.setAttribute('src', '');
  });

  previewEl.addEventListener('click', (e) => {
    if (e.target === previewEl) {
      previewEl.style.display = 'none';
      previewImgEl.setAttribute('src', '');
    }
  });

  loadMore();
</script>

<style>
  .memos-wrap {
    padding-bottom: 4rem;
  }

  .memos-list {
    display: flex;
    flex-direction: column;
    gap: 2.1rem;
  }

  .memo-item {
    position: relative;
    padding-left: 1.95rem;
    padding-bottom: 0.25rem;
  }

  .timeline-line {
    position: absolute;
    left: 0.34rem;
    top: 0;
    bottom: -2.1rem;
    width: 1px;
    background: color-mix(in oklab, var(--border) 86%, transparent);
  }

  .timeline-dot {
    position: absolute;
    left: 0.145rem;
    top: 0.5rem;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--muted-foreground) 55%, transparent);
  }

  .memo-meta {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.015em;
    color: color-mix(in oklab, var(--muted-foreground) 72%, transparent);
    margin-bottom: 0.58rem;
  }

  .memo-pinned {
    color: color-mix(in oklab, var(--foreground) 72%, transparent);
    font-weight: 500;
    font-size: 0.64rem;
    border: 1px solid color-mix(in oklab, var(--border) 90%, transparent);
    border-radius: 999px;
    padding: 0.02rem 0.36rem;
  }

  .memo-content {
    font-size: 0.99rem;
    line-height: 1.86;
    color: color-mix(in oklab, var(--foreground) 96%, transparent);
    white-space: pre-wrap;
    word-break: break-word;
    max-width: 42rem;
  }

  .memo-body {
    padding-right: 0.28rem;
  }

  .memo-item::after {
    content: '';
    position: absolute;
    left: 1.95rem;
    right: 0;
    bottom: -1.08rem;
    height: 1px;
    background: color-mix(in oklab, var(--border) 62%, transparent);
    opacity: 0.55;
  }

  .memo-item:last-child::after {
    display: none;
  }

  .memo-images,
  .memo-images * {
    box-sizing: border-box;
  }

  .memo-images {
    --thumb-size: 4.8rem !important;
    margin-top: 0.62rem !important;
    display: grid !important;
    grid-template-columns: repeat(3, var(--thumb-size)) !important;
    grid-auto-rows: var(--thumb-size) !important;
    gap: 0.3rem !important;
    justify-content: flex-start !important;
    max-width: 15.2rem !important;
    width: fit-content !important;
  }

  .memo-images-1 {
    grid-template-columns: var(--thumb-size) !important;
    max-width: var(--thumb-size) !important;
  }

  .memo-images-2 {
    grid-template-columns: repeat(2, var(--thumb-size)) !important;
    max-width: calc(var(--thumb-size) * 2 + 0.3rem) !important;
  }

  .memo-images-3,
  .memo-images-4,
  .memo-images-5,
  .memo-images-6,
  .memo-images-7,
  .memo-images-8,
  .memo-images-9 {
    grid-template-columns: repeat(3, var(--thumb-size)) !important;
    max-width: 15.2rem !important;
  }

  .memo-img-btn {
    display: block !important;
    width: var(--thumb-size) !important;
    height: var(--thumb-size) !important;
    min-width: var(--thumb-size) !important;
    min-height: var(--thumb-size) !important;
    max-width: var(--thumb-size) !important;
    max-height: var(--thumb-size) !important;
    border: 1px solid color-mix(in oklab, var(--border) 86%, transparent) !important;
    padding: 0 !important;
    overflow: hidden !important;
    border-radius: 0.42rem !important;
    cursor: zoom-in !important;
    background: color-mix(in oklab, var(--muted) 96%, transparent) !important;
  }

  .memo-img-btn img {
    width: 100% !important;
    height: 100% !important;
    min-width: 100% !important;
    min-height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    transition: transform var(--transition-base), opacity var(--transition-base) !important;
  }

  .memo-img-btn:hover img {
    transform: scale(1.04) !important;
    opacity: 0.96 !important;
  }

  /* 兜底：如果未来内容里直接渲染 img，也强制缩小显示 */
  .memo-content :global(img),
  .memo-content img {
    max-width: min(10rem, 38vw) !important;
    max-height: 7.5rem !important;
    width: auto !important;
    height: auto !important;
    border-radius: 0.4rem !important;
    display: block !important;
    margin-top: 0.45rem !important;
  }

  .memo-tags {
    margin-top: 0.65rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .memo-tags span {
    font-size: 0.72rem;
    color: var(--muted-foreground);
    background: var(--muted);
    border-radius: 999px;
    padding: 0.12rem 0.5rem;
  }

  .memos-status {
    text-align: center;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .memos-sentinel {
    height: 1px;
  }

  .image-preview {
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    width: 100vw;
    height: 100dvh;
    min-height: 100vh;
  }

  .image-preview img {
    max-width: min(90vw, 960px);
    max-height: 88dvh;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .preview-close {
    position: absolute;
    right: 1rem;
    top: 1rem;
    border: none;
    background: transparent;
    color: white;
    font-size: 1.4rem;
    cursor: pointer;
    z-index: 1000;
  }
</style>
