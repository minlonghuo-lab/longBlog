---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShuoshuoItem from '../../components/ShuoshuoItem.astro';
import { getSortedShuoshuo } from '../../data/shuoshuo';

const shuoshuoList = getSortedShuoshuo();
---

<BaseLayout title="说说" description="碎碎念，记录生活点滴">
  <!-- 页面标题 -->
  <header class="page-header">
    <h1>说说</h1>
    <p>碎碎念，记录生活点滴</p>
  </header>

  <!-- 说说列表 -->
  <div class="shuoshuo-list">
    {shuoshuoList.length === 0 ? (
      <div class="empty-state">
        <p>暂无说说</p>
      </div>
    ) : (
      shuoshuoList.map(item => (
        <ShuoshuoItem 
          content={item.content}
          createdAt={item.createdAt}
          images={item.images}
        />
      ))
    )}
  </div>
</BaseLayout>

<style>
  .shuoshuo-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2rem;
  }

  .empty-state {
    padding: 5rem 0;
    text-align: center;
  }

  .empty-state p {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--muted-foreground);
    opacity: 0.5;
  }
</style>
