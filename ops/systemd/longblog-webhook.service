[Unit]
Description=longBlog Trilium Webhook Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/longblog-automation/service
ExecStart=/bin/sh -c '. /root/longblog-automation/runtime/env.sh && export LONGBLOG_RUNTIME_DIR=/root/longblog-automation/runtime && export LONGBLOG_REPO_DIR=/root/longblog-automation/workspace/current && exec python3 /root/longblog-automation/service/trilium_sync_webhook.py'
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
